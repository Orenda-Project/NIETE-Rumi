{
 "version": "v1.2",
 "source": "contracts/API.md v1 (c-api, 26 Oct 2026), from design/SPEC.md v2 section 3; supersedes outputs/lanes/red-1/tools/routes_spec_v1.json",
 "prefix": "/api/portal/coachip",
 "guards": [
  "requirePortalAuth",
  "coachipLeaderGate",
  "requireCoachip(kind)",
  "coachipScope"
 ],
 "bodies": {
  "400": {
   "error": "bad_request"
  },
  "401": {
   "success": false,
   "error": "Not authenticated. Please log in."
  },
  "404": {
   "error": "not_found"
  },
  "409_exists": {
   "error": "step_exists",
   "step_id": "<uuid>"
  },
  "409_closed": {
   "error": "step_closed"
  },
  "500": {
   "error": "server_error"
  },
  "503_clip": {
   "error": "clip_unavailable"
  },
  "503_audio": {
   "error": "audio_unavailable"
  },
  "503_codec": {
   "error": "unavailable"
  }
 },
 "headers_every_response": {
  "Cache-Control": "private, no-store"
 },
 "id_grammar": {
  "uuid": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
  "w_id": "^W-[A-Z0-9-]{1,40}$",
  "weekStart": "YYYY-MM-DD Monday, Asia/Karachi, within 8 weeks"
 },
 "notes": [
  "kind: coach = portal_coachip; rm = portal_coachip_rm (rmSectorFor); either = coach OR rm (R6, R7); none = R1 only, guarded by requirePortalAuth alone.",
  "ids: path or body ids. scoped_by: the id whose cross-scope replay (coach B's, another sector's, or an invented UUID) must 404 with the byte-identical bodies['404'].",
  "flag_off / teacher_session: expected status with every switch off / as a teacher session (R1 answers 200 with flag_off_body).",
  "rm_also: an RM may call it for a moment in the sector's current circle (coachip_circle_items). R8 is coach-only (API.md A4).",
  "allow_keys / forbid_keys: payload keys the generic identity rule would flag that this route legitimately carries / keys that must never appear.",
  "write: a positive call creates or changes a row (skip against a real host unless --allow-writes). Every POST body is strict: one extra key -> 400.",
  "media: audio stream; Range rules in API.md section 10 (stored object 200/206/416; live cut 200 with Accept-Ranges: none)."
 ],
