0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play ms-0.5" aria-hidden="true"><polygon points="6 3 20 12 6 21 6 3"></polygon></svg></span><span data-clock="" dir="ltr">۰:۳۶</span></button></div></li></ul></div></section><section data-testid="s10-sector-moves" data-section="" class="mt-5 border-t border-cp-hairline pt-6 "><div class="flex items-start justify-between gap-3"><div class="min-w-0"><p class="cp-label text-[12px] font-bold uppercase leading-snug tracking-[0.08em] text-cp-ink-3">سیکٹر کے قدم</p></div></div><div class="mt-2"><ul class="flex flex-col"><li data-testid="sector-move" data-i="I-IP-TIME-3" class="flex flex-col gap-1 border-t border-cp-hairline py-3.5 first:border-t-0"><p class="text-[17px] font-semibold leading-[1.4] text-cp-ink"><span data-text="library">ساتھی مشاہدہ، ایک نظر: وضاحت کس منٹ پر ختم ہوئی</span>، <span data-date="2026-10-29">جمعرات ۲۹ اکتوبر</span>، <span data-text="library">ایجنڈے والے اسکولوں کے پہلی تا تیسری جماعت کے اساتذہ</span></p><p class="text-[13px] leading-[1.45] text-cp-ink-3">جانچ: <span data-text="library">دونوں پرچیاں بھری ہوں اور مشق شروع ہونے کا منٹ ۱۷ سے کم ہو۔</span></p><div class="mt-1 flex flex-wrap items-center gap-2"><button type="button" data-testid="sector-move-set" class="cp-press inline-flex items-center justify-center gap-2 whitespace-nowrap outline-none focus-visible:ring-[3px] focus-visible:ring-cp-navy focus-visible:ring-offset-2 disabled:opacity-50 border-2 border-cp-navy bg-white text-cp-navy min-h-[44px] rounded-[12px] px-4 text-[14px] font-semibold  self-start"><span>سیکٹر کا یہ قدم آج طے کریں</span></button></div></li><li data-testid="sector-move" data-i="I-IP-4" class="flex flex-col gap-1 border-t border-cp-hairline py-3.5 first:border-t-0"><p class="text-[17px] font-semibold leading-[1.4] text-cp-ink"><span data-text="library">سیکٹر مہم: ہر کوچ دوسرے جمعے تک تین جماعتوں میں خود مشق کا مرحلہ کر کے دکھائے</span>، <span data-text="library">سیکٹر کے سب کوچ</span></p><p class="text-[13px] leading-[1.45] text-cp-ink-3">جانچ: <span data-text="library">دوسرے جمعے تک ہر کوچ کے تین کر کے دکھائے گئے اسباق</span></p><div class="mt-1 flex flex-wrap items-center gap-2"><button type="button" data-testid="sector-move-set" class="cp-press inline-flex items-center justify-center gap-2 whitespace-nowrap outline-none focus-visible:ring-[3px] focus-visible:ring-cp-navy focus-visible:ring-offset-2 disabled:opacity-50 border-2 border-cp-navy bg-white text-cp-navy min-h-[44px] rounded-[12px] px-4 text-[14px] font-semibold  self-start"><span>سیکٹر کا یہ قدم آج طے کریں</span></button></div></li></ul></div></section><section data-testid="s10-checks" data-section="" class="mt-5 border-t border-cp-hairline pt-6 "><div class="flex items-start justify-between gap-3"><div class="min-w-0"><p class="cp-label text-[12px] font-bold uppercase leading-snug tracking-[0.08em] text-cp-ink-3">اس ہفتے کی جانچیں</p><p class="mt-1 text-[13px] leading-[1.45] text-cp-ink-3"><span data-testid="window-legend" class=""><span><span data-window="act-4w-2026-10-26">۲۹ ستمبر تا ۲۶ اکتوبر</span></span></span></p></div></div><div class="mt-2"><p data-num="7" data-den="23" data-win="act-4w-2026-10-26" data-grader="" class="text-[15px] leading-[1.45] text-cp-ink-2">سیکٹر کے کوچوں کے ۲۳ میں سے ۷ جاری قدم</p><ul class="mt-3 flex flex-wrap gap-2"><li data-testid="s10-check" class="rounded-full px-3 py-[5px] text-[13px] font-semibold bg-cp-green-tint text-cp-green-ink"><span data-code="" dir="auto">C-01</span>، <span data-num="1" data-den="3" data-win="act-4w-2026-10-26" data-grader="">۳ میں سے ۱</span></li><li data-testid="s10-check" class="rounded-full px-3 py-[5px] text-[13px] font-semibold bg-cp-green-tint text-cp-green-ink"><span data-code="" dir="auto">C-02</span>، <span data-num="1" data-den="2" data-win="act-4w-2026-10-26" data-grader="">۲ میں سے ۱</span></li><li data-testid="s10-check" class="rounded-full px-3 py-[5px] text-[13px] font-semibold bg-cp-green-tint text-cp-green-ink"><span data-code="" dir="auto">C-03</span>، <span data-num="1" data-den="3" data-win="act-4w-2026-10-26" data-grader="">۳ میں سے ۱</span></li><li data-testid="s10-check" class="rounded-full px-3 py-[5px] text-[13px] font-semibold bg-cp-green-tint text-cp-green-ink"><span data-code="" dir="auto">C-04</span>، <span data-num="0" data-den="1" data-win="act-4w-2026-10-26" data-grader="">۱ میں سے ۰</span></li><li data-testid="s10-check" class="rounded-full px-3 py-[5px] text-[13px] font-semibold bg-cp-green-tint text-cp-green-ink"><span data-code="" dir="auto">C-05</span>، <span data-num="2" data-den="4" data-win="act-4w-2026-10-26" data-grader="">۴ میں سے ۲</span></li><li data-testid="s10-check" class="rounded-full px-3 py-[5px] text-[13px] font-semibold bg-cp-green-tint text-cp-green-ink"><span data-code="" dir="auto">C-06</span>، <span data-num="0" data-den="2" data-win="act-4w-2026-10-26" data-grader="">۲ میں سے ۰</span></li><li data-testid="s10-check" class="rounded-full px-3 py-[5px] text-[13px] font-semibold bg-cp-green-tint text-cp-green-ink"><span data-code="" dir="auto">C-07</span>، <span data-num="2" data-den="6" data-win="act-4w-2026-10-26" data-grader="">۶ میں سے ۲</span></li><li data-testid="s10-check" class="rounded-full px-3 py-[5px] text-[13px] font-semibold bg-cp-green-tint text-cp-green-ink"><span data-code="" dir="auto">C-08</span>، <span data-num="0" data-den="2" data-win="act-4w-2026-10-26" data-grader="">۲ میں سے ۰</span></li><li data-testid="s10-check" class="rounded-full px-3 py-[5px] text-[13px] font-semibold bg-cp-grey-fill text-cp-ink-2"><span data-code="" dir="auto">C-10</span>، کچھ باقی نہیں</li></ul></div></section></div><div class=""><p data-testid="rm-trust" class="px-1 pt-6 text-[13px] leading-[1.45] text-cp-ink-3">کوچ اور اسکول کے مجموعی اعداد۔ اس صفحے پر کوئی استاد نہیں۔ کوچنگ کے لیے، جانچ پڑتال کے لیے نہیں۔</p></div></div></div></div></div></div>"`;

