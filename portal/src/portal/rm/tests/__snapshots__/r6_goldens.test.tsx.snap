px] focus-visible:ring-cp-green bg-cp-navy text-white">EN</button><button type="button" data-testid="rm-lang-ur" aria-pressed="false" class="min-h-[44px] min-w-[48px] rounded-full px-3 text-[14px] font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green text-cp-ink-2">اردو</button></div></span></header><div class="cp-enter flex flex-col px-5 pt-4 lg:px-0 lg:pt-2"><div class="flex flex-col"><section data-testid="rm-stats-window" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><p data-window="w4-2026-09-28" class="text-[15px] font-semibold text-cp-ink">28 Sep to 25 Oct</p><p data-testid="rm-stats-marker" class="mt-2 self-start rounded-[12px] bg-cp-navy-tint px-3 py-2 text-[13px] text-cp-navy"><span data-date="2026-09-28">Scoring changed on 28 Sep. Windows before it are not compared.</span></p></section><div class="flex flex-col"><div data-testid="rm-stats-row" data-w="W-IP-TIME" data-state="ranked" data-wrow="sector" class="flex w-full items-start gap-3 border-t border-cp-hairline py-3.5 text-start first:border-t-0 "><span class="flex min-w-0 flex-1 flex-col gap-1"><div class="grid items-start gap-x-4 gap-y-1 grid-cols-[auto_minmax(0,1fr)] "><span data-num="171" data-den="505" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="contents"><span data-ring="row" class="relative inline-flex shrink-0 items-center justify-center col-start-1 row-span-2 row-start-1 self-start" style="width: 56px; height: 56px;"><svg width="56" height="56" viewBox="0 0 56 56" aria-hidden="true" class="absolute inset-0"><circle cx="28" cy="28" r="25" fill="none" stroke-width="6" style="stroke: var(--cp-ring-track);"></circle><circle data-arc="" class="cp-ring__arc" cx="28" cy="28" r="25" fill="none" stroke-width="6" stroke-linecap="round" stroke-dasharray="53.19 157.08" transform="rotate(-90 28 28)" style="stroke: var(--cp-green); --cp-arc-len: 53.19;"></circle></svg><span class="cp-ring__n font-extrabold text-[17px] leading-none">171</span></span><span class="col-start-2 row-start-1 self-end text-[17px] font-bold leading-tight text-cp-navy"> of 505</span></span><div class="col-start-2 row-start-2 min-w-0"><p class="text-[16px] font-semibold leading-snug text-cp-ink">Ran out of time</p><p class="mt-0.5 text-[14px] leading-[1.45] text-cp-ink-2">lessons whose plan asked for independent practice ran out of time before the practice.</p></div></div><p data-window="w4-2026-09-28" class="text-[13px] leading-[1.45] text-cp-ink-3">28 Sep to 25 Oct · lesson-plan fidelity · scoring changed 28 Sep</p></span></div><div data-testid="rm-stats-row" data-w="W-WARM" data-state="not_yet" data-wrow="sector" class="flex w-full items-start gap-3 border-t border-cp-hairline py-3.5 text-start first:border-t-0 "><span data-ring="row" class="relative inline-flex shrink-0 items-center justify-center me-1" style="width: 56px; height: 56px;"><svg width="56" height="56" viewBox="0 0 56 56" aria-hidden="true" class="absolute inset-0"><circle cx="28" cy="28" r="25" fill="none" stroke-width="6" style="stroke: var(--cp-ring-track);"></circle></svg></span><span class="flex min-w-0 flex-1 flex-col gap-1"><p class="text-[16px] font-semibold leading-snug text-cp-ink">Warm-up skipped</p><p data-num="2" data-den="3" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="text-[13.5px] leading-[1.45] text-cp-ink-2">Not enough recordings yet across the sector: 2 of 3 coaches with 5 lessons</p><p data-window="w4-2026-09-28" class="text-[13px] leading-[1.45] text-cp-ink-3">28 Sep to 25 Oct · lesson-plan fidelity · scoring changed 28 Sep</p></span></div></div></div><div class=""><p data-testid="rm-trust" class="px-1 pt-6 text-[13px] leading-[1.45] text-cp-ink-3">Aggregates per coach and school. No teacher appears on this page. For coaching, never for evaluation.</p></div></div></div></div></div></div>"`;

