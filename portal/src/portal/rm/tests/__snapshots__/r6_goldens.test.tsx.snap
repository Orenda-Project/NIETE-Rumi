lor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-dot" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="1"></circle></svg><span>حلقہ</span></a><a data-nav="stats" aria-current="page" class="flex min-h-[48px] min-w-[60px] flex-1 flex-col items-center justify-center gap-[3px] whitespace-nowrap rounded-xl text-[11px] font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green text-cp-green-ink [&amp;_svg]:text-cp-green" href="/portal/rm/stats"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chart-column" aria-hidden="true"><path d="M3 3v16a2 2 0 0 0 2 2h16"></path><path d="M18 17V9"></path><path d="M13 17V5"></path><path d="M8 17v-3"></path></svg><span>جائزہ</span></a></nav><div class="lg:ps-[240px]"><div class="mx-auto w-full max-w-[640px] lg:px-16 lg:pt-9 lg:max-w-[848px]"><div class=" pb-[calc(96px+env(safe-area-inset-bottom))] lg:pb-16"><div class="min-w-0"><header data-testid="rm-band" class="flex items-start gap-3 border-b border-cp-hairline bg-cp-surface px-5 pb-3 pt-4 lg:border-0 lg:bg-transparent lg:px-0 lg:pb-4 lg:pt-0"><div class="min-w-0 flex-1"><h1 class="break-words text-[24px] font-extrabold leading-[1.2] tracking-[-0.01em] text-cp-navy [overflow-wrap:anywhere] lg:text-[30px]">⁦Urban-I⁩، جائزہ</h1><div class="mt-1.5 text-[13px] leading-[1.4] text-cp-ink-3"><span data-testid="rm-page-sub">اس مدت میں سیکٹر کی کمزوریاں، جانچے گئے اسباق کے لحاظ سے</span></div></div><span class="lg:hidden"><div dir="ltr" data-lang-toggle="" class="flex shrink-0 items-center gap-1 rounded-full p-1 border border-cp-hairline bg-white "><button type="button" data-testid="rm-lang-en" aria-pressed="false" class="min-h-[44px] min-w-[48px] rounded-full px-3 text-[14px] font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green text-cp-ink-2">EN</button><button type="button" data-testid="rm-lang-ur" aria-pressed="true" class="min-h-[44px] min-w-[48px] rounded-full px-3 text-[14px] font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green bg-cp-navy text-white">اردو</button></div></span></header><div class="cp-enter flex flex-col px-5 pt-4 lg:px-0 lg:pt-2"><div class="flex flex-col"><section data-testid="rm-stats-window" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><p data-window="w4-2026-09-28" class="text-[15px] font-semibold text-cp-ink">۲۸ ستمبر تا ۲۵ اکتوبر</p><p data-testid="rm-stats-marker" class="mt-2 self-start rounded-[12px] bg-cp-navy-tint px-3 py-2 text-[13px] text-cp-navy"><span data-date="2026-09-28">نمبر دینے کا طریقہ ۲۸ ستمبر کو بدلا۔ اس سے پہلے کی مدت کا موازنہ نہیں کیا جاتا۔</span></p></section><div class="flex flex-col"><div data-testid="rm-stats-row" data-w="W-IP-TIME" data-state="ranked" data-wrow="sector" class="flex w-full items-start gap-3 border-t border-cp-hairline py-3.5 text-start first:border-t-0 "><span class="flex min-w-0 flex-1 flex-col gap-1"><div class="grid items-start gap-x-4 gap-y-1 grid-cols-[minmax(0,1fr)_auto] "><span data-num="171" data-den="505" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="contents"><span class="col-start-1 row-start-1 self-end text-[17px] font-bold leading-tight text-cp-navy">۵۰۵ میں سے </span><span data-ring="row" class="relative inline-flex shrink-0 items-center justify-center col-start-2 row-span-2 row-start-1 self-start" style="width: 56px; height: 56px;"><svg width="56" height="56" viewBox="0 0 56 56" aria-hidden="true" class="absolute inset-0"><circle cx="28" cy="28" r="25" fill="none" stroke-width="6" style="stroke: var(--cp-ring-track);"></circle><circle data-arc="" class="cp-ring__arc" cx="28" cy="28" r="25" fill="none" stroke-width="6" stroke-linecap="round" stroke-dasharray="53.19 157.08" transform="rotate(-90 28 28)" style="stroke: var(--cp-green); --cp-arc-len: 53.19;"></circle></svg><span class="cp-ring__n font-extrabold text-[17px] leading-none">۱۷۱</span></span></span><div class="col-start-1 row-start-2 min-w-0"><p class="text-[16px] font-semibold leading-snug text-cp-ink">وقت ختم ہو گیا</p><p class="mt-0.5 text-[14px] leading-[1.45] text-cp-ink-2">جن اسباق کے منصوبے میں خود مشق شامل تھی، ان میں مشق سے پہلے ہی وقت ختم ہو گیا۔</p></div></div><p data-window="w4-2026-09-28" class="text-[13px] leading-[1.45] text-cp-ink-3">۲۸ ستمبر تا ۲۵ اکتوبر، سبق کے منصوبے پر عمل، نمبر دینے کا طریقہ ۲۸ ستمبر کو بدلا</p></span></div><div data-testid="rm-stats-row" data-w="W-WARM" data-state="not_yet" data-wrow="sector" class="flex w-full items-start gap-3 border-t border-cp-hairline py-3.5 text-start first:border-t-0 "><span data-ring="row" class="relative inline-flex shrink-0 items-center justify-center me-1" style="width: 56px; height: 56px;"><svg width="56" height="56" viewBox="0 0 56 56" aria-hidden="true" class="absolute inset-0"><circle cx="28" cy="28" r="25" fill="none" stroke-width="6" style="stroke: var(--cp-ring-track);"></circle></svg></span><span class="flex min-w-0 flex-1 flex-col gap-1"><p class="text-[16px] font-semibold leading-snug text-cp-ink">ابتدائی سرگرمی نہیں ہوئی</p><p data-num="2" data-den="3" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="text-[13.5px] leading-[1.45] text-cp-ink-2">سیکٹر بھر میں ابھی کافی ریکارڈنگز نہیں: ۵ اسباق والے ۳ میں سے ۲ کوچ</p><p data-window="w4-2026-09-28" class="text-[13px] leading-[1.45] text-cp-ink-3">۲۸ ستمبر تا ۲۵ اکتوبر، سبق کے منصوبے پر عمل، نمبر دینے کا طریقہ ۲۸ ستمبر کو بدلا</p></span></div></div></div><div class=""><p data-testid="rm-trust" class="px-1 pt-6 text-[13px] leading-[1.45] text-cp-ink-3">کوچ اور اسکول کے مجموعی اعداد۔ اس صفحے پر کوئی استاد نہیں۔ کوچنگ کے لیے، جانچ پڑتال کے لیے نہیں۔</p></div></div></div></div></div></div>"`;
