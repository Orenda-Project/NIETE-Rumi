="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3"><button type="button" data-testid="course-card-c-1" class="text-left rounded-xl border border-border bg-card p-5 shadow-sm transition-all hover:shadow-md hover:-translate-y-0.5"><div class="flex items-center justify-between mb-2"><span class="text-xs font-bold tracking-wider text-muted-foreground">COURSE 1</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check w-4 h-4 text-green-700"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg></div><div class="text-base font-semibold text-foreground mb-3">Classroom Routines</div><div class="h-2 rounded-full bg-muted overflow-hidden mb-2.5" role="progressbar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100" aria-label="Classroom Routines progress"><div class="h-full rounded-full" style="width: 100%; background-color: rgb(21, 128, 61);"></div></div><div class="text-sm font-medium text-green-700">3 / 3 modules</div></button><button type="button" data-testid="course-card-c-2" class="text-left rounded-xl border border-border bg-card p-5 shadow-sm transition-all hover:shadow-md hover:-translate-y-0.5"><div class="flex items-center justify-between mb-2"><span class="text-xs font-bold tracking-wider text-muted-foreground">COURSE 2</span></div><div class="text-base font-semibold text-foreground mb-3">Group Work</div><div class="h-2 rounded-full bg-muted overflow-hidden mb-2.5" role="progressbar" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100" aria-label="Group Work progress"><div class="h-full rounded-full" style="width: 50%; background-color: rgb(66, 48, 125);"></div></div><div class="text-sm font-medium text-foreground">2 / 4 modules</div></button></div><div class="mt-4 rounded-2xl border bg-card p-2 shadow-sm"><div class="mt-2 mx-1.5 mb-1.5 rounded-xl p-3 border border-dashed" data-testid="level-certificate-card"><div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock w-4 h-4 text-muted-foreground shrink-0"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg><span class="text-[15px] font-semibold text-foreground">Level certificate</span></div><p class="mt-1 text-sm text-muted-foreground">Issued once all 9 module exams are passed. Modules can be taken in any order; inside a module, each session opens once the one before it is passed.</p><div class="h-1.5 rounded-full bg-muted overflow-hidden mt-2.5 mb-1" role="progressbar" aria-valuemin="0" aria-valuemax="9" aria-valuenow="1" aria-label="Module exams passed"><div class="h-full rounded-full bg-accent transition-[width] duration-500" style="width: 11%;"></div></div><p class="text-sm text-muted-foreground" data-testid="level-certificate-progress">1 of 9 module exams passed</p><button type="button" data-testid="level-certificate-claim" data-ready="false" class="mt-2.5 w-full inline-flex items-center justify-center gap-2 rounded-md px-3 py-2 text-sm font-medium transition-colors bg-muted text-muted-foreground hover:bg-muted/70">Receive certificate</button></div></div></section></div></main></div>"`;

