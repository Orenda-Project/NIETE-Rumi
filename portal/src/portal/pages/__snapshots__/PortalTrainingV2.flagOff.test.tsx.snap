utton type="button" data-testid="vendor-card-ISAPS" class="relative text-left rounded-2xl border border-border bg-card overflow-hidden transition-all shadow-sm hover:shadow-md hover:-translate-y-0.5 hover:[border-color:var(--tint)] focus-visible:[border-color:var(--tint)]" style="--tint: #42307d;"><div class="h-2" style="background-color: rgb(66, 48, 125);"></div><div class="h-28 flex items-center justify-center px-6" style="background-color: rgba(66, 48, 125, 0.06);"><img src="/src/assets/vendors/isaps.png" alt="I-SAPS" class="max-h-16 max-w-full w-auto object-contain" loading="lazy"></div><div class="px-5 pt-4 pb-1"><div class="font-semibold text-lg text-foreground truncate">I-SAPS</div></div><div class="px-5 pb-5"><div class="text-sm text-muted-foreground mb-4">1 level · 54 modules</div><div class="h-2 rounded-full bg-muted overflow-hidden mb-2" role="progressbar" aria-valuenow="11" aria-valuemin="0" aria-valuemax="100" aria-label="I-SAPS progress"><div class="h-full rounded-full transition-[width] duration-500" style="width: 11%; background-color: rgb(66, 48, 125);"></div></div><div class="flex items-center justify-between"><span class="text-sm font-semibold text-foreground" data-testid="vendor-certificate-count">0 Certificates</span><span class="text-sm text-muted-foreground" data-testid="vendor-progress-pct">11%</span></div></div></button><button type="button" data-testid="vendor-card-BEACONHOUSE" class="relative text-left rounded-2xl border border-border bg-card overflow-hidden transition-all shadow-sm hover:shadow-md hover:-translate-y-0.5 hover:[border-color:var(--tint)] focus-visible:[border-color:var(--tint)]" style="--tint: #1b3a6b;"><div class="h-2" style="background-color: rgb(27, 58, 107);"></div><div class="h-28 flex items-center justify-center px-6" style="background-color: rgba(27, 58, 107, 0.06);"><img src="/src/assets/vendors/beaconhouse.png" alt="Beacon House" class="max-h-16 max-w-full w-auto object-contain" loading="lazy"></div><div class="px-5 pt-4 pb-1"><div class="font-semibold text-lg text-foreground truncate">Beacon House</div></div><div class="px-5 pb-5"><div class="text-sm text-muted-foreground mb-4">2 levels · 40 modules</div><div class="h-2 rounded-full bg-muted overflow-hidden mb-2" role="progressbar" aria-valuenow="3" aria-valuemin="0" aria-valuemax="100" aria-label="Beacon House progress"><div class="h-full rounded-full transition-[width] duration-500" style="width: 3%; background-color: rgb(27, 58, 107);"></div></div><div class="flex items-center justify-between"><span class="text-sm font-semibold text-foreground" data-testid="vendor-certificate-count">0 Certificates</span><span class="text-sm text-muted-foreground" data-testid="vendor-progress-pct">3%</span></div></div></button></div></section><div class="mt-8"><button type="button" class="text-xs text-muted-foreground underline" data-testid="training-edit-bands">Change the grades you teach</button></div></div></main></div>"`;

