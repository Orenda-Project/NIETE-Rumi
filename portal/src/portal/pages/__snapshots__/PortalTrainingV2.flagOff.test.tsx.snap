ransition-colors text-muted-foreground" aria-haspopup="dialog" aria-expanded="false" aria-controls="radix-:r:" data-state="closed"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-ellipsis w-5 h-5 shrink-0"><circle cx="12" cy="12" r="1"></circle><circle cx="19" cy="12" r="1"></circle><circle cx="5" cy="12" r="1"></circle></svg><span class="text-xs w-full truncate text-center">Other</span></button></div></nav><main class="px-4 md:px-6 lg:px-8 pt-4 pb-20 md:pb-8"><div class="container mx-auto px-4 sm:px-6 py-6 sm:py-8 max-w-6xl" data-testid="training-v2-root"><div class="rounded-2xl p-6 sm:p-7 mb-7 text-white" style="background: linear-gradient(135deg, hsl(229 17% 24%) 0%, hsl(146 44% 51%) 100%);"><div class="flex flex-wrap items-end justify-between gap-4"><div><h1 class="text-3xl sm:text-4xl font-light mb-1">Training</h1><p class="text-sm text-white/75">Your assigned professional development.</p></div><button type="button" class="inline-flex items-center gap-2 rounded-lg border border-white/40 bg-white/15 px-4 py-2 text-sm font-semibold text-white hover:bg-white/25 transition-colors" data-testid="certificates-button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-award w-4 h-4"><path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"></path><circle cx="12" cy="8" r="6"></circle></svg>Certificates<span class="rounded-full bg-white px-2 text-xs font-semibold text-slate-800 tabular-nums">1</span></button></div></div><section class="mb-8" data-testid="vendor-grouping"><div class="flex items-baseline justify-between mb-3"><h2 class="text-base font-semibold text-foreground flex items-center gap-2"><s