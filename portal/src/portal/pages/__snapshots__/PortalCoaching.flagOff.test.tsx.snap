 items-center gap-1"><button type="button" aria-label="Back" class="flex h-11 w-11 items-center justify-center rounded-lg text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left h-6 w-6"><path d="m15 18-6-6 6-6"></path></svg></button><h1 class="text-lg font-bold text-primary ">Check and send</h1></div><input data-testid="audio-input" type="file" accept=".m4a,.mp4,.aac,.mp3,.ogg,.opus,.wav,.amr,.3gp,.webm,audio/*" class="hidden"><div class="flex flex-col gap-3.5"><div class="flex flex-col gap-3.5 rounded-2xl border-2 border-accent bg-white p-4"><div class="flex items-center gap-3.5"><span class="flex h-[52px] w-[52px] shrink-0 items-center justify-center rounded-full bg-accent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check h-7 w-7 text-white" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><span class="flex min-w-0 flex-col gap-0.5"><span class="truncate text-[19px] font-bold">Period 3.m4a</span><span class="text-[15px] text-[#5b6170]">30 minutes · 1 KB</span></span></div><button type="button" class="h-11 text-[15px] font-semibold text-[#5b6170] underline">Choose a different file</button></div><div class="mt-1 text-base font-bold text-primary">Add more <span class="font-normal text-muted-foreground">(you can skip this)</span></div><div class="flex items-center gap-3 rounded-[14px] bg-white p-3.5 border border-[#e5e7eb]"><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-[10px] bg-[#eef0f4] text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-text h-[22px] w-[22px]" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg></span><span class="flex min-w-0 flex-1 flex-col gap-0.5"><span class="truncate text-[17px] font-semibold" dir="auto">Lesson plan</span><span class="text-sm text-muted-foreground">From our library, or a photo of yours.</span></span><button type="button" aria-label="Add a lesson plan" class="h-11 shrink-0 rounded-[10px] border-2 border-primary bg-white px-4 text-base font-bold text-primary">+ Add</button></div><div class="rounded-[14px] border border-[#e5e7eb] bg-white p-3.5 flex flex-col gap-3"><div class="flex items-center gap-3"><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-[10px] bg-[#eef0f4] text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-camera h-[22px] w-[22px]" aria-hidden="true"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"></path><circle cx="12" cy="13" r="3"></circle></svg></span><span class="flex flex-1 flex-col gap-0.5"><span class="text-[17px] font-semibold">Photos of the board</span><span class="text-sm text-muted-foreground">Up to 3. No faces.</span></span><button type="button" aria-label="Add photos of the board" class="h-11 shrink-0 rounded-[10px] border-2 border-primary bg-white px-4 text-base font-bold text-primary disabled:border-[#c4c8cf] disabled:text-[#9aa0aa]">+ Add</button></div><input data-testid="photos-input" type="file" multiple="" accept=".jpg,.jpeg,.png,image/jpeg,image/png" class="hidden"></div><button type="button" class="mt-1.5 flex h-16 items-center justify-center gap-3 rounded-[14px] bg-primary text-xl font-bold text-white">Send to Digital Coach</button></div></div></main></div>"`;

