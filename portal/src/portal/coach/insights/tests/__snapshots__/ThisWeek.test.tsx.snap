exports[`S1 This week > ur > insufficient: renders, keeps the count contract, no identity 1`] = `"<div data-testid="layout"><div data-testid="insights-this-week" data-cp-shell="" class="cp bg-cp-ground text-cp-ink  "><div class="lg:ps-[240px]"><div class="mx-auto w-full max-w-[640px] lg:px-16 lg:pt-9 lg:max-w-[848px]"><div class=" pb-4 md:max-lg:pb-[calc(80px+env(safe-area-inset-bottom))] lg:pb-16"><div class="min-w-0"><header data-testid="insights-band" class="cp-band"><div class="cp-lattice" aria-hidden="true"></div><div class="cp-band__top mb-2.5 flex min-h-[28px] items-center justify-between gap-3"><span class="cp-band__lockup flex items-center gap-2 text-[12px] font-extrabold tracking-[0.14em]" dir="ltr"><img src="/src/assets/niete-logo.png" alt="" class="block h-[22px] w-auto">NIETE</span><span class="flex items-center gap-2"><span class="cp-band__date text-[13px] font-semibold"><span data-testid="s1-today"><span data-date="2026-10-26">۲۶ اکتوبر</span></span></span></span></div><h1 class="cp-band__title text-[24px] font-extrabold leading-[1.2] tracking-[-0.01em] lg:text-[30px]">اس ہفتے</h1><div class="cp-band__body mt-3"><div class="flex flex-col gap-3"><div data-testid="s1-empty" data-status="insufficient" role="status" class="flex flex-col gap-3"><div class="flex items-center gap-4 flex-row-reverse"><span data-ring="hero" class="relative inline-flex shrink-0 items-center justify-center " style="width: 104px; height: 104px;"><svg width="104" height="104" viewBox="0 0 104 104" aria-hidden="true" class="absolute inset-0"><circle cx="52" cy="52" r="47" fill="none" stroke-width="10" style="stroke: var(--cp-ring-track);"></circle></svg></span><p class="min-w-0 flex-1 text-[17px] font-medium leading-[1.42]"><span data-num="9" data-den="20" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash">ابھی کافی ریکارڈنگز نہیں: پچھلے ۴ ہفتوں میں ۹ جانچے گئے اسباق، ۲۰ درکار۔ آپ کے جاری قدم دکھائی دے رہے ہیں۔</span></p></div><p data-window="w4-2026-09-28" class="self-start rounded-full bg-cp-green px-3 py-[5px] text-[12px] font-semibold leading-[1.45] text-cp-navy">۲۸ ستمبر تا ۲۵ اکتوبر، سبق کے منصوبے پر عمل، نمبر دینے کا طریقہ ۲۸ ستمبر کو بدلا</p></div></div></div></header><div class="cp-enter flex flex-col px-5 pt-4 lg:px-0 lg:pt-2"><div class="flex flex-col pb-2"><p data-num="11" data-den="17" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="px-1 pt-3 text-[13px] leading-[1.45] text-cp-ink-3">۱۷ ریکارڈنگز میں سے ۱۱ کے ساتھ منصوبہ جُڑا تھا۔</p><section data-testid="s1-steps" data-section="" class="mt-5 border-t border-cp-hairline pt-6 "><div class="flex items-start justify-between gap-3"><div class="min-w-0"><p class="cp-label text-[12px] font-bold uppercase leading-snug tracking-[0.08em] text-cp-ink-3">جاری قدم</p><p class="mt-1 text-[13px] leading-[1.45] text-cp-ink-3">جو آپ نے طے کیے، اور اگلی تین ریکارڈنگز</p></div></div><div class="mt-2"><ul class="flex flex-col"><li data-testid="step-row" data-step="00000000-0000-4000-8000-050000000321" class="flex flex-col gap-1.5 border-t border-cp-hairline py-4 first:border-t-0 first:pt-2"><p data-text="library" class="text-[17px] font-semibold leading-[1.4] text-cp-ink">سبق سے پہلے ایک بچے کو وقت کا نگران بنائیں، تین نشان (۱۰، ۱۷، ۲۵) دیں؛ آواز پر مرحلہ بدلیں</p><p data-testid="step-sub" class="text-[13px] leading-[1.45] text-cp-ink-3 [overflow-wrap:anywhere]"><span data-code="" dir="ltr" class="[unicode-bidi:isolate]">⁦T-04، Govt. Primary School Fictional-52⁩</span>، طے <span data-date="2026-10-19">۱۹ اکتوبر</span>، جانچ: دورہ <span data-date="2026-11-02">پیر ۲ نومبر</span></p><div class="mt-1 flex flex-wrap items-center gap-3"><span data-testid="step-strip" class="flex items-center gap-1.5"><span data-dot="partial" role="img" aria-label="ادھورا" class="inline-block h-3.5 w-3.5 rounded-full border-[1.5px] rtl:-scale-x-100 border-cp-green bg-[linear-gradient(90deg,var(--cp-green)_50%,white_50%)]"></span><span data-dot="missing" aria-hidden="true" class="inline-block h-3.5 w-3.5 rounded-full border-[1.5px] rtl:-scale-x-100 border-cp-track bg-white"></span><span data-dot="missing" aria-hidden="true" class="inline-block h-3.5 w-3.5 rounded-full border-[1.5px] rtl:-scale-x-100 border-cp-track bg-white"></span></span><span data-num="2" data-den="3" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="inline-flex min-h-[28px] items-center rounded-full px-3 text-[13px] font-semibold bg-cp-green-tint text-cp-green-ink"><span data-testid="step-chip" data-chip="to_come">۲ ریکارڈنگز باقی</span></span></div><div class="flex flex-col gap-1"><div class="flex flex-wrap items-center gap-2"><button type="button" data-testid="step-tick-yes" class="cp-press min-h-[44px] rounded-[12px] px-4 text-[14px] font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green disabled:opacity-60 border-2 border-cp-navy bg-white text-cp-navy">ہوا</button><button type="button" data-testid="step-tick-no" class="cp-press min-h-[44px] rounded-[12px] px-4 text-[14px] font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green disabled:opacity-60 border border-cp-hairline bg-white text-cp-ink-2">ابھی نہیں</button></div></div></li></ul><p data-testid="s1-steps-legend" class="pt-1 text-[13px] text-cp-ink-3">ہوا، ادھورا، نہیں ہوا</p></div></section><section data-testid="s1-phonics" data-status="testing" data-section="" class="mt-5 border-t border-cp-hairline pt-5"><p data-testid="s1-phonics-line" data-nonum="" class="text-[15px] leading-[1.45] text-cp-ink-2">حروف کی آوازوں کی جانچ: ۳۰ پڑھائی کے گھنٹے سنے جانے کے بعد شروع ہو گی (۳۰ میں سے ۱۲)</p></section><div class="mt-5 border-t border-cp-hairline pt-4"><a data-testid="s1-stats-link" class="flex min-h-[44px] items-center gap-1.5 text-[17px] font-semibold text-cp-green-ink outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green" href="/portal/coach/insights/stats">اوسط اعداد اور نتائج<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right rotate-180" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></a></div></div><div class="lg:hidden"><p data-testid="trust-line" class="px-1 pt-6 text-[13px] leading-[1.45] text-cp-ink-3">کوڈ، نام نہیں۔ کوچنگ کے لیے، جانچ پڑتال کے لیے نہیں۔</p></div></div></div></div></div></div></div></div>"`;

