exports[`S1 This week > en > stale: renders, keeps the count contract, no identity 1`] = `"<div data-testid="layout"><div data-testid="insights-this-week" data-cp-shell="" class="cp bg-cp-ground text-cp-ink  "><div class="lg:ps-[240px]"><div class="mx-auto w-full max-w-[640px] lg:px-16 lg:pt-9 lg:max-w-[848px]"><div class=" pb-4 md:max-lg:pb-[calc(80px+env(safe-area-inset-bottom))] lg:pb-16"><div class="min-w-0"><header data-testid="insights-band" class="cp-band"><div class="cp-lattice" aria-hidden="true"></div><div class="cp-band__top mb-2.5 flex min-h-[28px] items-center justify-between gap-3"><span class="cp-band__lockup flex items-center gap-2 text-[12px] font-extrabold tracking-[0.14em]" dir="ltr"><img src="/src/assets/niete-logo.png" alt="" class="block h-[22px] w-auto">NIETE</span><span class="flex items-center gap-2"><span class="cp-band__date text-[13px] font-semibold"><span data-testid="s1-today"><span data-date="2026-10-26">26 Oct</span></span></span></span></div><h1 class="cp-band__title text-[24px] font-extrabold leading-[1.2] tracking-[-0.01em] lg:text-[30px]">This week</h1><div class="cp-band__body mt-3"><div class="flex flex-col gap-3"><div data-testid="wcard-hero" data-w="W-IP-TIME" class="flex flex-col gap-3"><p class="cp-eyebrow text-[12px] font-bold uppercase leading-snug tracking-[0.08em] text-cp-green-ink ">NOTICE · <span data-nonum="">Move 1 of 2</span></p><div class="grid items-start gap-x-4 gap-y-1 grid-cols-[auto_minmax(0,1fr)] "><span data-num="16" data-den="46" data-win="w4-2026-09-21" data-grader="google/gemini-3.8-flash" class="contents"><span data-ring="hero" class="relative inline-flex shrink-0 items-center justify-center col-start-1 row-span-2 row-start-1 self-start" style="width: 104px; height: 104px;"><svg width="104" height="104" viewBox="0 0 104 104" aria-hidden="true" class="absolute inset-0"><circle cx="52" cy="52" r="47" fill="none" stroke-width="10" style="stroke: var(--cp-ring-track);"></circle><circle data-arc="" class="cp-