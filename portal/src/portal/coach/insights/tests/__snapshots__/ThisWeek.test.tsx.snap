="flex flex-col gap-1"><div class="flex flex-wrap items-center gap-2"><button type="button" data-testid="step-tick-yes" class="cp-press min-h-[44px] rounded-[12px] px-4 text-[14px] font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green disabled:opacity-60 border-2 border-cp-navy bg-white text-cp-navy">ہوا</button><button type="button" data-testid="step-tick-no" class="cp-press min-h-[44px] rounded-[12px] px-4 text-[14px] font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green disabled:opacity-60 border border-cp-hairline bg-white text-cp-ink-2">ابھی نہیں</button></div></div></li></ul><p data-testid="s1-steps-legend" class="pt-1 text-[13px] text-cp-ink-3">ہوا، ادھورا، نہیں ہوا</p></div></section><section data-testid="s1-not-yet" data-section="" class="mt-5 border-t border-cp-hairline pt-6 "><div class="flex items-start justify-between gap-3"><div class="min-w-0"><p class="cp-label text-[12px] font-bold uppercase leading-snug tracking-[0.08em] text-cp-ink-3">ابھی نہیں</p><p class="mt-1 text-[13px] leading-[1.45] text-cp-ink-3">ان کے کارڈ کے لیے ابھی مزید ریکارڈنگز چاہییں</p></div></div><div class="mt-2"><div data-testid="wrow-not-yet" data-w="W-WARM" data-state="not_yet" data-wrow="coach" class="flex w-full items-start gap-3 border-t border-cp-hairline py-3.5 text-start first:border-t-0 "><span class="flex min-w-0 flex-1 flex-col gap-1"><span class="text-[17px] font-semibold leading-[1.4] text-cp-ink">ابتدائی سرگرمی نہیں ہوئی</span><span class="text-[13px] leading-[1.45] text-cp-ink-3"><span class="block"><span data-num="12" data-den="20" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash">۲۰ میں سے ۱۲</span> اسباق جانچے گئے، <span data-nonum="">۲۰</span> ہونے پر کارڈ آئے گا</span><span data-num="2" data-den="3" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="block">درکار ۳ کوڈ میں سے ۲ میں نظر آیا</span><span class="block"><span data-window="w4-2026-09-28">۲۸ ستمبر تا ۲۵ اکتوبر</span></span></span></span></div></div></section><section data-testid="s1-phonics" data-status="testing" data-section="" class="mt-5 border-t border-cp-hairline pt-5"><p data-testid="s1-phonics-line" data-nonum="" class="text-[15px] leading-[1.45] text-cp-ink-2">حروف کی آوازوں کی جانچ: ۳۰ پڑھائی کے گھنٹے سنے جانے کے بعد شروع ہو گی (۳۰ میں سے ۱۲)</p></section><div class="mt-5 border-t border-cp-hairline pt-4"><a data-testid="s1-stats-link" class="flex min-h-[44px] items-center gap-1.5 text-[17px] font-semibold text-cp-green-ink outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green" href="/portal/coach/insights/stats">اوسط اعداد اور نتائج<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right rotate-180" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></a></div></div><div class="lg:hidden"><p data-testid="trust-line" class="px-1 pt-6 text-[13px] leading-[1.45] text-cp-ink-3">کوڈ، نام نہیں۔ کوچنگ کے لیے، جانچ پڑتال کے لیے نہیں۔</p></div></div></div></div></div></div></div></div>"`;

exports[`S1 This week > ur > pending: the empty message, no bare digit 1`] = `"<div data-testid="layout"><div data-testid="insights-this-week" data-cp-shell="" class="cp bg-cp-ground text-cp-ink  "><div class="lg:ps-[240px]"><div class="mx-auto w-full max-w-[640px] lg:px-16 lg:pt-9 lg:max-w-[848px]"><div class=" pb-4 md:max-lg:pb-[calc(80px+env(safe-area-inset-bottom))] lg:pb-16"><div class="min-w-0"><header data-testid="insights-band" class="cp-band"><div class="cp-lattice" aria-hidden="true"></div><div class="cp-band__top mb-2.5 flex min-h-[28px] items-center justify-between gap-3"><span class="cp-band__lockup flex items-center gap-2 text-[12px] font-extrabold tracking-[0.14em]" dir="ltr"><img src="/src/assets/niete-logo.png" alt="" class="block h-[22px] w-auto">NIETE</span><span class="flex items-center gap-2"><span class="cp-band__date text-[13px] font-semibold"><span data-testid="s1-today"><span data-date="2026-10-26">۲۶ اکتوبر</span></span></span></span></div><h1 class="cp-band__title text-[24px] font-extrabold leading-[1.2] tracking-[-0.01em] lg:text-[30px]">اس ہفتے</h1><div class="cp-band__body mt-3"><div class="flex flex-col gap-3"><div data-testid="s1-empty" data-status="pending" role="status" class="flex flex-col gap-3"><div class="flex items-center gap-4 flex-row-reverse"><span data-ring="hero" class="relative inline-flex shrink-0 items-center justify-center " style="width: 104px; height: 104px;"><svg width="104" height="104" viewBox="0 0 104 104" aria-hidden="true" class="absolute inset-0"><circle cx="52" cy="52" r="47" fill="none" stroke-width="10" style="stroke: var(--cp-ring-track);"></circle></svg></span><p class="min-w-0 flex-1 text-[17px] font-medium leading-[1.42]">تیاری جاری ہے: آپ کے پہلے ہفتے کے قدم آج رات کے تجزیے کے بعد آئیں گے۔</p></div></div></div></div></header><div class="cp-enter flex flex-col px-5 pt-4 lg:px-0 lg:pt-2"><div class="flex flex-col pb-2"><section data-testid="s1-phonics" data-status="testing" data-section="" class="mt-5 border-t border-cp-hairline pt-5"><p data-testid="s1-phonics-line" data-nonum="" class="text-[15px] leading-[1.45] text-cp-ink-2">حروف کی آوازوں کی جانچ: ۳۰ پڑھائی کے گھنٹے سنے جانے کے بعد شروع ہو گی (۳۰ میں سے ۱۲)</p></section><div class="mt-5 border-t border-cp-hairline pt-4"><a data-testid="s1-stats-link" class="flex min-h-[44px] items-center gap-1.5 text-[17px] font-semibold text-cp-green-ink outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green" href="/portal/coach/insights/stats">اوسط اعداد اور نتائج<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right rotate-180" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></a></div></div><div class="lg:hidden"><p data-testid="trust-line" class="px-1 pt-6 text-[13px] leading-[1.45] text-cp-ink-3">کوڈ، نام نہیں۔ کوچنگ کے لیے، جانچ پڑتال کے لیے نہیں۔</p></div></div></div></div></div></div></div></div>"`;

exports[`S1 This week > ur > phonics_ok: renders, keeps the count contract, no identity 1`] = `"<div data-testid="layout"><div data-testid="insights-this-week" data-cp-shell="" class="cp bg-cp-ground text-cp-ink  "><div class="lg:ps-[240px]"><div class="mx-auto w-full max-w-[640px] lg:px-16 lg:pt-9 lg:max-w-[848px]"><div class=" pb-4 md:max-lg:pb-[calc(80px+env(safe-area-inset-bottom))] lg:pb-16"><div class="min-w-0"><header data-testid="insights-band" class="cp-band"><div class="cp-lattice" aria-hidden="true"></div><div class="cp-band__top mb-2.5 flex min-h-[28px] items-center justify-between gap-3"><span class="cp-band__lockup flex items-center gap-2 text-[12px] font-extrabold tracking-[0.14em]" dir="ltr"><img src="/src/assets/niete-logo.png" alt="" class="block h-[22px] w-auto">NIETE</span><span class="flex items-center gap-2"><span class="cp-band__date text-[13px] font-semibold"><span data-testid="s1-today"><span data-date="2026-10-26">۲۶ اکتوبر</span></span></span></span></div><h1 class="cp-band__title text-[24px] font-extrabold leading-[1.2] tracking-[-0.01em] lg:text-[30px]">اس ہفتے</h1><div class="cp-band__body mt-3"><div class="flex flex-col gap-3"><div data-testid="wcard-hero" data-w="W-IP-TIME" class="flex flex-col gap-3"><p class="cp-eyebrow text-[12px] font-bold uppercase leading-snug tracking-[0.08em] text-cp-green-ink ">دیکھیں، <span data-nonum="">دو میں سے پہلا قدم</span></p><div class="grid items-start gap-x-4 gap-y-1 grid-cols-[minmax(0,1fr)_auto] "><span data-num="17" data-den="49" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="contents"><span class="col-start-1 row-start-1 self-end text-[22px] font-bold leading-tight">۴۹ میں سے </span><span data-ring="hero" class="relative inline-flex shrink-0 items-center justify-center col-start-2 row-span-2 row-start-1 self-start" style="width: 104px; height: 104px;"><svg width="104" height="104" viewBox="0 0 104 104" aria-hidden="true" class="absolute inset-0"><circle cx="52" cy="52" r="47" fill="none" stroke-width="10" style="stroke: var(--cp-ring-track);"></circle><circle data-arc="" class="cp-ring__arc" cx="52" cy="52" r="47" fill="none" stroke-width="10" stroke-linecap="round" stroke-dasharray="102.45 295.31" transform="rotate(-90 52 52)" style="stroke: var(--cp-green); --cp-arc-len: 102.45;"></circle></svg><span class="cp-ring__n font-extrabold cp-hero-n text-[52px] leading-none tracking-[-0.02em]">۱۷</span></span></span><div class="col-start-1 row-start-2 min-w-0"><p class="text-[17px] font-medium leading-[1.42]">جن اسباق کے منصوبے میں خود مشق شامل تھی، ان میں مشق سے پہلے ہی وقت ختم ہو گیا۔</p></div></div><p data-window="w4-2026-09-28" class="self-start rounded-full bg-cp-green px-3 py-[5px] text-[12px] font-semibold leading-[1.45] text-cp-navy">۲۸ ستمبر تا ۲۵ اکتوبر، سبق کے منصوبے پر عمل، نمبر دینے کا طریقہ ۲۸ ستمبر کو بدلا</p></div></div></div></header><div class="cp-enter flex flex-col px-5 pt-4 lg:px-0 lg:pt-2"><div class="flex flex-col pb-2"><section data-w="W-IP-TIME" data-testid="wcard" data-surface="" class="flex flex-col gap-3 rounded-[20px] bg-cp-surface p-5 shadow-[0_2px_8px_rgba(51,55,72,0.08)] lg:p-7 cp-overlap "><div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:gap-6"><div class="min-w-0 lg:flex-1"><a data-testid="wcard-where" class="-mx-1 flex min-h-[44px] items-center gap-2 rounded-xl px-1 outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green" href="/portal/coach/insights/w/W-IP-TIME/where"><span class="min-w-0 flex-1 text-[17px] font-semibold leading-[1.4] text-cp-ink [&amp;_[data-code]]:inline-block [&amp;_[data-num]]:whitespace-nowrap">پہلے <span data-code="" dir="ltr" class="[unicode-bidi:isolate]">⁦Govt. Primary School Fictional-03⁩</span> (<span data-num="6" data-den="9" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash">۹ میں سے ۶</span>)، دورہ <span data-date="2026-10-28">بدھ ۲۸ اکتوبر</span><span class="block text-[13px] font-normal leading-[1.45] text-cp-ink-3 [&amp;_[data-code]]:inline-block [&amp;_[data-num]]:whitespace-nowrap">پھر <span data-code="" dir="ltr" class="[unicode-bidi:isolate]">⁦Govt. Primary School Fictional-05⁩</span>، <span data-code="" dir="ltr" class="[unicode-bidi:isolate]">⁦Govt. Primary School Fictional-06⁩</span></span></span><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right shrink-0 text-cp-ink-3 rtl:rotate-180" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></a></div><div class="lg:w-[340px] lg:shrink-0"><div class="flex flex-wrap gap-3"><a data-testid="wcard-listen" class="cp-press inline-flex items-center justify-center gap-2 whitespace-nowrap outline-none focus-visible:ring-[3px] focus-visible:ring-cp-navy focus-visible:ring-offset-2 disabled:opacity-50 border-2 border-cp-navy bg-white text-cp-navy min-h-[52px] rounded-[14px] px-5 text-[16px] font-bold  min-w-0 flex-1" href="/portal/coach/insights/w/W-IP-TIME#moment"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-headphones shrink-0" aria-hidden="true"><path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"></path></svg><span>سنیں <span data-clock="">۰:۳۸</span></span></a><a data-testid="wcard-see" class="cp-press inline-flex items-center justify-center gap-2 whitespace-nowrap outline-none focus-visible:ring-[3px] focus-visible:ring-cp-navy focus-visible:ring-offset-2 disabled:opacity-50 bg-cp-green text-cp-navy min-h-[52px] rounded-[14px] px-5 text-[16px] font-bold  min-w-0 flex-1" href="/portal/coach/insights/w/W-IP-TIME"><span>قدم دیکھیں</span></a></div></div></div></section><div class="mt-4"><section data-testid="s1-note" data-note="00000000-0000-4000-8000-060000000001" class="flex flex-col gap-2 rounded-[16px] bg-cp-navy-tint px-4 py-3.5 text-cp-navy"><p class="flex flex-wrap items-baseline gap-x-2"><span class="cp-label text-[12px] font-bold uppercase tracking-[0.08em]">آپ کے آر ایم کی طرف سے</span><span class="text-[13px] font-semibold text-cp-ink-2"><span data-date="2026-10-30">جمعہ ۳۰ اکتوبر</span> تک</span></p><p data-text="note" class="text-[15px] leading-[1.45] text-cp-ink [overflow-wrap:anywhere]"><span data-line="1">اس مہینے «وقت ختم ہو گیا» سب سے زیادہ ⁦Govt. Primary School Fictional-03⁩ میں نظر آیا۔</span><span data-line="2"> براہِ کرم ۳۰ اکتوبر سے پہلے وہاں «ساتھی مشاہدہ، ایک نظر: وضاحت کس منٹ پر ختم ہوئی» چلائیں۔</span><span data-line="3"> لمحہ جمعے کے حلقے میں لائیں۔</span></p><div class="flex gap-2"><a data-testid="s1-note-open" class="cp-press flex min-h-[44px] flex-1 items-center justify-center rounded-[12px] px-3 text-[14px] font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green border-2 border-cp-navy bg-white text-cp-navy" href="/portal/coach/insights/w/W-IP-TIME">قدم کھولیں</a><button type="button" data-testid="s1-note-dismiss" class="cp-press flex min-h-[44px] flex-1 items-center justify-center rounded-[12px] px-3 text-[14px] font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green text-cp-ink-2">ہو گیا</button></div></section></div><div class="mt-2"><a data-testid="wrow" data-w="W-EXIT-NOPLAN" data-state="ranked" data-wrow="coach" class="flex w-full items-start gap-3 border-t border-cp-hairline py-3.5 text-start first:border-t-0  outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green" href="/portal/coach/insights/w/W-EXIT-NOPLAN"><span class="flex min-w-0 flex-1 flex-col gap-1"><span data-nonum="" class="cp-label text-[12px] font-bold uppercase tracking-[0.08em] text-cp-ink-3">دو میں سے دوسرا قدم</span><span class="text-[17px] font-semibold leading-[1.4] text-cp-ink">وقت تھا، آخر میں جانچ نہیں</span><span class="text-[15px] leading-[1.45] text-cp-ink-2">جن اسباق کے منصوبے میں اختتامی جانچ شامل تھی، ان میں وقت تھا مگر جانچ نہیں ہوئی۔</span><span class="mt-1 flex items-center gap-3"><span data-num="12" data-den="47" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="inline-flex items-baseline whitespace-pre shrink-0"><span class="text-[13px] font-semibold text-cp-ink-3">۴۷ میں سے </span><b class="text-[22px] font-extrabold leading-[1.1] tracking-[-0.01em] text-cp-navy">۱۲</b></span><span aria-hidden="true" data-bar="12/47" class="block h-1 overflow-hidden rounded-full bg-cp-track w-full max-w-[160px]"><span data-fill="" class="block h-full rounded-full bg-cp-green" style="width: 25.53191489361702%;"></span></span></span><span class="text-[13px] leading-[1.45] text-cp-ink-3">پہلے <span data-code="" dir="ltr" class="[unicode-bidi:isolate]">⁦Govt. Primary School Fictional-05⁩</span> (<span data-num="4" data-den="10" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash">۱۰ میں سے ۴</span>)، <span data-window="w4-2026-09-28">۲۸ ستمبر تا ۲۵ اکتوبر</span>، سبق کے منصوبے پر عمل</span></span><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right shrink-0 self-center text-cp-ink-3 rtl:rotate-180" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></a></div><p data-num="53" data-den="62" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="px-1 pt-3 text-[13px] leading-[1.45] text-cp-ink-3">۶۲ ریکارڈنگز میں سے ۵۳ کے ساتھ منصوبہ جُڑا تھا۔</p><section data-testid="s1-steps" data-section="" class="mt-5 border-t border-cp-hairline pt-6 "><div class="flex items-start justify-between gap-3"><div class="min-w-0"><p class="cp-label text-[12px] font-bold uppercase leading-snug tracking-[0.08em] text-cp-ink-3">جاری قدم</p><p class="mt-1 text-[13px] leading-[1.45] text-cp-ink-3">جو آپ نے طے کیے، اور اگلی تین ریکارڈنگز</p></div></div><div class="mt-2"><ul class="flex flex-col"><li data-testid="step-row" data-step="00000000-0000-4000-8000-05000000001f" class="flex flex-col gap-1.5 border-t border-cp-hairline py-4 first:border-t-0 first:pt-2"><p data-text="library" class="text-[17px] font-semibold leading-[1.4] text-cp-ink">سبق سے پہلے ایک بچے کو وقت کا نگران بنائیں، تین نشان (۱۰، ۱۷، ۲۵) دیں؛ آواز پر مرحلہ بدلیں</p><p data-testid="step-sub" class="text-[13px] leading-[1.45] text-cp-ink-3 [overflow-wrap:anywhere]"><span data-code="" dir="ltr" class="[unicode-bidi:isolate]">⁦T-31، Govt. Primary School Fictional-06⁩</span>، طے <span data-date="2026-10-07">۷ اکتوبر</span>، جانچ <span data-date="2026-10-21">بدھ ۲۱ اکتوبر</span> تک</p><div class="mt-1 flex flex-wrap items-center gap-3"><span data-testid="step-strip" class="flex items-center gap-1.5"><span data-dot="done" role="img" aria-label="ہوا" class="inline-block h-3.5 w-3.5 rounded-full border-[1.5px] rtl:-scale-x-100 border-cp-green bg-cp-green"></span><span data-dot="done" role="img" aria-label="ہوا" class="inline-block h-3.5 w-3.5 rounded-full border-[1.5px] rtl:-scale-x-100 border-cp-green bg-cp-green"></span><span data-dot="not_done" role="img" aria-label="نہیں ہوا" class="inline-block h-3.5 w-3.5 rounded-full border-[1.5px] rtl:-scale-x-100 border-cp-navy bg-white"></span></span><span data-testid="step-chip" data-chip="worked" class="inline-flex min-h-[28px] items-center rounded-full px-3 text-[13px] font-semibold bg-cp-green text-cp-navy">کامیاب</span></div><div class="flex flex-col gap-1"><div class="flex flex-wrap items-center gap-2"><button type="button" data-testid="step-tick-yes" class="cp-press min-h-[44px] rounded-[12px] px-4 text-[14px] font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green disabled:opacity-60 border-2 border-cp-navy bg-white text-cp-navy">ہوا</button><button type="button" data-testid="step-tick-no" class="cp-press min-h-[44px] rounded-[12px] px-4 text-[14px] font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green disabled:opacity-60 border border-cp-hairline bg-white text-cp-ink-2">ابھی نہیں</button></div></div></li><li data-testid="step-row" data-step="00000000-0000-4000-8000-050000000007" class="flex flex-col gap-1.5 border-t border-cp-hairline py-4 first:border-t-0 first:pt-2"><p data-text="library" class="text-[17px] font-semibold leading-[1.4] text-cp-ink">پندرہویں منٹ پر منصوبے کی مشق والی سطر پڑھیں، وقت بتائیں، آٹھ منٹ قطاروں میں چلیں</p><p data-testid="step-sub" class="text-[13px] leading-[1.45] text-cp-ink-3 [overflow-wrap:anywhere]"><span data-code="" dir="ltr" class="[unicode-bidi:isolate]">⁦T-07، Govt. Primary School Fictional-03⁩</span>، طے <span data-date="2026-10-14">۱۴ اکتوبر</span>، جانچ: دورہ <span data-date="2026-10-28">بدھ ۲۸ اکتوبر</span></p><div class="mt-1 flex flex-wrap items-center gap-3"><span data-testid="step-strip" class="flex items-center gap-1.5"><span data-dot="done" role="img" aria-label="ہوا" class="inline-block h-3.5 w-3.5 rounded-full border-[1.5px] rtl:-scale-x-100 border-cp-green bg-cp-green"></span><span data-dot="partial" role="img" aria-label="ادھورا" class="inline-block h-3.5 w-3.5 rounded-full border-[1.5px] rtl:-scale-x-100 border-cp-green bg-[linear-gradient(90deg,var(--cp-green)_50%,white_50%)]"></span><span data-dot="missing" aria-hidden="true" class="inline-block h-3.5 w-3.5 rounded-full border-[1.5px] rtl:-scale-x-100 border-cp-track bg-white"></span></span><span data-num="1" data-den="3" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="inline-flex min-h-[28px] items-center rounded-full px-3 text-[13px] font-semibold bg-cp-green-tint text-cp-green-ink"><span data-testid="step-chip" data-chip="to_come">۱ ریکارڈنگ باقی</span></span></div><div class="flex flex-col gap-1"><div class="flex flex-wrap items-center gap-2"><button type="button" data-testid="step-tick-yes" class="cp-press min-h-[44px] rounded-[12px] px-4 text-[14px] font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green disabled:opacity-60 border-2 border-cp-navy bg-white text-cp-navy">ہوا</button><button type="button" data-testid="step-tick-no" class="cp-press min-h-[44px] rounded-[12px] px-4 text-[14px] font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green disabled:opacity-60 border border-cp-hairline bg-white text-cp-ink-2">ابھی نہیں</button></div></div></li><li data-testid="step-row" data-step="00000000-0000-4000-8000-050000000013" class="flex flex-col gap-1.5 border-t border-cp-hairline py-4 first:border-t-0 first:pt-2"><p data-text="library" class="text-[17px] font-semibold leading-[1.4] text-cp-ink">بائیسویں منٹ پر اختتامی سوال پوچھیں اور پانچ سلیٹیں پڑھ کر بتائیں کہ کیا ٹھیک تھا</p><p data-testid="step-sub" class="text-[13px] leading-[1.45] text-cp-ink-3 [overflow-wrap:anywhere]"><span data-code="" dir="ltr" class="[unicode-bidi:isolate]">⁦T-19، Govt. Primary School Fictional-05⁩</span>، طے <span data-date="2026-10-20">۲۰ اکتوبر</span>، جانچ: دورہ <span data-date="2026-11-03">منگل ۳ نومبر</span></p><div class="mt-1 flex flex-wrap items-center gap-3"><span data-testid="step-strip" class="flex items-center gap-1.5"><span data-dot="missing" aria-hidden="true" class="inline-block h-3.5 w-3.5 rounded-full border-[1.5px] rtl:-scale-x-100 border-cp-track bg-white"></span><span data-dot="missing" aria-hidden="true" class="inline-block h-3.5 w-3.5 rounded-full border-[1.5px] rtl:-scale-x-100 border-cp-track bg-white"></span><span data-dot="missing" aria-hidden="true" class="inline-block h-3.5 w-3.5 rounded-full border-[1.5px] rtl:-scale-x-100 border-cp-track bg-white"></span></span><span data-num="3" data-den="3" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="inline-flex min-h-[28px] items-center rounded-full px-3 text-[13px] font-semibold bg-cp-green-tint text-cp-green-ink"><span data-testid="step-chip" data-chip="to_come">۳ ریکارڈنگز باقی</span></span></div><div class="flex flex-col gap-1"><div class="flex flex-wrap items-center gap-2"><button type="button" data-testid="step-tick-yes" class="cp-press min-h-[44px] rounded-[12px] px-4 text-[14px] font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green disabled:opacity-60 border-2 border-cp-navy bg-white text-cp-navy">ہوا</button><button type="button" data-testid="step-tick-no" class="cp-press min-h-[44px] rounded-[12px] px-4 text-[14px] font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green disabled:opacity-60 border border-cp-hairline bg-white text-cp-ink-2">ابھی نہیں</button></div></div></li></ul><p data-testid="s1-steps-legend" class="pt-1 text-[13px] text-cp-ink-3">ہوا، ادھورا، نہیں ہوا</p></div></section><section data-testid="s1-not-yet" data-section="" class="mt-5 border-t border-cp-hairline pt-6 "><div class="flex items-start justify-between gap-3"><div class="min-w-0"><p class="cp-label text-[12px] font-bold uppercase leading-snug tracking-[0.08em] text-cp-ink-3">ابھی نہیں</p><p class="mt-1 text-[13px] leading-[1.45] text-cp-ink-3">ان کے کارڈ کے لیے ابھی مزید ریکارڈنگز چاہییں</p></div></div><div class="mt-2"><div data-testid="wrow-not-yet" data-w="W-WARM" data-state="not_yet" data-wrow="coach" class="flex w-full items-start gap-3 border-t border-cp-hairline py-3.5 text-start first:border-t-0 "><span class="flex min-w-0 flex-1 flex-col gap-1"><span class="text-[17px] font-semibold leading-[1.4] text-cp-ink">ابتدائی سرگرمی نہیں ہوئی</span><span class="text-[13px] leading-[1.45] text-cp-ink-3"><span class="block"><span data-num="12" data-den="20" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash">۲۰ میں سے ۱۲</span> اسباق جانچے گئے، <span data-nonum="">۲۰</span> ہونے پر کارڈ آئے گا</span><span data-num="2" data-den="3" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="block">درکار ۳ کوڈ میں سے ۲ میں نظر آیا</span><span class="block"><span data-window="w4-2026-09-28">۲۸ ستمبر تا ۲۵ اکتوبر</span></span></span></span></div></div></section><div data-testid="s1-phonics" data-status="ok"><section data-section="" class="mt-5 border-t border-cp-hairline pt-6 "><div class="flex items-start justify-between gap-3"><div class="min-w-0"><h2 class="text-[20px] font-bold leading-[1.3] text-cp-navy">حروف کی آوازوں کی جانچ</h2></div></div><div class="mt-2"><div class="flex flex-col gap-3 pt-1"><div data-testid="wcard-phonics" data-w="W-PHON" class="flex flex-col gap-3"><p class="cp-eyebrow text-[12px] font-bold uppercase leading-snug tracking-[0.08em] text-cp-green-ink ">دیکھیں، <span data-nonum="">۱ میں سے ۱ قدم</span></p><div class="grid items-start gap-x-4 gap-y-1 grid-cols-[minmax(0,1fr)_auto] "><span data-num="17" data-den="49" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="contents"><span class="col-start-1 row-start-1 self-end text-[18px] font-bold leading-tight text-cp-navy">۴۹ میں سے </span><span data-ring="card" class="relative inline-flex shrink-0 items-center justify-center col-start-2 row-span-2 row-start-1 self-start" style="width: 64px; height: 64px;"><svg width="64" height="64" viewBox="0 0 64 64" aria-hidden="true" class="absolute inset-0"><circle cx="32" cy="32" r="28.5" fill="none" stroke-width="7" style="stroke: var(--cp-ring-track);"></circle><circle data-arc="" class="cp-ring__arc" cx="32" cy="32" r="28.5" fill="none" stroke-width="7" stroke-linecap="round" stroke-dasharray="62.13 179.07" transform="rotate(-90 32 32)" style="stroke: var(--cp-green); --cp-arc-len: 62.13;"></circle></svg><span class="cp-ring__n font-extrabold text-[24px] leading-none">۱۷</span></span></span><div class="col-start-1 row-start-2 min-w-0"><p class="text-[15px] leading-[1.45] text-cp-ink">جن اسباق کے منصوبے میں خود مشق شامل تھی، ان میں مشق سے پہلے ہی وقت ختم ہو گیا۔</p></div></div><p class="text-[13px] leading-[1.45] text-cp-ink-2"><span data-stat="median" data-base="17" data-win="w4-2026-09-28">وقت ختم ہونے والے اسباق میں، وسط کے حساب سے، وضاحت منصوبے سے کوئی ۶ منٹ زیادہ چلی۔</span></p><p data-window="w4-2026-09-28" class="text-[13px] leading-[1.45] text-cp-ink-3">۲۸ ستمبر تا ۲۵ اکتوبر، سبق کے منصوبے پر عمل، نمبر دینے کا طریقہ ۲۸ ستمبر کو بدلا</p><a data-testid="wcard-phonics-where" class="-mx-1 flex min-h-[44px] items-center gap-2 rounded-xl px-1 outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green" href="/portal/coach/insights/w/W-PHON/where"><span class="min-w-0 flex-1 text-[17px] font-semibold leading-[1.4] text-cp-ink [&amp;_[data-code]]:inline-block [&amp;_[data-num]]:whitespace-nowrap">پہلے <span data-code="" dir="ltr" class="[unicode-bidi:isolate]">⁦Govt. Primary School Fictional-03⁩</span> (<span data-num="6" data-den="9" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash">۹ میں سے ۶</span>)، دورہ <span data-date="2026-10-28">بدھ ۲۸ اکتوبر</span><span class="block text-[13px] font-normal leading-[1.45] text-cp-ink-3 [&amp;_[data-code]]:inline-block [&amp;_[data-num]]:whitespace-nowrap">پھر <span data-code="" dir="ltr" class="[unicode-bidi:isolate]">⁦Govt. Primary School Fictional-05⁩</span>، <span data-code="" dir="ltr" class="[unicode-bidi:isolate]">⁦Govt. Primary School Fictional-06⁩</span></span></span><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right shrink-0 text-cp-ink-3 rtl:rotate-180" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></a><div class="flex flex-wrap gap-3"><a data-testid="wcard-phonics-listen" class="cp-press inline-flex items-center justify-center gap-2 whitespace-nowrap outline-none focus-visible:ring-[3px] focus-visible:ring-cp-navy focus-visible:ring-offset-2 disabled:opacity-50 border-2 border-cp-navy bg-white text-cp-navy min-h-[52px] rounded-[14px] px-5 text-[16px] font-bold  min-w-0 flex-1" href="/portal/coach/insights/w/W-PHON#moment"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-headphones shrink-0" aria-hidden="true"><path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"></path></svg><span>سنیں <span data-clock="">۰:۳۸</span></span></a><a data-testid="wcard-phonics-see" class="cp-press inline-flex items-center justify-center gap-2 whitespace-nowrap outline-none focus-visible:ring-[3px] focus-visible:ring-cp-navy focus-visible:ring-offset-2 disabled:opacity-50 border-2 border-cp-navy bg-white text-cp-navy min-h-[52px] rounded-[14px] px-5 text-[16px] font-bold  min-w-0 flex-1" href="/portal/coach/insights/w/W-PHON"><span>قدم دیکھیں</span></a></div></div><p data-num="9" data-den="14" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="text-[13px] leading-[1.45] text-cp-ink-3">پڑھائی کے گھنٹے کی ۱۴ میں سے ۹ ریکارڈنگز سنی گئیں</p></div></div></section></div><div class="mt-5 border-t border-cp-hairline pt-4"><a data-testid="s1-stats-link" class="flex min-h-[44px] items-center gap-1.5 text-[17px] font-semibold text-cp-green-ink outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green" href="/portal/coach/insights/stats">اوسط اعداد اور نتائج<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right rotate-180" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></a></div></div><div class="lg:hidden"><p data-testid="trust-line" class="px-1 pt-6 text-[13px] leading-[1.45] text-cp-ink-3">کوڈ، نام نہیں۔ کوچنگ کے لیے، جانچ پڑتال کے لیے نہیں۔</p></div></div></div></div></div></div></div></div>"`;

exports[`S1 This week > ur > phonics_paused: renders, keeps the count contract, no identity 1`] = `"<div data-testid="layout"><div data-testid="insights-this-week" data-cp-shell="" class="cp bg-cp-ground text-cp-ink  "><div class="lg:ps-[240px]"><div class="mx-auto w-full max-w-[640px] lg:px-16 lg:pt-9 lg:max-w-[848px]"><div class=" pb-4 md:max-lg:pb-[calc(80px+env(safe-area-inset-bottom))] lg:pb-16"><div class="min-w-0"><header data-testid="insights-band" class="cp-band"><div class="cp-lattice" aria-hidden="true"></div><div class="cp-band__top mb-2.5 flex min-h-[28px] items-center justify-between gap-3"><span class="cp-band__lockup flex items-center gap-2 text-[12px] font-extrabold tracking-[0.14em]" dir="ltr"><img src="/src/assets/niete-logo.png" alt="" class="block h-[22px] w-auto">NIETE</span><span class="flex items-center gap-2"><span class="cp-band__date text-[13px] font-semibold"><span data-testid="s1-today"><span data-date="2026-10-26">۲۶ اکتوبر</span></span></span></span></div><h1 class="cp-band__title text-[24px] font-extrabold leading-[1.2] tracking-[-0.01em] lg:text-[30px]">اس ہفتے</h1><div class="cp-band__body mt-3"><div class="flex flex-col gap-3"><div data-testid="wcard-hero" data-w="W-IP-TIME" class="flex flex-col gap-3"><p class="cp-eyebrow text-[12px] font-bold uppercase leading-snug tracking-[0.08em] text-cp-green-ink ">دیکھیں، <span data-nonum="">دو میں سے پہلا قدم</span></p><div class="grid items-start gap-x-4 gap-y-1 grid-cols-[minmax(0,1fr)_auto] "><span data-num="17" data-den="49" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="contents"><span class="col-start-1 row-start-1 self-end text-[22px] font-bold leading-tight">۴۹ میں سے </span><span data-ring="hero" class="relative inline-flex shrink-0 items-center justify-center col-start-2 row-span-2 row-start-1 self-start" style="width: 104px; height: 104px;"><svg width="104" height="104" viewBox="0 0 104 104" aria-hidden="true" class="absolute inset-0"><circle cx="52" cy="52" r="47" fill="none" stroke-width="10" style="stroke: var(--cp-ring-track);"></circle><circle data-arc="" class="cp-ring__arc" cx="52" cy="52" r="47" fill="none" stroke-width="10" stroke-linecap="round" stroke-dasharray="102.45 295.31" transform="rotate(-90 52 52)" style="stroke: var(--cp-green); --cp-arc-len: 102.45;"></circle></svg><span class="cp-ring__n font-extrabold cp-hero-n text-[52px] leading-none tracking-[-0.02em]">۱۷</span></span></span><div class="col-start-1 row-start-2 min-w-0"><p class="text-[17px] font-medium leading-[1.42]">جن اسباق کے منصوبے میں خود مشق شامل تھی، ان میں مشق سے پہلے ہی وقت ختم ہو گیا۔</p></div></div><p data-window="w4-2026-09-28" class="self-start rounded-full bg-cp-green px-3 py-[5px] text-[12px] font-semibold leading-[1.45] text-cp-navy">۲۸ ستمبر تا ۲۵ اکتوبر، سبق کے منصوبے پر عمل، نمبر دینے کا طریقہ ۲۸ ستمبر کو بدلا</p></div></div></div></header><div class="cp-enter flex flex-col px-5 pt-4 lg:px-0 lg:pt-2"><div class="flex flex-col pb-2"><section data-w="W-IP-TIME" data-testid="wcard" data-surface="" class="flex flex-col gap-3 rounded-[20px] bg-cp-surface p-5 shadow-[0_2px_8px_rgba(51,55,72,0.08)] lg:p-7 cp-overlap "><div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:gap-6"><div class="min-w-0 lg:flex-1"><a data-testid="wcard-where" class="-mx-1 flex min-h-[44px] items-center gap-2 rounded-xl px-1 outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green" href="/portal/coach/insights/w/W-IP-TIME/where"><span class="min-w-0 flex-1 text-[17px] font-semibold leading-[1.4] text-cp-ink [&amp;_[data-code]]:inline-block [&amp;_[data-num]]:whitespace-nowrap">پہلے <span data-code="" dir="ltr" class="[unicode-bidi:isolate]">⁦Govt. Primary School Fictional-03⁩</span> (<span data-num="6" data-den="9" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash">۹ میں سے ۶</span>)، دورہ <span data-date="2026-10-28">بدھ ۲۸ اکتوبر</span><span class="block text-[13px] font-normal leading-[1.45] text-cp-ink-3 [&amp;_[data-code]]:inline-block [&amp;_[data-num]]:whitespace-nowrap">پھر <span data-code="" dir="ltr" class="[unicode-bidi:isolate]">⁦Govt. Primary School Fictional-05⁩</span>، <span data-code="" dir="ltr" class="[unicode-bidi:isolate]">⁦Govt. Primary School Fictional-06⁩</span></span></span><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right shrink-0 text-cp-ink-3 rtl:rotate-180" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></a></div><div class="lg:w-[340px] lg:shrink-0"><div class="flex flex-wrap gap-3"><a data-testid="wcard-listen" class="cp-press inline-flex items-center justify-center gap-2 whitespace-nowrap outline-none focus-visible:ring-[3px] focus-visible:ring-cp-navy focus-visible:ring-offset-2 disabled:opacity-50 border-2 border-cp-navy bg-white text-cp-navy min-h-[52px] rounded-[14px] px-5 text-[16px] font-bold  min-w-0 flex-1" href="/portal/coach/insights/w/W-IP-TIME#moment"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-headphones shrink-0" aria-hidden="true"><path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"></path></svg><span>سنیں <span data-clock="">۰:۳۸</span></span></a><a data-testid="wcard-see" class="cp-press inline-flex items-center justify-center gap-2 whitespace-nowrap outline-none focus-visible:ring-[3px] focus-visible:ring-cp-navy focus-visible:ring-offset-2 disabled:opacity-50 bg-cp-green text-cp-navy min-h-[52px] rounded-[14px] px-5 text-[16px] font-bold  min-w-0 flex-1" href="/portal/coach/insights/w/W-IP-TIME"><span>قدم دیکھیں</span></a></div></div></div></section><div class="mt-4"><section data-testid="s1-note" data-note="00000000-0000-4000-8000-060000000001" class="flex flex-col gap-2 rounded-[16px] bg-cp-navy-tint px-4 py-3.5 text-cp-navy"><p class="flex flex-wrap items-baseline gap-x-2"><span class="cp-label text-[12px] font-bold uppercase tracking-[0.08em]">آپ کے آر ایم کی طرف سے</span><span class="text-[13px] font-semibold text-cp-ink-2"><span data-date="2026-10-30">جمعہ ۳۰ اکتوبر</span> تک</span></p><p data-text="note" class="text-[15px] leading-[1.45] text-cp-ink [overflow-wrap:anywhere]"><span data-line="1">اس مہینے «وقت ختم ہو گیا» سب سے زیادہ ⁦Govt. Primary School Fictional-03⁩ میں نظر آیا۔</span><span data-line="2"> براہِ کرم ۳۰ اکتوبر سے پہلے وہاں «ساتھی مشاہدہ، ایک نظر: وضاحت کس منٹ پر ختم ہوئی» چلائیں۔</span><span data-line="3"> لمحہ جمعے کے حلقے میں لائیں۔</span></p><div class="flex gap-2"><a data-testid="s1-note-open" class="cp-press flex min-h-[44px] flex-1 items-center justify-center rounded-[12px] px-3 text-[14px] font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green border-2 border-cp-navy bg-white text-cp-navy" href="/portal/coach/insights/w/W-IP-TIME">قدم کھولیں</a><button type="button" data-testid="s1-note-dismiss" class="cp-press flex min-h-[44px] flex-1 items-center justify-center rounded-[12px] px-3 text-[14px] font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green text-cp-ink-2">ہو گیا</button></div></section></div><div class="mt-2"><a data-testid="wrow" data-w="W-EXIT-NOPLAN" data-state="ranked" data-wrow="coach" class="flex w-full items-start gap-3 border-t border-cp-hairline py-3.5 text-start first:border-t-0  outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green" href="/portal/coach/insights/w/W-EXIT-NOPLAN"><span class="flex min-w-0 flex-1 flex-col gap-1"><span data-nonum="" class="cp-label text-[12px] font-bold uppercase tracking-[0.08em] text-cp-ink-3">دو میں سے دوسرا قدم</span><span class="text-[17px] font-semibold leading-[1.4] text-cp-ink">وقت تھا، آخر میں جانچ نہیں</span><span class="text-[15px] leading-[1.45] text-cp-ink-2">جن اسباق کے منصوبے میں اختتامی جانچ شامل تھی، ان میں وقت تھا مگر جانچ نہیں ہوئی۔</span><span class="mt-1 flex items-center gap-3"><span data-num="12" data-den="47" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="inline-flex items-baseline whitespace-pre shrink-0"><span class="text-[13px] font-semibold text-cp-ink-3">۴۷ میں سے </span><b class="text-[22px] font-extrabold leading-[1.1] tracking-[-0.01em] text-cp-navy">۱۲</b></span><span aria-hidden="true" data-bar="12/47" class="block h-1 overflow-hidden rounded-full bg-cp-track w-full max-w-[160px]"><span data-fill="" class="block h-full rounded-full bg-cp-green" style="width: 25.53191489361702%;"></span></span></span><span class="text-[13px] leading-[1.45] text-cp-ink-3">پہلے <span data-code="" dir="ltr" class="[unicode-bidi:isolate]">⁦Govt. Primary School Fictional-05⁩</span> (<span data-num="4" data-den="10" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash">۱۰ میں سے ۴</span>)، <span data-window="w4-2026-09-28">۲۸ ستمبر تا ۲۵ اکتوبر</span>، سبق کے منصوبے پر عمل</span></span><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right shrink-0 self-center text-cp-ink-3 rtl:rotate-180" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></a></div><p data-num="53" data-den="62" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="px-1 pt-3 text-[13px] leading-[1.45] text-cp-ink-3">۶۲ ریکارڈنگز میں سے ۵۳ کے ساتھ منصوبہ جُڑا تھا۔</p><section data-testid="s1-steps" data-section="" class="mt-5 border-t border-cp-hairline pt-6 "><div class="flex items-start justify-between gap-3"><div class="min-w-0"><p class="cp-label text-[12px] font-bold uppercase leading-snug tracking-[0.08em] text-cp-ink-3">جاری قدم</p><p class="mt-1 text-[13px] leading-[1.45] text-cp-ink-3">جو آپ نے طے کیے، اور اگلی تین ریکارڈنگز</p></div></div><div class="mt-2"><ul class="flex flex-col"><li data-testid="step-row" data-step="00000000-0000-4000-8000-05000000001f" class="flex flex-col gap-1.5 border-t border-cp-hairline py-4 first:border-t-0 first:pt-2"><p data-text="library" class="text-[17px] font-semibold leading-[1.4] text-cp-ink">سبق سے پہلے ایک بچے کو وقت کا نگران بنائیں، تین نشان (۱۰، ۱۷، ۲۵) دیں؛ آواز پر مرحلہ بدلیں</p><p data-testid="step-sub" class="text-[13px] leading-[1.45] text-cp-ink-3 [overflow-wrap:anywhere]"><span data-code="" dir="ltr" class="[unicode-bidi:isolate]">⁦T-31، Govt. Primary School Fictional-06⁩</span>، طے <span data-date="2026-10-07">۷ اکتوبر</span>، جانچ <span data-date="2026-10-21">بدھ ۲۱ اکتوبر</span> تک</p><div class="mt-1 flex flex-wrap items-center gap-3"><span data-testid="step-strip" class="flex items-center gap-1.5"><span data-dot="done" role="img" aria-label="ہوا" class="inline-block h-3.5 w-3.5 rounded-full border-[1.5px] rtl:-scale-x-100 border-cp-green bg-cp-green"></span><span data-dot="done" role="img" aria-label="ہوا" class="inline-block h-3.5 w-3.5 rounded-full border-[1.5px] rtl:-scale-x-100 border-cp-green bg-cp-green"></span><span data-dot="not_done" role="img" aria-label="نہیں ہوا" class="inline-block h-3.5 w-3.5 rounded-full border-[1.5px] rtl:-scale-x-100 border-cp-navy bg-white"></span></span><span data-testid="step-chip" data-chip="worked" class="inline-flex min-h-[28px] items-center rounded-full px-3 text-[13px] font-semibold bg-cp-green text-cp-navy">کامیاب</span></div><div class="flex flex-col gap-1"><div class="flex flex-wrap items-center gap-2"><button type="button" data-testid="step-tick-yes" class="cp-press min-h-[44px] rounded-[12px] px-4 text-[14px] font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green disabled:opacity-60 border-2 border-cp-navy bg-white text-cp-navy">ہوا</button><button type="button" data-testid="step-tick-no" class="cp-press min-h-[44px] rounded-[12px] px-4 text-[14px] font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green disabled:opacity-60 border border-cp-hairline bg-white text-cp-ink-2">ابھی نہیں</button></div></div></li><li data-testid="step-row" data-step="00000000-0000-4000-8000-050000000007" class="flex flex-col gap-1.5 border-t border-cp-hairline py-4 first:border-t-0 first:pt-2"><p data-text="library" class="text-[17px] font-semibold leading-[1.4] text-cp-ink">پندرہویں منٹ پر منصوبے کی مشق والی سطر پڑھیں، وقت بتائیں، آٹھ منٹ قطاروں میں چلیں</p><p data-testid="step-sub" class="text-[13px] leading-[1.45] text-cp-ink-3 [overflow-wrap:anywhere]"><span data-code="" dir="ltr" class="[unicode-bidi:isolate]">⁦T-07، Govt. Primary School Fictional-03⁩</span>، طے <span data-date="2026-10-14">۱۴ اکتوبر</span>، جانچ: دورہ <span data-date="2026-10-28">بدھ ۲۸ اکتوبر</span></p><div class="mt-1 flex flex-wrap items-center gap-3"><span data-testid="step-strip" class="flex items-center gap-1.5"><span data-dot="done" role="img" aria-label="ہوا" class="inline-block h-3.5 w-3.5 rounded-full border-[1.5px] rtl:-scale-x-100 border-cp-green bg-cp-green"></span><span data-dot="partial" role="img" aria-label="ادھورا" class="inline-block h-3.5 w-3.5 rounded-full border-[1.5px] rtl:-scale-x-100 border-cp-green bg-[linear-gradient(90deg,var(--cp-green)_50%,white_50%)]"></span><span data-dot="missing" aria-hidden="true" class="inline-block h-3.5 w-3.5 rounded-full border-[1.5px] rtl:-scale-x-100 border-cp-track bg-white"></span></span><span data-num="1" data-den="3" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="inline-flex min-h-[28px] items-center rounded-full px-3 text-[13px] font-semibold bg-cp-green-tint text-cp-green-ink"><span data-testid="step-chip" data-chip="to_come">۱ ریکارڈنگ باقی</span></span></div><div class="flex flex-col gap-1"><div class="flex flex-wrap items-center gap-2"><button type="button" data-testid="step-tick-yes" class="cp-press min-h-[44px] rounded-[12px] px-4 text-[14px] font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green disabled:opacity-60 border-2 border-cp-navy bg-white text-cp-navy">ہوا</button><button type="button" data-testid="step-tick-no" class="cp-press min-h-[44px] rounded-[12px] px-4 text-[14px] font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green disabled:opacity-60 border border-cp-hairline bg-white text-cp-ink-2">ابھی نہیں</button></div></div></li><li data-testid="step-row" data-step="00000000-0000-4000-8000-050000000013" class="flex flex-col gap-1.5 border-t border-cp-hairline py-4 first:border-t-0 first:pt-2"><p data-text="library" class="text-[17px] font-semibold leading-[1.4] text-cp-ink">بائیسویں منٹ پر اختتامی سوال پوچھیں اور پانچ سلیٹیں پڑھ کر بتائیں کہ کیا ٹھیک تھا</p><p data-testid="step-sub" class="text-[13px] leading-[1.45] text-cp-ink-3 [overflow-wrap:anywhere]"><span data-code="" dir="ltr" class="[unicode-bidi:isolate]">⁦T-19، Govt. Primary School Fictional-05⁩</span>، طے <span data-date="2026-10-20">۲۰ اکتوبر</span>، جانچ: دورہ <span data-date="2026-11-03">منگل ۳ نومبر</span></p><div class="mt-1 flex flex-wrap items-center gap-3"><span data-testid="step-strip" class="flex items-center gap-1.5"><span data-dot="missing" aria-hidden="true" class="inline-block h-3.5 w-3.5 rounded-full border-[1.5px] rtl:-scale-x-100 border-cp-track bg-white"></span><span data-dot="missing" aria-hidden="true" class="inline-block h-3.5 w-3.5 rounded-full border-[1.5px] rtl:-scale-x-100 border-cp-track bg-white"></span><span data-dot="missing" aria-hidden="true" class="inline-block h-3.5 w-3.5 rounded-full border-[1.5px] rtl:-scale-x-100 border-cp-track bg-white"></span></span><span data-num="3" data-den="3" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="inline-flex min-h-[28px] items-center rounded-full px-3 text-[13px] font-semibold bg-cp-green-tint text-cp-green-ink"><span data-testid="step-chip" data-chip="to_come">۳ ریکارڈنگز باقی</span></span></div><div class="flex flex-col gap-1"><div class="flex flex-wrap items-center gap-2"><button type="button" data-testid="step-tick-yes" class="cp-press min-h-[44px] rounded-[12px] px-4 text-[14px] font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green disabled:opacity-60 border-2 border-cp-navy bg-white text-cp-navy">ہوا</button><button type="button" data-testid="step-tick-no" class="cp-press min-h-[44px] rounded-[12px] px-4 text-[14px] font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green disabled:opacity-60 border border-cp-hairline bg-white text-cp-ink-2">ابھی نہیں</button></div></div></li></ul><p data-testid="s1-steps-legend" class="pt-1 text-[13px] text-cp-ink-3">ہوا، ادھورا، نہیں ہوا</p></div></section><section data-testid="s1-not-yet" data-section="" class="mt-5 border-t border-cp-hairline pt-6 "><div class="flex items-start justify-between gap-3"><div class="min-w-0"><p class="cp-label text-[12px] font-bold uppercase leading-snug tracking-[0.08em] text-cp-ink-3">ابھی نہیں</p><p class="mt-1 text-[13px] leading-[1.45] text-cp-ink-3">ان کے کارڈ کے لیے ابھی مزید ریکارڈنگز چاہییں</p></div></div><div class="mt-2"><div data-testid="wrow-not-yet" data-w="W-WARM" data-state="not_yet" data-wrow="coach" class="flex w-full items-start gap-3 border-t border-cp-hairline py-3.5 text-start first:border-t-0 "><span class="flex min-w-0 flex-1 flex-col gap-1"><span class="text-[17px] font-semibold leading-[1.4] text-cp-ink">ابتدائی سرگرمی نہیں ہوئی</span><span class="text-[13px] leading-[1.45] text-cp-ink-3"><span class="block"><span data-num="12" data-den="20" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash">۲۰ میں سے ۱۲</span> اسباق جانچے گئے، <span data-nonum="">۲۰</span> ہونے پر کارڈ آئے گا</span><span data-num="2" data-den="3" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="block">درکار ۳ کوڈ میں سے ۲ میں نظر آیا</span><span class="block"><span data-window="w4-2026-09-28">۲۸ ستمبر تا ۲۵ اکتوبر</span></span></span></span></div></div></section><div data-testid="s1-phonics" data-status="paused"><section data-section="" class="mt-5 border-t border-cp-hairline pt-6 "><div class="flex items-start justify-between gap-3"><div class="min-w-0"><h2 class="text-[20px] font-bold leading-[1.3] text-cp-navy">حروف کی آوازوں کی جانچ</h2></div></div><div class="mt-2"><p class="text-[15px] leading-[1.45] text-cp-ink-2">ایک شخص کی پڑتال کے لیے روکی گئی ہے۔ منظوری کے بعد گنتی واپس آئے گی۔</p></div></section></div><div class="mt-5 border-t border-cp-hairline pt-4"><a data-testid="s1-stats-link" class="flex min-h-[44px] items-center gap-1.5 text-[17px] font-semibold text-cp-green-ink outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green" href="/portal/coach/insights/stats">اوسط اعداد اور نتائج<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right rotate-180" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></a></div></div><div class="lg:hidden"><p data-testid="trust-line" class="px-1 pt-6 text-[13px] leading-[1.45] text-cp-ink-3">کوڈ، نام نہیں۔ کوچنگ کے لیے، جانچ پڑتال کے لیے نہیں۔</p></div></div></div></div></div></div></div></div>"`;

exports[`S1 This week > ur > stale: renders, keeps the count contract, no identity 1`] = `"<div data-testid="layout"><div data-testid="insights-this-week" data-cp-shell="" class="cp bg-cp-ground text-cp-ink  "><div class="lg:ps-[240px]"><div class="mx-auto w-full max-w-[640px] lg:px-16 lg:pt-9 lg:max-w-[848px]"><div class=" pb-4 md:max-lg:pb-[calc(80px+env(safe-area-inset-bottom))] lg:pb-16"><div class="min-w-0"><header data-testid="insights-band" class="cp-band"><div class="cp-lattice" aria-hidden="true"></div><div class="cp-band__top mb-2.5 flex min-h-[28px] items-center justify-between gap-3"><span class="cp-band__lockup flex items-center gap-2 text-[12px] font-extrabold tracking-[0.14em]" dir="ltr"><img src="/src/assets/niete-logo.png" alt="" class="block h-[22px] w-auto">NIETE</span><span class="flex items-center gap-2"><span class="cp-band__date text-[13px] font-semibold"><span data-testid="s1-today"><span data-date="2026-10-26">۲۶ اکتوبر</span></span></span></span></div><h1 class="cp-band__title text-[24px] font-extrabold leading-[1.2] tracking-[-0.01em] lg:text-[30px]">اس ہفتے</h1><div class="cp-band__body mt-3"><div class="flex flex-col gap-3"><div data-testid="wcard-hero" data-w="W-IP-TIME" class="flex flex-col gap-3"><p class="cp-eyebrow text-[12px] font-bold uppercase leading-snug tracking-[0.08em] text-cp-green-ink ">دیکھیں، <span data-nonum="">دو میں سے پہلا قدم</span></p><div class="grid items-start gap-x-4 gap-y-1 grid-cols-[minmax(0,1fr)_auto] "><span data-num="16" data-den="46" data-win="w4-2026-09-21" data-grader="google/gemini-3.8-flash" class="contents"><span class="col-start-1 row-start-1 self-end text-[22px] font-bold leading-tight">۴۶ میں سے </span><span data-ring="hero" class="relative inline-flex shrink-0 items-center justify-center col-start-2 row-span-2 row-start-1 self-start" style="width: 104px; height: 104px;"><svg width="104" height="104" viewBox="0 0 104 104" aria-hidden="true" class="absolute inset-0"><circle cx="52" cy="52" r="47" fill="none" stroke-width="10" style="stroke: var(--cp-ring-track);"></circle><circle data-arc="" class="cp-ring__arc" cx="52" cy="52" r="47" fill="none" stroke-width="10" stroke-linecap="round" stroke-dasharray="102.72 295.31" transform="rotate(-90 52 52)" style="stroke: var(--cp-green); --cp-arc-len: 102.72;"></circle></svg><span class="cp-ring__n font-extrabold cp-hero-n text-[52px] leading-none tracking-[-0.02em]">۱۶</span></span></span><div class="col-start-1 row-start-2 min-w-0"><p class="text-[17px] font-medium leading-[1.42]">جن اسباق کے منصوبے میں خود مشق شامل تھی، ان میں مشق سے پہلے ہی وقت ختم ہو گیا۔</p></div></div><p data-window="w4-2026-09-21" class="self-start rounded-full bg-cp-green px-3 py-[5px] text-[12px] font-semibold leading-[1.45] text-cp-navy">۲۱ ستمبر تا ۱۸ اکتوبر، سبق کے منصوبے پر عمل، نمبر دینے کا طریقہ ۲۸ ستمبر کو بدلا</p></div><p data-testid="s1-stale" role="status" class="cp-on-band-2 text-[13px] leading-[1.45]">گزشتہ رات کا تجزیہ نہیں چلا۔ <span data-date="2026-10-24">ہفتہ ۲۴ اکتوبر</span> تک کے قدم دکھائے جا رہے ہیں۔</p></div></div></header><div class="cp-enter flex flex-col px-5 pt-4 lg:px-0 lg:pt-2"><div class="flex flex-col pb-2"><section data-w="W-IP-TIME" data-testid="wcard" data-surface="" class="flex flex-col gap-3 rounded-[20px] bg-cp-surface p-5 shadow-[0_2px_8px_rgba(51,55,72,0.08)] lg:p-7 cp-overlap "><div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:gap-6"><div class="min-w-0 lg:flex-1"><a data-testid="wcard-where" class="-mx-1 flex min-h-[44px] items-center gap-2 rounded-xl px-1 outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green" href="/portal/coach/insights/w/W-IP-TIME/where"><span class="min-w-0 flex-1 text-[17px] font-semibold leading-[1.4] text-cp-ink [&amp;_[data-code]]:inline-block [&amp;_[data-num]]:whitespace-nowrap">پہلے <span data-code="" dir="ltr" class="[unicode-bidi:isolate]">⁦Govt. Primary School Fictional-03⁩</span> (<span data-num="5" data-den="8" data-win="w4-2026-09-21" data-grader="google/gemini-3.8-flash">۸ میں سے ۵</span>)، دورہ <span data-date="2026-10-28">بدھ ۲۸ اکتوبر</span><span class="block text-[13px] font-normal leading-[1.45] text-cp-ink-3 [&amp;_[data-code]]:inline-block [&amp;_[data-num]]:whitespace-nowrap">پھر <span data-code="" dir="ltr" class="[unicode-bidi:isolate]">⁦Govt. Primary School Fictional-05⁩</span>، <span data-code="" dir="ltr" class="[unicode-bidi:isolate]">⁦Govt. Primary School Fictional-06⁩</span></span></span><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right shrink-0 text-cp-ink-3 rtl:rotate-180" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></a></div><div class="lg:w-[340px] lg:shrink-0"><div class="flex flex-wrap gap-3"><a data-testid="wcard-listen" class="cp-press inline-flex items-center justify-center gap-2 whitespace-nowrap outline-none focus-visible:ring-[3px] focus-visible:ring-cp-navy focus-visible:ring-offset-2 disabled:opacity-50 border-2 border-cp-navy bg-white text-cp-navy min-h-[52px] rounded-[14px] px-5 text-[16px] font-bold  min-w-0 flex-1" href="/portal/coach/insights/w/W-IP-TIME#moment"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-headphones shrink-0" aria-hidden="true"><path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"></path></svg><span>سنیں <span data-clock="">۰:۳۸</span></span></a><a data-testid="wcard-see" class="cp-press inline-flex items-center justify-center gap-2 whitespace-nowrap outline-none focus-visible:ring-[3px] focus-visible:ring-cp-navy focus-visible:ring-offset-2 disabled:opacity-50 bg-cp-green text-cp-navy min-h-[52px] rounded-[14px] px-5 text-[16px] font-bold  min-w-0 flex-1" href="/portal/coach/insights/w/W-IP-TIME"><span>قدم دیکھیں</span></a></div></div></div></section><div class="mt-4"><section data-testid="s1-note" data-note="00000000-0000-4000-8000-060000000001" class="flex flex-col gap-2 rounded-[16px] bg-cp-navy-tint px-4 py-3.5 text-cp-navy"><p class="flex flex-wrap items-baseline gap-x-2"><span class="cp-label text-[12px] font-bold uppercase tracking-[0.08em]">آپ کے آر ایم کی طرف سے</span><span class="text-[13px] font-semibold text-cp-ink-2"><span data-date="2026-10-30">جمعہ ۳۰ اکتوبر</span> تک</span></p><p data-text="note" class="text-[15px] leading-[1.45] text-cp-ink [overflow-wrap:anywhere]"><span data-line="1">اس مہینے «وقت ختم ہو گیا» سب سے زیادہ ⁦Govt. Primary School Fictional-03⁩ میں نظر آیا۔</span><span data-line="2"> براہِ کرم ۳۰ اکتوبر سے پہلے وہاں «ساتھی مشاہدہ، ایک نظر: وضاحت کس منٹ پر ختم ہوئی» چلائیں۔</span><span data-line="3"> لمحہ جمعے کے حلقے میں لائیں۔</span></p><div class="flex gap-2"><a data-testid="s1-note-open" class="cp-press flex min-h-[44px] flex-1 items-center justify-center rounded-[12px] px-3 text-[14px] font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green border-2 border-cp-navy bg-white text-cp-navy" href="/portal/coach/insights/w/W-IP-TIME">قدم کھولیں</a><button type="button" data-testid="s1-note-dismiss" class="cp-press flex min-h-[44px] flex-1 items-center justify-center rounded-[12px] px-3 text-[14px] font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green text-cp-ink-2">ہو گیا</button></div></section></div><div class="mt-2"><a data-testid="wrow" data-w="W-EXIT-NOPLAN" data-state="ranked" data-wrow="coach" class="flex w-full items-start gap-3 border-t border-cp-hairline py-3.5 text-start first:border-t-0  outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green" href="/portal/coach/insights/w/W-EXIT-NOPLAN"><span class="flex min-w-0 flex-1 flex-col gap-1"><span data-nonum="" class="cp-label text-[12px] font-bold uppercase tracking-[0.08em] text-cp-ink-3">دو میں سے دوسرا قدم</span><span class="text-[17px] font-semibold leading-[1.4] text-cp-ink">وقت تھا، آخر میں جانچ نہیں</span><span class="text-[15px] leading-[1.45] text-cp-ink-2">جن اسباق کے منصوبے میں اختتامی جانچ شامل تھی، ان میں وقت تھا مگر جانچ نہیں ہوئی۔</span><span class="mt-1 flex items-center gap-3"><span data-num="11" data-den="44" data-win="w4-2026-09-21" data-grader="google/gemini-3.8-flash" class="inline-flex items-baseline whitespace-pre shrink-0"><span class="text-[13px] font-semibold text-cp-ink-3">۴۴ میں سے </span><b class="text-[22px] font-extrabold leading-[1.1] tracking-[-0.01em] text-cp-navy">۱۱</b></span><span aria-hidden="true" data-bar="11/44" class="block h-1 overflow-hidden rounded-full bg-cp-track w-full max-w-[160px]"><span data-fill="" class="block h-full rounded-full bg-cp-green" style="width: 25%;"></span></span></span><span class="text-[13px] leading-[1.45] text-cp-ink-3">پہلے <span data-code="" dir="ltr" class="[unicode-bidi:isolate]">⁦Govt. Primary School Fictional-05⁩</span> (<span data-num="4" data-den="9" data-win="w4-2026-09-21" data-grader="google/gemini-3.8-flash">۹ میں سے ۴</span>)، <span data-window="w4-2026-09-21">۲۱ ستمبر تا ۱۸ اکتوبر</span>، سبق کے منصوبے پر عمل</span></span><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right shrink-0 self-center text-cp-ink-3 rtl:rotate-180" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></a></div><p data-num="50" data-den="58" data-win="w4-2026-09-21" data-grader="google/gemini-3.8-flash" class="px-1 pt-3 text-[13px] leading-[1.45] text-cp-ink-3">۵۸ ریکارڈنگز میں سے ۵۰ کے ساتھ منصوبہ جُڑا تھا۔</p><section data-testid="s1-steps" data-section="" class="mt-5 border-t border-cp-hairline pt-6 "><div class="flex items-start justify-between gap-3"><div class="min-w-0"><p class="cp-label text-[12px] font-bold uppercase leading-snug tracking-[0.08em] text-cp-ink-3">جاری قدم</p><p class="mt-1 text-[13px] leading-[1.45] text-cp-ink-3">جو آپ نے طے کیے، اور اگلی تین ریکارڈنگز</p></div></div><div class="mt-2"><ul class="flex flex-col"><li data-testid="step-row" data-step="00000000-0000-4000-8000-05000000001f" class="flex flex-col gap-1.5 border-t border-cp-hairline py-4 first:border-t-0 first:pt-2"><p data-text="library" class="text-[17px] font-semibold leading-[1.4] text-cp-ink">سبق سے پہلے ایک بچے کو وقت کا نگران بنائیں، تین نشان (۱۰، ۱۷، ۲۵) دیں؛ آواز پر مرحلہ بدلیں</p><p data-testid="step-sub" class="text-[13px] leading-[1.45] text-cp-ink-3 [overflow-wrap:anywhere]"><span data-code="" dir="ltr" class="[unicode-bidi:isolate]">⁦T-31، Govt. Primary School Fictional-06⁩</span>، طے <span data-date="2026-10-07">۷ اکتوبر</span>، جانچ <span data-date="2026-10-21">بدھ ۲۱ اکتوبر</span> تک</p><div class="mt-1 flex flex-wrap items-center gap-3"><span data-testid="step-strip" class="flex items-center gap-1.5"><span data-dot="done" role="img" aria-label="ہوا" class="inline-block h-3.5 w-3.5 rounded-full border-[1.5px] rtl:-scale-x-100 border-cp-green bg-cp-green"></span><span data-dot="done" role="img" aria-label="ہوا" class="inline-block h-3.5 w-3.5 rounded-full border-[1.5px] rtl:-scale-x-100 border-cp-green bg-cp-green"></span><span data-dot="not_done" role="img" aria-label="نہیں ہوا" class="inline-block h-3.5 w-3.5 rounded-full border-[1.5px] rtl:-scale-x-100 border-cp-navy bg-white"></span></span><span data-testid="step-chip" data-chip="worked" class="inline-flex min-h-[28px] items-center rounded-full px-3 text-[13px] font-semibold bg-cp-green text-cp-navy">کامیاب</span></div><div class="flex flex-col gap-1"><div class="flex flex-wrap items-center gap-2"><button type="button" data-testid="step-tick-yes" class="cp-press min-h-[44px] rounded-[12px] px-4 text-[14px] font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green disabled:opacity-60 border-2 border-cp-navy bg-white text-cp-navy">ہوا</button><button type="button" data-testid="step-tick-no" class="cp-press min-h-[44px] rounded-[12px] px-4 text-[14px] font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green disabled:opacity-60 border border-cp-hairline bg-white text-cp-ink-2">ابھی نہیں</button></div></div></li><li data-testid="step-row" data-step="00000000-0000-4000-8000-050000000007" class="flex flex-col gap-1.5 border-t border-cp-hairline py-4 first:border-t-0 first:pt-2"><p data-text="library" class="text-[17px] font-semibold leading-[1.4] text-cp-ink">پندرہویں منٹ پر منصوبے کی مشق والی سطر پڑھیں، وقت بتائیں، آٹھ منٹ قطاروں میں چلیں</p><p data-testid="step-sub" class="text-[13px] leading-[1.45] text-cp-ink-3 [overflow-wrap:anywhere]"><span data-code="" dir="ltr" class="[unicode-bidi:isolate]">⁦T-07، Govt. Primary School Fictional-03⁩</span>، طے <span data-date="2026-10-14">۱۴ اکتوبر</span>، جانچ: دورہ <span data-date="2026-10-28">بدھ ۲۸ اکتوبر</span></p><div class="mt-1 flex flex-wrap items-center gap-3"><span data-testid="step-strip" class="flex items-center gap-1.5"><span data-dot="done" role="img" aria-label="ہوا" class="inline-block h-3.5 w-3.5 rounded-full border-[1.5px] rtl:-scale-x-100 border-cp-green bg-cp-green"></span><span data-dot="partial" role="img" aria-label="ادھورا" class="inline-block h-3.5 w-3.5 rounded-full border-[1.5px] rtl:-scale-x-100 border-cp-green bg-[linear-gradient(90deg,var(--cp-green)_50%,white_50%)]"></span><span data-dot="missing" aria-hidden="true" class="inline-block h-3.5 w-3.5 rounded-full border-[1.5px] rtl:-scale-x-100 border-cp-track bg-white"></span></span><span data-num="1" data-den="3" data-win="w4-2026-09-21" data-grader="google/gemini-3.8-flash" class="inline-flex min-h-[28px] items-center rounded-full px-3 text-[13px] font-semibold bg-cp-green-tint text-cp-green-ink"><span data-testid="step-chip" data-chip="to_come">۱ ریکارڈنگ باقی</span></span></div><div class="flex flex-c