exports[`S1 This week > en > failed: renders, keeps the count contract, no identity 1`] = `"<div data-testid="layout"><div data-testid="insights-this-week" class="mx-auto flex w-full max-w-xl flex-col text-[#1d2025]"><header class="flex flex-col gap-3 px-1 pb-1.5 pt-6"><div class="flex items-center gap-3"><h1 class="min-w-0 flex-1 break-words text-[32px] font-light leading-[1.15] tracking-[-0.015em] [overflow-wrap:anywhere]">This week</h1></div><div class="flex flex-wrap gap-2"><span data-testid="s1-today" class="inline-flex h-[30px] items-center gap-1.5 rounded-full border border-[#e5e7eb] bg-white px-3 text-[13px] font-semibold text-[#4b5563]"><span data-date="2026-10-26">Mon 26 Oct</span></span></div></header><div class="flex flex-col gap-2.5 pb-4 pt-3"><div class="flex flex-col gap-3 pb-2"><div data-testid="s1-empty" data-status="failed"><div role="status" class="rounded-2xl border border-[#e5e7eb] bg-white px-4 py-3.5 text-[15px] leading-snug text-[#374151]"><p><span data-nonum="">The analysis has not run for 7 days. Your open steps still show. Ask your RM.</span></p><p data-window="w4-2026-09-28" class="mt-1.5 text-[12.5px] leading-snug text-[#6b7280]">28 Sep to 25 Oct · lesson-plan fidelity · scoring changed 28 Sep</p></div></div><p data-num="11" data-den="17" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="px-1 text-[13.5px] leading-snug text-[#6b7280]">Of 17 recordings, 11 had a linked plan.</p><section data-testid="s1-steps" class="flex flex-col rounded-2xl border border-[#e5e7eb] bg-white px-4 pt-3.5 pb-2"><h2 class="text-[17px] font-semibold text-[#1d2025]">Open steps</h2><p class="text-[13.5px] leading-snug text-[#6b7280]">What you set, and the next three recordings</p><ul class="flex flex-col"><li data-testid="step-row" data-step="00000000-0000-4000-8000-050000000321" class="flex flex-col gap-1.5 border-b border-[#f3f4f6] py-3 last:border-b-0"><p data-text="library" class="text-[15.5px] font-semibold leading-snug text-[#1d2025]">Name a child timekeeper with the three marks (10, 17, 25) before the lesson; change step when they call</p><p class="text-[13px] leading-snug text-[#6b7280] [overflow-wrap:anywhere]"><span data-code="" class="[unicode-bidi:isolate]">T-04</span> · <span data-code="" class="[unicode-bidi:isolate]">Govt. Primary School Fictional-52</span> · set <span data-date="2026-10-19">19 Oct</span> · check: visit <span data-date="2026-11-02">Mon 2 Nov</span></p><div class="flex flex-wrap items-center gap-2.5"><span data-testid="step-strip" class="flex items-center gap-1.5"><span data-dot="partial" role="img" aria-label="partial" class="inline-block h-[18px] w-[18px] rounded-full border-2 rtl:-scale-x-100" style="border-color: rgb(79, 70, 229); background: linear-gradient(90deg, #4f46e5 50%, transparent 50%);"></span><span data-dot="missing" aria-hidden="true" class="inline-block h-[18px] w-[18px] rounded-full border-2 rtl:-scale-x-100" style="border-color: rgb(209, 213, 219); background: transparent;"></span><span data-dot="missing" aria-hidden="true" class="inline-block h-[18px] w-[18px] rounded-full border-2 rtl:-scale-x-100" style="border-color: rgb(209, 213, 219); background: transparent;"></span></span><span data-num="2" data-den="3" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="inline-flex min-h-[28px] items-center rounded-full px-2.5 text-[13px] font-semibold bg-[#eef2ff] text-[#312e81]"><span data-testid="step-chip" data-chip="to_come">2 recordings to come</span></span></div></li></ul><p data-testid="s1-steps-legend" class="pb-1.5 text-[12.5px] text-[#6b7280]">done · partial · not done</p></section><section data-testid="s1-phonics" data-status="testing" class="flex flex-col gap-2 rounded-2xl border border-[#e5e7eb] bg-white px-4 py-3.5"><h2 class="text-[16px] font-semibold text-[#1d2025]">Phonics check</h2><p data-nonum="" class="text-[14.5px] leading-snug text-[#374151]">Being tested against a human read of 30 reading hours. It starts when the two agree. 12 of 30 read.</p></section><a data-testid="s1-stats-link" class="flex min-h-[48px] w-full items-center justify-center rounded-2xl border border-[#d1d5db] bg-white px-4 text-[16px] font-semibold text-[#1d2025]" href="/portal/coach/insights/stats">Average stats and results ›</a></div><p data-testid="trust-line" class="px-1 pt-2 text-center text-[12.5px] text-[#6b7280]">Codes, never names. For coaching, never for evaluation.</p></div></div></div>"`;

