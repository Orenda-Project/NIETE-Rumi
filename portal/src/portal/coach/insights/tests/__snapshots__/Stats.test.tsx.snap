exports[`S6 Stats (en) > first window: the opening line, rows in payload order, no pill 1`] = `"<div data-testid="layout"><div data-testid="insights-stats" class="mx-auto flex w-full max-w-xl flex-col text-[#1d2025]"><header class="flex flex-col gap-3 px-1 pb-1.5 pt-6"><div class="flex items-center gap-3"><h1 class="min-w-0 flex-1 break-words text-[32px] font-light leading-[1.15] tracking-[-0.015em] [overflow-wrap:anywhere]">Stats</h1></div></header><div class="flex flex-col gap-2.5 pb-4 pt-3"><p data-window="w4-2026-09-28" class="px-1 text-[12.5px] leading-snug text-[#6b7280]">28 Sep to 25 Oct · lesson-plan fidelity · scoring changed 28 Sep</p><div role="status" data-testid="s6-opening" class="rounded-2xl bg-[#eef2ff] px-4 py-3.5 text-[15px] leading-snug text-[#312e81]"><p class="text-[11.5px] font-bold uppercase tracking-[0.08em] text-[#47BA7D] rtl:tracking-normal">NOTICE</p><p class="pt-1">Scoring changed on <span data-date="2026-09-28">28 Sep</span>. The first month-on-month line appears after <span data-date="2026-11-22">22 Nov</span>; this window's counts are below.</p></div><section data-testid="s6-rows" class="overflow-hidden rounded-2xl border border-[#e5e7eb] bg-white"><div class="flex items-end justify-end gap-3 px-4 pb-1 pt-3 text-end text-[11.5px] font-semibold text-[#6b7280]"><span data-testid="s6-col-now" class="w-[72px]">this window</span></div><ul><li data-testid="s6-row" data-w="W-IP" data-status="ok" class="flex items-start gap-3 border-t border-[#f0f1f3] px-4 py-3 first:border-t-0"><span class="flex min-w-0 flex-1 flex-col gap-0.5"><span class="text-[15px] font-semibold leading-snug text-[#1d2025]">No independent practice</span><span class="text-[13.5px] leading-snug text-[#374151]">lessons whose plan asked for independent practice had none.</span></span><span class="flex shrink-0 gap-3 text-end"><span data-num="22" data-den="49" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="w-[72px] text-[15px] font-bold text-[#1d2025]">22 of 49</span></span></li><li data-testid="s6-row" data-w="W-IP-TIME" data-status="ok" class="flex items-start gap-3 border-t border-[#f0f1f3] px-4 py-3 first:border-t-0"><span class="flex min-w-0 flex-1 flex-col gap-0.5"><span class="text-[15px] font-semibold leading-snug text-[#1d2025]">Ran out of time</span><span class="text-[13.5px] leading-snug text-[#374151]">lessons whose plan asked for independent practice ran out of time before the practice.</span></span><span class="flex shrink-0 gap-3 text-end"><span data-num="17" data-den="49" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="w-[72px] text-[15px] font-bold text-[#1d2025]">17 of 49</span></span></li><li data-testid="s6-row" data-w="W-IP-NOPLAN" data-status="ok" class="flex items-start gap-3 border-t border-[#f0f1f3] px-4 py-3 first:border-t-0"><span class="flex min-w-0 flex-1 flex-col gap-0.5"><span class="text-[15px] font-semibold leading-snug text-[#1d2025]">Practice never set</span><span class="text-[13.5px] leading-snug text-[#374151]">lessons whose plan asked for independent practice had time left but never set the practice.</span></span><span class="flex shrink-0 gap-3 text-end"><span data-num="5" data-den="49" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="w-[72px] text-[15px] font-bold text-[#1d2025]">5 of 49</span></span></li><li data-testid="s6-row" data-w="W-EXIT" data-status="ok" class="flex items-start gap-3 border-t border-[#f0f1f3] px-4 py-3 first:border-t-0"><span class="flex min-w-0 flex-1 flex-col gap-0.5"><span class="text-[15px] font-semibold leading-snug text-[#1d2025]">No closing check</span><span class="text-[13.5px] leading-snug text-[#374151]">lessons whose plan asked for an exit check ended without one.</span></span><span class="flex shrink-0 gap-3 text-end"><span data-num="19" data-den="47" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="w-[72px] text-[15px] font-bold text-[#1d2025]">19 of 47</span></span></li><li data-testid="s6-row" data-w="W-EXIT-NOPLAN" data-status="ok" class="flex items-start gap-3 border-t border-[#f0f1f3] px-4 py-3 first:border-t-0"><span class="flex min-w-0 flex-1 flex-col gap-0.5"><span class="text-[15px] font-semibold leading-snug text-[#1d2025]">Time left, no closing check</span><span class="text-[13.5px] leading-snug text-[#374151]">lessons whose plan asked for an exit check had time left and ended without one.</span></span><span class="flex shrink-0 gap-3 text-end"><span data-num="12" data-den="47" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="w-[72px] text-[15px] font-bold text-[#1d2025]">12 of 47</span></span></li><li data-testid="s6-row" data-w="W-WARM" data-status="insufficient" class="flex items-start gap-3 border-t border-[#f0f1f3] px-4 py-3 first:border-t-0"><span class="flex min-w-0 flex-1 flex-col gap-0.5"><span class="text-[15px] font-semibold leading-snug text-[#1d2025]">Warm-up skipped</span><span class="text-[13.5px] leading-snug text-[#374151]">lessons whose plan asked for a warm-up or recall started without one.</span><span class="text-[12.5px] leading-snug text-[#6b7280]">Not enough recordings yet (<span data-num="12" data-den="20" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash">12 of 20</span>)</span></span></li></ul></section><section data-testid="s6-coverage" class="flex flex-col gap-2 rounded-2xl border border-[#e5e7eb] bg-white px-4 py-3.5 shadow-[0_1px_2px_rgba(16,24,40,0.05)] "><p data-num="53" data-den="62" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="text-[14.5px] leading-snug text-[#374151]">Of 62 recordings, 53 had a linked plan</p></section><section data-testid="s6-fico" class="flex flex-col gap-2 rounded-2xl border border-[#e5e7eb] bg-white px-4 py-3.5 shadow-[0_1px_2px_rgba(16,24,40,0.05)] "><h2 class="text-[14.5px] font-semibold leading-snug text-[#1d2025]">Also seen in the AI coach's report (recordings without a linked plan; not counted above)</h2><p data-window="fico17-w4-2026-09-28" class="text-[12.5px] leading-snug text-[#6b7280]">28 Sep to 25 Oct · AI coach report</p><ul class="flex flex-col gap-1.5"><li data-indicator="fico17.questioning" class="text-[14px] leading-snug text-[#374151]">Questioning: scored lowest in <span data-num="4" data-den="9" data-win="fico17-w4-2026-09-28" data-grader="google/gemini-3.8-flash">4 of 9</span></li><li data-indicator="fico17.feedback" class="text-[14px] leading-snug text-[#374151]">Feedback: scored lowest in <span data-num="3" data-den="9" data-win="fico17-w4-2026-09-28" data-grader="google/gemini-3.8-flash">3 of 9</span></li></ul></section><section data-testid="s6-weekly" class="flex flex-col gap-2 rounded-2xl border border-[#e5e7eb] bg-white px-4 py-3.5 shadow-[0_1px_2px_rgba(16,24,40,0.05)] "><h2 class="text-[14.5px] font-semibold leading-snug text-[#1d2025]">Recordings per week</h2><svg data-testid="s6-sparkline" aria-hidden="true" focusable="false" viewBox="0 0 280 44" class="h-11 w-full rtl:-scale-x-100" preserveAspectRatio="none"><path d="M4.0 10.4 L94.7 8.2 L185.3 6.1 L276.0 4.0" fill="none" stroke="#4f46e5" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"></path><circle cx="4" cy="10.35294117647059" r="2.5" fill="#4f46e5"></circle><circle cx="94.66666666666667" cy="8.235294117647058" r="2.5" fill="#4f46e5"></circle><circle cx="185.33333333333334" cy="6.117647058823529" r="2.5" fill="#4f46e5"></circle><circle cx="276" cy="4" r="2.5" fill="#4f46e5"></circle></svg><p class="text-[12.5px] leading-snug text-[#6b7280]"><span data-num="14" data-den="17" data-win="week-2026-10-19" data-grader="google/gemini-3.8-flash">17 recorded · 14 graded</span> · <span data-window="week-2026-10-19">19 Oct to 25 Oct</span></p></section><a data-testid="s6-results-link" class="flex min-h-[44px] items-center justify-center rounded-2xl border border-[#e5e7eb] bg-white px-4 py-3 text-[15.5px] font-semibold text-[#1d2025]" href="/portal/coach/