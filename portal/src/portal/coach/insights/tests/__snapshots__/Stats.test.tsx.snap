exports[`S6 Stats (ur) > first window: the opening line, rows in payload order, no pill 1`] = `"<div data-testid="layout"><div data-testid="insights-stats" data-cp-shell="" class="cp bg-cp-ground text-cp-ink  "><div class="lg:ps-[240px]"><div class="mx-auto w-full max-w-[640px] lg:px-16 lg:pt-9 lg:max-w-[848px]"><div class=" pb-4 md:max-lg:pb-[calc(80px+env(safe-area-inset-bottom))] lg:pb-16"><div class="min-w-0"><header data-testid="insights-band" class="cp-band"><div class="cp-lattice" aria-hidden="true"></div><div class="cp-band__top mb-2.5 flex min-h-[28px] items-center justify-between gap-3"><span class="cp-band__lockup flex items-center gap-2 text-[12px] font-extrabold tracking-[0.14em]" dir="ltr"><img src="/src/assets/niete-logo.png" alt="" class="block h-[22px] w-auto">NIETE</span><span class="flex items-center gap-2"></span></div><h1 class="cp-band__title text-[24px] font-extrabold leading-[1.2] tracking-[-0.01em] lg:text-[30px]">جائزہ</h1><div class="cp-on-band-2 mt-1 text-[14px] leading-snug"><p data-window="w4-2026-09-28" class="text-[14px] leading-snug">۲۸ ستمبر تا ۲۵ اکتوبر، سبق کے منصوبے پر عمل، نمبر دینے کا طریقہ ۲۸ ستمبر کو بدلا</p></div></header><div class="cp-enter flex flex-col px-5 pt-4 lg:px-0 lg:pt-2"><div role="status" data-testid="s6-opening" class="rounded-[16px] bg-cp-navy-tint px-4 py-3.5 text-[15px] leading-[1.45] text-cp-navy"><p class="cp-eyebrow text-[12px] font-bold uppercase leading-snug tracking-[0.08em] text-cp-green-ink ">دیکھیں</p><p class="pt-1">نمبر دینے کا طریقہ <span data-date="2026-09-28">۲۸ ستمبر</span> کو بدلا۔ پہلا ماہ بہ ماہ موازنہ <span data-date="2026-11-22">۲۲ نومبر</span> کے بعد آئے گا؛ اس مدت کی گنتی نیچے ہے۔</p></div><section data-testid="s6-rows" data-section="" class="mt-5 border-t border-cp-hairline pt-6 "><div class=""><div class="sticky top-0 z-10 flex items-end justify-end gap-4 border-b border-cp-hairline bg-cp-ground pb-2 pt-2 text-end"><span data-testid="s6-col-now" class="w-[96px] cp-label text-[12px] font-bold uppercase leading-snug tracking-[0.08em] text-cp-ink-3">اس مدت میں</span></div><ul><li data-testid="s6-row" data-w="W-IP" data-status="ok" class="flex min-h-[44px] items-start gap-4 border-t border-cp-hairline py-3.5 first:border-t-0"><span class="flex min-w-0 flex-1 flex-col gap-0.5"><span class="text-[17px] font-semibold leading-[1.4] text-cp-ink">خود مشق نہیں ہوئی</span><span data-testid="s6-sentence" class="text-[13px] leading-[1.45] text-cp-ink-2">جن اسباق کے منصوبے میں خود مشق شامل تھی، ان میں خود مشق نہیں ہوئی۔</span></span><span class="flex shrink-0 gap-4 pt-0.5"><span class="flex w-[96px] flex-col items-end gap-1.5"><span data-num="22" data-den="49" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="inline-flex items-baseline whitespace-pre w-[96px] justify-end whitespace-nowrap"><span class="text-[13px] font-semibold text-cp-ink-3">۴۹ میں سے </span><b class="text-[22px] font-extrabold leading-[1.1] tracking-[-0.01em] text-cp-navy">۲۲</b></span><span aria-hidden="true" data-bar="22/49" class="block h-1 overflow-hidden rounded-full bg-cp-track w-full"><span data-fill="" class="block h-full rounded-full bg-cp-green" style="width: 44.89795918367347%;"></span></span></span></span></li><li data-testid="s6-row" data-w="W-IP-TIME" data-status="ok" class="flex min-h-[44px] items-start gap-4 border-t border-cp-hairline py-3.5 first:border-t-0"><span class="flex min-w-0 flex-1 flex-col gap-0.5"><span class="text-[17px] font-semibold leading-[1.4] text-cp-ink">وقت ختم ہو گیا</span><span data-testid="s6-sentence" class="text-[13px] leading-[1.45] text-cp-ink-2">جن اسباق کے منصوبے میں خود مشق شامل تھی، ان میں مشق سے پہلے ہی وقت ختم ہو گیا۔</span></span><span class="flex shrink-0 gap-4 pt-0.5"><span class="flex w-[96px] flex-col items-end gap-1.5"><span data-num="17" data-den="49" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="inline-flex items-baseline whitespace-pre w-[96px] justify-end whitespace-nowrap"><span class="text-[13px] font-semibold text-cp-ink-3">۴۹ میں سے </span><b class="text-[22px] font-extrabold leading-[1.1] tracking-[-0.01em] text-cp-navy">۱۷</b></span><span aria-hidden="true" data-bar="17/49" class="block h-1 overflow-hidden rounded-full bg-cp-track w-full"><span data-fill="" class="block h-full rounded-full bg-cp-green" style="width: 34.69387755102041%;"></span></span></span></span></li><li data-testid="s6-row" data-w="W-IP-NOPLAN" data-status="ok" class="flex min-h-[44px] items-start gap-4 border-t border-cp-hairline py-3.5 first:border-t-0"><span class="flex min-w-0 flex-1 flex-col gap-0.5"><span class="text-[17px] font-semibold leading-[1.4] text-cp-ink">مشق دی ہی نہیں گئی</span><span data-testid="s6-sentence" class="text-[13px] leading-[1.45] text-cp-ink-2">جن اسباق کے منصوبے میں خود مشق شامل تھی، ان میں وقت تھا مگر مشق دی ہی نہیں گئی۔</span></span><span class="flex shrink-0 gap-4 pt-0.5"><span class="flex w-[96px] flex-col items-end gap-1.5"><span data-num="5" data-den="49" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="inline-flex items-baseline whitespace-pre w-[96px] justify-end whitespace-nowrap"><span class="text-[13px] font-semibold text-cp-ink-3">۴۹ میں سے </span><b class="text-[22px] font-extrabold leading-[1.1] tracking-[-0.01em] text-cp-navy">۵</b></span><span aria-hidden="true" data-bar="5/49" class="block h-1 overflow-hidden rounded-full bg-cp-track w-full"><span data-fill="" class="block h-full rounded-full bg-cp-green" style="width: 10.204081632653061%;"></span></span></span></span></li><li data-testid="s6-row" data-w="W-EXIT" data-status="ok" class="flex min-h-[44px] items-start gap-4 border-t border-cp-hairline py-3.5 first:border-t-0"><span class="flex min-w-0 flex-1 flex-col gap-0.5"><span class="text-[17px] font-semibold leading-[1.4] text-cp-ink">اختتامی جانچ نہیں ہوئی</span><span data-testid="s6-sentence" class="text-[13px] leading-[1.45] text-cp-ink-2">جن اسباق کے منصوبے میں اختتامی جانچ شامل تھی، وہ بغیر جانچ کے ختم ہوئے۔</span></span><span class="flex shrink-0 gap-4 pt-0.5"><span class="flex w-[96px] flex-col items-end gap-1.5"><span data-num="19" data-den="47" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="inline-flex items-baseline whitespace-pre w-[96px] justify-end whitespace-nowrap"><span class="text-[13px] font-semibold text-cp-ink-3">۴۷ میں سے </span><b class="text-[22px] font-extrabold leading-[1.1] tracking-[-0.01em] text-cp-navy">۱۹</b></span><span aria-hidden="true" data-bar="19/47" class="block h-1 overflow-hidden rounded-full bg-cp-track w-full"><span data-fill="" class="block h-full rounded-full bg-cp-green" style="width: 40.42553191489361%;"></span></span></span></span></li><li data-testid="s6-row" data-w="W-EXIT-NOPLAN" data-status="ok" class="flex min-h-[44px] items-start gap-4 border-t border-cp-hairline py-3.5 first:border-t-0"><span class="flex min-w-0 flex-1 flex-col gap-0.5"><span class="text-[17px] font-semibold leading-[1.4] text-cp-ink">وقت تھا، آخر میں جانچ نہیں</span><span data-testid="s6-sentence" class="text-[13px] leading-[1.45] text-cp-ink-2">جن اسباق کے منصوبے میں اختتامی جانچ شامل تھی، ان میں وقت تھا مگر جانچ نہیں ہوئی۔</span></span><span class="flex shrink-0 gap-4 pt-0.5"><span class="flex w-[96px] flex-col items-end gap-1.5"><span data-num="12" data-den="47" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="inline-flex items-baseline whitespace-pre w-[96px] justify-end whitespace-nowrap"><span class="text-[13px] font-semibold text-cp-ink-3">۴۷ میں سے </span><b class="text-[22px] font-extrabold leading-[1.1] tracking-[-0.01em] text-cp-navy">۱۲</b></span><span aria-hidden="true" data-bar="12/47" class="block h-1 overflow-hidden rounded-full bg-cp-track w-full"><span data-fill="" class="block h-full rounded-full bg-cp-green" style="width: 25.53191489361702%;"></span></span></span></span></li><li data-testid="s6-row" data-w="W-WARM" data-status="insufficient" class="flex min-h-[44px] items-start gap-4 border-t border-cp-hairline py-3.5 first:border-t-0"><span class="flex min-w-0 flex-1 flex-col gap-0.5"><span class="text-[17px] font-semibold leading-[1.4] text-cp-ink">ابتدائی سرگرمی نہیں ہوئی</span><span data-testid="s6-sentence" class="text-[13px] leading-[1.45] text-cp-ink-2">جن اسباق کے منصوبے میں ابتدائی سرگرمی یا دہرائی شامل تھی، وہ اس کے بغیر شروع ہوئے۔</span><span class="text-[13px] leading-[1.45] text-cp-ink-3">ابھی کافی ریکارڈنگز نہیں (<span data-num="12" data-den="20" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash">۲۰ میں سے ۱۲</span>)</span></span></li></ul></div></section><section data-testid="s6-coverage" data-section="" class="mt-5 border-t border-cp-hairline pt-6 "><div class=""><p data-num="53" data-den="62" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="text-[15px] leading-[1.45] text-cp-ink-2">۶۲ ریکارڈنگز میں سے ۵۳ کے ساتھ منصوبہ جُڑا تھا</p></div></section><section data-testid="s6-fico" data-section="" class="mt-5 border-t border-cp-hairline pt-6 "><div class=""><h2 class="text-[15px] font-semibold leading-[1.45] text-cp-ink">اے آئی کوچ کی رپورٹ میں بھی دیکھا گیا (بغیر منصوبے کی ریکارڈنگز؛ اوپر نہیں گنی گئیں)</h2><p data-window="fico17-w4-2026-09-28" class="mt-1 text-[13px] leading-[1.45] text-cp-ink-3">۲۸ ستمبر تا ۲۵ اکتوبر، اے آئی کوچ کی رپورٹ</p><ul class="mt-2"><li data-indicator="fico17.questioning" class="flex min-h-[44px] items-center border-t border-cp-hairline py-2.5 text-[15px] leading-[1.45] text-cp-ink-2 first:border-t-0"><span>سوال پوچھنا: <span data-num="4" data-den="9" data-win="fico17-w4-2026-09-28" data-grader="google/gemini-3.8-flash">۹ میں سے ۴</span> میں سب سے کم نمبر</span></li><li data-indicator="fico17.feedback" class="flex min-h-[44px] items-center border-t border-cp-hairline py-2.5 text-[15px] leading-[1.45] text-cp-ink-2 first:border-t-0"><span>رائے: <span data-num="3" data-den="9" data-win="fico17-w4-2026-09-28" data-grader="google/gemini-3.8-flash">۹ میں سے ۳</span> میں سب سے کم نمبر</span></li></ul></div></section><section data-testid="s6-weekly" data-section="" class="mt-5 border-t border-cp-hairline pt-6 "><div class="flex items-start justify-between gap-3"><div class="min-w-0"><p class="cp-label text-[12px] font-bold uppercase leading-snug tracking-[0.08em] text-cp-ink-3">ہر ہفتے ریکارڈنگز</p></div></div><div class="mt-2"><svg data-testid="s6-sparkline" aria-hidden="true" focusable="false" viewBox="0 0 280 56" class="h-14 w-full overflow-visible rtl:-scale-x-100" preserveAspectRatio="none"><line data-grid="" x1="0" x2="280" y1="6" y2="6" stroke="var(--cp-hairline)" stroke-width="1" vector-effect="non-scaling-stroke"></line><line data-grid="" x1="0" x2="280" y1="28" y2="28" stroke="var(--cp-hairline)" stroke-width="1" vector-effect="non-scaling-stroke"></line><line data-grid="" x1="0" x2="280" y1="50" y2="50" stroke="var(--cp-hairline)" stroke-width="1" vector-effect="non-scaling-stroke"></line><path d="M6.0 13.8 L95.3 11.2 L184.7 8.6 L274.0 6.0" fill="none" stroke="var(--cp-green)" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"></path><circle cx="274" cy="6" r="3" fill="var(--cp-green)"></circle></svg><p class="mt-2 text-[13px] leading-[1.45] text-cp-ink-3"><span data-num="14" data-den="17" data-win="week-2026-10-19" data-grader="google/gemini-3.8-flash">۱۷ ریکارڈ ہوئیں، ۱۴ جانچی گئیں</span>، <span data-window="week-2026-10-19">۱۹ اکتوبر تا ۲۵ اکتوبر</span></p></div></section><a data-testid="s6-results-link" class="mt-5 flex min-h-[44px] items-center gap-3 border-y border-cp-hairline py-3.5 text-[17px] font-semibold leading-[1.4] text-cp-green-ink outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green" href="/portal/coach/insights/stats/results"><span class="min-w-0 flex-1">نتائج</span><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right shrink-0 text-cp-ink-3 rtl:rotate-180" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></a><div class="lg:hidden"><p data-testid="trust-line" class="px-1 pt-6 text-[13px] leading-[1.45] text-cp-ink-3">کوڈ، نام نہیں۔ کوچنگ کے لیے، جانچ پڑتال کے لیے نہیں۔</p></div></div></div></div></div></div></div></div>"`;

exports[`S6 Stats (ur) > marker: the full-width marker row, no pill anywhere 1`] = `"<div data-testid="layout"><div data-testid="insights-stats" data-cp-shell="" class="cp bg-cp-ground text-cp-ink  "><div class="lg:ps-[240px]"><div class="mx-auto w-full max-w-[640px] lg:px-16 lg:pt-9 lg:max-w-[848px]"><div class=" pb-4 md:max-lg:pb-[calc(80px+env(safe-area-inset-bottom))] lg:pb-16"><div class="min-w-0"><header data-testid="insights-band" class="cp-band"><div class="cp-lattice" aria-hidden="true"></div><div class="cp-band__top mb-2.5 flex min-h-[28px] items-center justify-between gap-3"><span class="cp-band__lockup flex items-center gap-2 text-[12px] font-extrabold tracking-[0.14em]" dir="ltr"><img src="/src/assets/niete-logo.png" alt="" class="block h-[22px] w-auto">NIETE</span><span class="flex items-center gap-2"></span></div><h1 class="cp-band__title text-[24px] font-extrabold leading-[1.2] tracking-[-0.01em] lg:text-[30px]">جائزہ</h1><div class="cp-on-band-2 mt-1 text-[14px] leading-snug"><p data-window="w4-2026-09-28" class="text-[14px] leading-snug">۲۸ ستمبر تا ۲۵ اکتوبر، سبق کے منصوبے پر عمل، نمبر دینے کا طریقہ ۲۸ ستمبر کو بدلا</p></div></header><div class="cp-enter flex flex-col px-5 pt-4 lg:px-0 lg:pt-2"><section data-testid="s6-rows" data-section="" class=" pt-6 "><div class=""><div class="sticky top-0 z-10 flex items-end justify-end gap-4 border-b border-cp-hairline bg-cp-ground pb-2 pt-2 text-end"><span data-testid="s6-col-now" class="w-[96px] cp-label text-[12px] font-bold uppercase leading-snug tracking-[0.08em] text-cp-ink-3">اس مدت میں</span><span data-testid="s6-col-before" class="flex w-[96px] flex-col"><span class="cp-label text-[12px] font-bold uppercase leading-snug tracking-[0.08em] text-cp-ink-3">پچھلی مدت میں</span><span data-window="w4-2026-08-31" class="text-[12px] font-medium leading-tight text-cp-ink-3">۳۱ اگست تا ۲۷ ستمبر</span></span></div><p data-testid="s6-marker" role="note" class="mt-2 rounded-[12px] bg-cp-navy-tint px-4 py-2.5 text-[13px] leading-[1.45] text-cp-navy">نمبر دینے کا طریقہ <span data-date="2026-09-28">۲۸ ستمبر</span> کو بدلا۔ اس سے پہلے کی مدت کا موازنہ نہیں کیا جاتا۔</p><ul><li data-testid="s6-row" data-w="W-IP" data-status="ok" class="flex min-h-[44px] items-start gap-4 border-t border-cp-hairline py-3.5 first:border-t-0"><span class="flex min-w-0 flex-1 flex-col gap-0.5"><span class="text-[17px] font-semibold leading-[1.4] text-cp-ink">خود مشق نہیں ہوئی</span><span data-testid="s6-sentence" class="text-[13px] leading-[1.45] text-cp-ink-2">جن اسباق کے منصوبے میں خود مشق شامل تھی، ان میں خود مشق نہیں ہوئی۔</span></span><span class="flex shrink-0 gap-4 pt-0.5"><span class="flex w-[96px] flex-col items-end gap-1.5"><span data-num="22" data-den="49" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="inline-flex items-baseline whitespace-pre w-[96px] justify-end whitespace-nowrap"><span class="text-[13px] font-semibold text-cp-ink-3">۴۹ میں سے </span><b class="text-[22px] font-extrabold leading-[1.1] tracking-[-0.01em] text-cp-navy">۲۲</b></span><span aria-hidden="true" data-bar="22/49" class="block h-1 overflow-hidden rounded-full bg-cp-track w-full"><span data-fill="" class="block h-full rounded-full bg-cp-green" style="width: 44.89795918367347%;"></span></span></span></span></li><li data-testid="s6-row" data-w="W-IP-TIME" data-status="ok" class="flex min-h-[44px] items-start gap-4 border-t border-cp-hairline py-3.5 first:border-t-0"><span class="flex min-w-0 flex-1 flex-col gap-0.5"><span class="text-[17px] font-semibold leading-[1.4] text-cp-ink">وقت ختم ہو گیا</span><span data-testid="s6-sentence" class="text-[13px] leading-[1.45] text-cp-ink-2">جن اسباق کے منصوبے میں خود مشق شامل تھی، ان میں مشق سے پہلے ہی وقت ختم ہو گیا۔</span></span><span class="flex shrink-0 gap-4 pt-0.5"><span class="flex w-[96px] flex-col items-end gap-1.5"><span data-num="17" data-den="49" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="inline-flex items-baseline whitespace-pre w-[96px] justify-end whitespace-nowrap"><span class="text-[13px] font-semibold text-cp-ink-3">۴۹ میں سے </span><b class="text-[22px] font-extrabold leading-[1.1] tracking-[-0.01em] text-cp-navy">۱۷</b></span><span aria-hidden="true" data-bar="17/49" class="block h-1 overflow-hidden rounded-full bg-cp-track w-full"><span data-fill="" class="block h-full rounded-full bg-cp-green" style="width: 34.69387755102041%;"></span></span></span></span></li><li data-testid="s6-row" data-w="W-IP-NOPLAN" data-status="ok" class="flex min-h-[44px] items-start gap-4 border-t border-cp-hairline py-3.5 first:border-t-0"><span class="flex min-w-0 flex-1 flex-col gap-0.5"><span class="text-[17px] font-semibold leading-[1.4] text-cp-ink">مشق دی ہی نہیں گئی</span><span data-testid="s6-sentence" class="text-[13px] leading-[1.45] text-cp-ink-2">جن اسباق کے منصوبے میں خود مشق شامل تھی، ان میں وقت تھا مگر مشق دی ہی نہیں گئی۔</span></span><span class="flex shrink-0 gap-4 pt-0.5"><span class="flex w-[96px] flex-col items-end gap-1.5"><span data-num="5" data-den="49" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="inline-flex items-baseline whitespace-pre w-[96px] justify-end whitespace-nowrap"><span class="text-[13px] font-semibold text-cp-ink-3">۴۹ میں سے </span><b class="text-[22px] font-extrabold leading-[1.1] tracking-[-0.01em] text-cp-navy">۵</b></span><span aria-hidden="true" data-bar="5/49" class="block h-1 overflow-hidden rounded-full bg-cp-track w-full"><span data-fill="" class="block h-full rounded-full bg-cp-green" style="width: 10.204081632653061%;"></span></span></span></span></li><li data-testid="s6-row" data-w="W-EXIT" data-status="ok" class="flex min-h-[44px] items-start gap-4 border-t border-cp-hairline py-3.5 first:border-t-0"><span class="flex min-w-0 flex-1 flex-col gap-0.5"><span class="text-[17px] font-semibold leading-[1.4] text-cp-ink">اختتامی جانچ نہیں ہوئی</span><span data-testid="s6-sentence" class="text-[13px] leading-[1.45] text-c