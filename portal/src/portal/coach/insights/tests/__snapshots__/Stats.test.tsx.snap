exports[`S6 Stats (en) > two windows: both counts per row and the pill 1`] = `"<div data-testid="layout"><div data-testid="insights-stats" class="mx-auto flex w-full max-w-xl flex-col text-[#1d2025]"><header class="flex flex-col gap-3 px-1 pb-1.5 pt-6"><div class="flex items-center gap-3"><h1 class="min-w-0 flex-1 break-words text-[32px] font-light leading-[1.15] tracking-[-0.015em] [overflow-wrap:anywhere]">Stats</h1></div></header><div class="flex flex-col gap-2.5 pb-4 pt-3"><p data-window="w4-2026-09-28" class="px-1 text-[12.5px] leading-snug text-[#6b7280]">28 Sep to 25 Oct · lesson-plan fidelity · scoring changed 28 Sep</p><section data-testid="s6-rows" class="overflow-hidden rounded-2xl border border-[#e5e7eb] bg-white"><div class="flex items-end justify-end gap-3 px-4 pb-1 pt-3 text-end text-[11.5px] font-semibold text-[#6b7280]"><span data-testid="s6-col-now" class="w-[72px]">this window</span><span data-testid="s6-col-before" class="flex w-[72px] flex-col"><span>last window</span><span data-window="w4-2026-08-31" class="text-[10.5px] font-normal leading-tight">31 Aug to 27 Sep</span></span></div><ul><li data-testid="s6-row" data-w="W-IP" data-status="ok" class="flex items-start gap-3 border-t border-[#f0f1f3] px-4 py-3 first:border-t-0"><span class="flex min-w-0 flex-1 flex-col gap-0.5"><span class="text-[15px] font-semibold leading-snug text-[#1d2025]">No independent practice</span><span class="text-[13.5px] leading-snug text-[#374151]">lessons whose plan asked for independent practice had none.</span><span data-testid="s6-pill" data-change="fewer" class="mt-1 w-fit rounded-full bg-[#eef2ff] px-2.5 py-0.5 text-[12px] font-semibold text-[#3730a3]">fewer skipped</span></span><span class="flex shrink-0 gap-3 text-end"><span data-num="22" data-den="49" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="w-[72px] text-[15px] font-bold text-[#1d2025]">22 of 49</span><span data-num="24" data-den="50" data-win="w4-2026-08-31" data-grader="google/