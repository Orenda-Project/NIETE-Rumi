// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`S5 Move (en) > normal: the library verbatim, the 14-day rule, contract and identity 1`] = `"<div data-testid="layout"><div data-testid="insights-move" data-cp-shell="" class="cp bg-cp-ground text-cp-ink  "><div class="lg:ps-[240px]"><div class="mx-auto w-full max-w-[640px] lg:px-16 lg:pt-9 lg:max-w-[848px]"><div class=" pb-4 md:max-lg:pb-[calc(80px+env(safe-area-inset-bottom))] lg:pb-16"><div class="min-w-0"><header data-testid="insights-appbar" class="flex items-start gap-3 border-b border-cp-hairline bg-cp-surface px-5 pb-3 pt-4 lg:border-0 lg:bg-transparent lg:px-0 lg:pb-4 lg:pt-0"><a aria-label="Back" class="mt-0.5 flex h-11 w-11 shrink-0 items-center justify-center rounded-full border-[1.5px] border-cp-hairline bg-white text-cp-navy outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green" href="/portal/coach/insights/w/W-IP-TIME"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left rtl:rotate-180" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg></a><div class="min-w-0 flex-1"><div class="text-[13px] leading-snug text-cp-ink-3"><span data-code="" class="[unicode-bidi:isolate]">I-IP-TIME-1</span> from the library</div><h1 class="break-words text-[24px] font-extrabold leading-[1.2] tracking-[-0.01em] text-cp-navy [overflow-wrap:anywhere] lg:text-[30px]"><span data-text="library">Hard cap: explanation ends at minute 10 (rehearse the stop line)</span></h1></div></header><div class="cp-enter flex flex-col px-5 pt-4 lg:px-0 lg:pt-2"><section data-testid="s5-w" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><p class="cp-eyebrow text-[12px] font-bold uppercase leading-snug tracking-[0.08em] text-cp-green-ink ">ONE MOVE</p><p class="text-[15.5px] leading-snug text-[#1d2025]"><span data-num="17" data-den="49" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="font-bold">17 of 49</span> lessons whose plan asked for independent practice ran out of time before the practice.</p><p data-window="w4-2026-09-28" class="text-[13px] leading-[1.45] text-cp-ink-3">28 Sep to 25 Oct · lesson-plan fidelity · scoring changed 28 Sep</p></section><section data-testid="s5-step" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><h2 class="text-[15px] font-semibold leading-snug text-[#1d2025]">The teacher's one step</h2><p data-text="library" class="text-[15px] leading-snug text-[#374151] font-medium text-[#1d2025]">Write 10 in the board corner; stop explaining at minute 10 and move to 'we do'</p></section><section data-testid="s5-try-tomorrow" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><p class="text-[15.5px] font-semibold leading-snug text-[#1d2025]"><span data-text="library">Try this tomorrow: write 10 in the board corner before you start, and at minute 10 say the stop line and move to 'we do', even if you have not finished.</span></p></section><section data-testid="s5-rehearsal" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><h2 class="text-[15px] font-semibold leading-snug text-[#1d2025]"><span data-nonum="">Rehearsal, 30 seconds</span></h2><p class="text-[15px] leading-snug text-[#374151]" data-nonum="">Rehearsal, 30 seconds. The teacher says it as it will be said to the class: <span data-text="library">The teacher says the stop line as to the class: «بس، وضاحت یہیں ختم۔ اب ایک سوال مل کر کرتے ہیں۔» (that is enough explaining; now one question together). Three times, each time the coach says a minute number first ('nine... ten... stop'). The coach listens for the line coming out without an extra explanation attached.</span></p><a data-testid="s5-play" class="flex min-h-[44px] items-center justify-center rounded-xl border border-[#d1d5db] bg-white px-4 py-2.5 text-center text-[15px] font-semibold text-[#1d2025]" href="/portal/coach/insights/w/W-IP-TIME#moment">Play the moment in the debrief</a></section><section data-testid="s5-facts" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><h2 class="text-[13px] font-semibold text-[#6b7280]">With whom</h2><p data-text="library" class="text-[15px] leading-snug text-[#374151]">One teacher, in the debrief after a recording that fired W-IP-TIME.</p><h2 class="pt-1 text-[13px] font-semibold text-[#6b7280]">How long</h2><p data-text="library" class="text-[15px] leading-snug text-[#374151]">5 min inside a 15 min debrief</p></section><section data-testid="s5-materials" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><h2 class="text-[15px] font-semibold leading-snug text-[#1d2025]">Materials</h2><ul class="flex flex-col divide-y divide-[#f0f1f3]"><li data-kind="print" class="py-2 text-[15px] leading-snug text-[#374151]"><span data-text="library">Timekeeper card: the board corner shows 10 / 17 / 25; a child says "time khatam" at each mark</span></li><li data-kind="other" class="py-2 text-[15px] leading-snug text-[#374151]"><span data-text="library">NIETE next-step line "manage": One signal for attention and one routine for switching tasks, used every time</span></li><li data-kind="vidrec" class="py-2 text-[15px] leading-snug text-[#374151]"><span data-text="library">VIDREC module 47 "Five step lesson plan"</span></li></ul></section><section data-testid="s5-listen-for" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><h2 class="text-[15px] font-semibold leading-snug text-[#1d2025]">What you listen for</h2><p data-text="library" class="text-[15px] leading-snug text-[#374151]">The explanation stops by about minute 10 with a sentence like «بس، اتنا کافی ہے، اب مل کر کرتے ہیں» and a guided item follows; the practice stretch and the exit are then both present.</p></section><section data-testid="s5-check" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><h2 class="text-[15px] font-semibold leading-snug text-[#1d2025]">Check it worked</h2><p data-text="library" class="text-[15px] leading-snug text-[#374151]">The number 10 was on the board and the teacher moved to 'we do' by minute 11 in the lesson the coach watched.</p><p data-testid="s5-check-rule" data-nonum="" class="text-[13px] leading-snug text-[#6b7280]">No visit is booked within 14 days, so the check is <span data-date="2026-11-09">Mon 9 Nov</span>, 14 days after the step is set.</p></section><details data-testid="s5-evidence" class="rounded-2xl border border-[#e5e7eb] bg-white px-4 py-3"><summary class="flex min-h-[44px] cursor-pointer items-center text-[15px] font-semibold leading-snug text-[#1d2025]">Why this works</summary><ul class="flex flex-col gap-2 pt-1"><li class="text-[15px] leading-snug text-[#374151]"><p data-text="library" class="font-medium text-[#374151]">Rosenshine, B. (2012). Principles of Instruction. American Educator 36(1)</p><p data-text="library">small amounts of material at a time, then guided practice; the FLN plans put 10 minutes on practice, so the explanation cannot run past a third of the period</p></li></ul></details><section data-testid="s5-alternatives" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><h2 class="text-[15px] font-semibold leading-snug text-[#1d2025]">Other moves</h2><ul class="flex flex-col divide-y divide-[#f0f1f3]"><li data-i="I-IP-1" class="py-2 text-[15px] leading-snug text-[#374151]"><span data-text="library">Coach models the practice step in the teacher's class</span></li><li data-i="I-IP-TIME-2" class="py-2 text-[15px] leading-snug text-[#374151]"><span data-text="library">A child timekeeper and the three marks on the board</span></li></ul></section><p data-testid="s5-footer" class="px-1 text-center text-[12.5px] text-[#6b7280]">Written to your tracker, never to a file on the teacher.</p><div class="lg:hidden"><p data-testid="trust-line" class="px-1 pt-6 text-[13px] leading-[1.45] text-cp-ink-3">Codes, never names. For coaching, never for evaluation.</p></div></div></div></div></div></div></div></div>"`;

exports[`S5 Move (en) > visit rule: the check is the booked visit, days counted from today (Karachi) 1`] = `"<div data-testid="layout"><div data-testid="insights-move" data-cp-shell="" class="cp bg-cp-ground text-cp-ink  "><div class="lg:ps-[240px]"><div class="mx-auto w-full max-w-[640px] lg:px-16 lg:pt-9 lg:max-w-[848px]"><div class=" pb-4 md:max-lg:pb-[calc(80px+env(safe-area-inset-bottom))] lg:pb-16"><div class="min-w-0"><header data-testid="insights-appbar" class="flex items-start gap-3 border-b border-cp-hairline bg-cp-surface px-5 pb-3 pt-4 lg:border-0 lg:bg-transparent lg:px-0 lg:pb-4 lg:pt-0"><a aria-label="Back" class="mt-0.5 flex h-11 w-11 shrink-0 items-center justify-center rounded-full border-[1.5px] border-cp-hairline bg-white text-cp-navy outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green" href="/portal/coach/insights/w/W-IP-TIME"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left rtl:rotate-180" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg></a><div class="min-w-0 flex-1"><div class="text-[13px] leading-snug text-cp-ink-3"><span data-code="" class="[unicode-bidi:isolate]">I-IP-TIME-1</span> from the library</div><h1 class="break-words text-[24px] font-extrabold leading-[1.2] tracking-[-0.01em] text-cp-navy [overflow-wrap:anywhere] lg:text-[30px]"><span data-text="library">Hard cap: explanation ends at minute 10 (rehearse the stop line)</span></h1></div></header><div class="cp-enter flex flex-col px-5 pt-4 lg:px-0 lg:pt-2"><section data-testid="s5-w" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><p class="cp-eyebrow text-[12px] font-bold uppercase leading-snug tracking-[0.08em] text-cp-green-ink ">ONE MOVE</p><p class="text-[15.5px] leading-snug text-[#1d2025]"><span data-num="17" data-den="49" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="font-bold">17 of 49</span> lessons whose plan asked for independent practice ran out of time before the practice.</p><p data-window="w4-2026-09-28" class="text-[13px] leading-[1.45] text-cp-ink-3">28 Sep to 25 Oct · lesson-plan fidelity · scoring changed 28 Sep</p></section><section data-testid="s5-step" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><h2 class="text-[15px] font-semibold leading-snug text-[#1d2025]">The teacher's one step</h2><p data-text="library" class="text-[15px] leading-snug text-[#374151] font-medium text-[#1d2025]">Write 10 in the board corner; stop explaining at minute 10 and move to 'we do'</p></section><section data-testid="s5-try-tomorrow" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><p class="text-[15.5px] font-semibold leading-snug text-[#1d2025]"><span data-text="library">Try this tomorrow: write 10 in the board corner before you start, and at minute 10 say the stop line and move to 'we do', even if you have not finished.</span></p></section><section data-testid="s5-rehearsal" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><h2 class="text-[15px] font-semibold leading-snug text-[#1d2025]"><span data-nonum="">Rehearsal, 30 seconds</span></h2><p class="text-[15px] leading-snug text-[#374151]" data-nonum="">Rehearsal, 30 seconds. The teacher says it as it will be said to the class: <span data-text="library">The teacher says the stop line as to the class: «بس، وضاحت یہیں ختم۔ اب ایک سوال مل کر کرتے ہیں۔» (that is enough explaining; now one question together). Three times, each time the coach says a minute number first ('nine... ten... stop'). The coach listens for the line coming out without an extra explanation attached.</span></p><a data-testid="s5-play" class="flex min-h-[44px] items-center justify-center rounded-xl border border-[#d1d5db] bg-white px-4 py-2.5 text-center text-[15px] font-semibold text-[#1d2025]" href="/portal/coach/insights/w/W-IP-TIME#moment">Play the moment in the debrief</a></section><section data-testid="s5-facts" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><h2 class="text-[13px] font-semibold text-[#6b7280]">With whom</h2><p data-text="library" class="text-[15px] leading-snug text-[#374151]">One teacher, in the debrief after a recording that fired W-IP-TIME.</p><h2 class="pt-1 text-[13px] font-semibold text-[#6b7280]">How long</h2><p data-text="library" class="text-[15px] leading-snug text-[#374151]">5 min inside a 15 min debrief</p></section><section data-testid="s5-materials" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><h2 class="text-[15px] font-semibold leading-snug text-[#1d2025]">Materials</h2><ul class="flex flex-col divide-y divide-[#f0f1f3]"><li data-kind="print" class="py-2 text-[15px] leading-snug text-[#374151]"><span data-text="library">Timekeeper card: the board corner shows 10 / 17 / 25; a child says "time khatam" at each mark</span></li><li data-kind="other" class="py-2 text-[15px] leading-snug text-[#374151]"><span data-text="library">NIETE next-step line "manage": One signal for attention and one routine for switching tasks, used every time</span></li><li data-kind="vidrec" class="py-2 text-[15px] leading-snug text-[#374151]"><span data-text="library">VIDREC module 47 "Five step lesson plan"</span></li></ul></section><section data-testid="s5-listen-for" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><h2 class="text-[15px] font-semibold leading-snug text-[#1d2025]">What you listen for</h2><p data-text="library" class="text-[15px] leading-snug text-[#374151]">The explanation stops by about minute 10 with a sentence like «بس، اتنا کافی ہے، اب مل کر کرتے ہیں» and a guided item follows; the practice stretch and the exit are then both present.</p></section><section data-testid="s5-check" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><h2 class="text-[15px] font-semibold leading-snug text-[#1d2025]">Check it worked</h2><p data-text="library" class="text-[15px] leading-snug text-[#374151]">The number 10 was on the board and the teacher moved to 'we do' by minute 11 in the lesson the coach watched.</p><p data-testid="s5-check-rule" data-nonum="" class="text-[13px] leading-snug text-[#6b7280]">The check is the visit on <span data-date="2026-11-04">Wed 4 Nov</span>, <span data-nonum="">9</span> days after the step is set (never under 7).</p></section><details data-testid="s5-evidence" class="rounded-2xl border border-[#e5e7eb] bg-white px-4 py-3"><summary class="flex min-h-[44px] cursor-pointer items-center text-[15px] font-semibold leading-snug text-[#1d2025]">Why this works</summary><ul class="flex flex-col gap-2 pt-1"><li class="text-[15px] leading-snug text-[#374151]"><p data-text="library" class="font-medium text-[#374151]">Rosenshine, B. (2012). Principles of Instruction. American Educator 36(1)</p><p data-text="library">small amounts of material at a time, then guided practice; the FLN plans put 10 minutes on practice, so the explanation cannot run past a third of the period</p></li></ul></details><section data-testid="s5-alternatives" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><h2 class="text-[15px] font-semibold leading-snug text-[#1d2025]">Other moves</h2><ul class="flex flex-col divide-y divide-[#f0f1f3]"><li data-i="I-IP-1" class="py-2 text-[15px] leading-snug text-[#374151]"><span data-text="library">Coach models the practice step in the teacher's class</span></li><li data-i="I-IP-TIME-2" class="py-2 text-[15px] leading-snug text-[#374151]"><span data-text="library">A child timekeeper and the three marks on the board</span></li></ul></section><p data-testid="s5-footer" class="px-1 text-center text-[12.5px] text-[#6b7280]">Written to your tracker, never to a file on the teacher.</p><div class="lg:hidden"><p data-testid="trust-line" class="px-1 pt-6 text-[13px] leading-[1.45] text-cp-ink-3">Codes, never names. For coaching, never for evaluation.</p></div></div></div></div></div></div></div></div>"`;

exports[`S5 Move (ur) > normal: the library verbatim, the 14-day rule, contract and identity 1`] = `"<div data-testid="layout"><div data-testid="insights-move" data-cp-shell="" class="cp bg-cp-ground text-cp-ink  "><div class="lg:ps-[240px]"><div class="mx-auto w-full max-w-[640px] lg:px-16 lg:pt-9 lg:max-w-[848px]"><div class=" pb-4 md:max-lg:pb-[calc(80px+env(safe-area-inset-bottom))] lg:pb-16"><div class="min-w-0"><header data-testid="insights-appbar" class="flex items-start gap-3 border-b border-cp-hairline bg-cp-surface px-5 pb-3 pt-4 lg:border-0 lg:bg-transparent lg:px-0 lg:pb-4 lg:pt-0"><a aria-label="واپس" class="mt-0.5 flex h-11 w-11 shrink-0 items-center justify-center rounded-full border-[1.5px] border-cp-hairline bg-white text-cp-navy outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green" href="/portal/coach/insights/w/W-IP-TIME"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left rtl:rotate-180" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg></a><div class="min-w-0 flex-1"><div class="text-[13px] leading-snug text-cp-ink-3">لائبریری سے <span data-code="" dir="ltr" class="[unicode-bidi:isolate]">⁦I-IP-TIME-1⁩</span></div><h1 class="break-words text-[24px] font-extrabold leading-[1.2] tracking-[-0.01em] text-cp-navy [overflow-wrap:anywhere] lg:text-[30px]"><span data-text="library">سخت حد: وضاحت دسویں منٹ پر ختم (رکنے والا جملہ مشق کریں)</span></h1></div></header><div class="cp-enter flex flex-col px-5 pt-4 lg:px-0 lg:pt-2"><section data-testid="s5-w" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><p class="cp-eyebrow text-[12px] font-bold uppercase leading-snug tracking-[0.08em] text-cp-green-ink ">ایک قدم</p><p class="text-[15.5px] leading-snug text-[#1d2025]"><span data-num="17" data-den="49" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="font-bold">۴۹ میں سے ۱۷</span> جن اسباق کے منصوبے میں خود مشق شامل تھی، ان میں مشق سے پہلے ہی وقت ختم ہو گیا۔</p><p data-window="w4-2026-09-28" class="text-[13px] leading-[1.45] text-cp-ink-3">۲۸ ستمبر تا ۲۵ اکتوبر، سبق کے منصوبے پر عمل، نمبر دینے کا طریقہ ۲۸ ستمبر کو بدلا</p></section><section data-testid="s5-step" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><h2 class="text-[15px] font-semibold leading-snug text-[#1d2025]">استاد کا ایک قدم</h2><p data-text="library" class="text-[15px] leading-snug text-[#374151] font-medium text-[#1d2025]">بورڈ کے کونے میں ۱۰ لکھیں؛ دسویں منٹ پر وضاحت روک کر «ہم کریں» شروع کریں</p></section><section data-testid="s5-try-tomorrow" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><p class="text-[15.5px] font-semibold leading-snug text-[#1d2025]"><span data-text="library">کل یہ آزمائیں: شروع کرنے سے پہلے بورڈ کے کونے میں ۱۰ لکھیں، اور دسویں منٹ پر رکنے والا جملہ کہہ کر «ہم کریں» کی طرف بڑھیں، چاہے وضاحت پوری نہ ہوئی ہو۔</span></p></section><section data-testid="s5-rehearsal" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><h2 class="text-[15px] font-semibold leading-snug text-[#1d2025]"><span data-nonum="">مشق، ۳۰ سیکنڈ</span></h2><p class="text-[15px] leading-snug text-[#374151]" data-nonum="">مشق، ۳۰ سیکنڈ۔ استاد ویسے کہے جیسے جماعت میں کہا جائے گا: <span data-text="library">استاد جماعت کو مخاطب کر کے رکنے والا جملہ کہیں: «بس، وضاحت یہیں ختم۔ اب ایک سوال مل کر کرتے ہیں۔» تین بار؛ ہر بار کوچ پہلے منٹ گنے («نو... دس... رکیں»)۔ کوچ کے لیے سننے کی بات: جملہ بغیر کسی اضافی وضاحت کے نکلے۔</span></p><a data-testid="s5-play" class="flex min-h-[44px] items-center justify-center rounded-xl border border-[#d1d5db] bg-white px-4 py-2.5 text-center text-[15px] font-semibold text-[#1d2025]" href="/portal/coach/insights/w/W-IP-TIME#moment">بات چیت میں لمحہ چلائیں</a></section><section data-testid="s5-facts" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><h2 class="text-[13px] font-semibold text-[#6b7280]">کس کے ساتھ</h2><p data-text="library" class="text-[15px] leading-snug text-[#374151]">ایک استاد، اس ریکارڈنگ کے بعد کی بات چیت میں جس میں مشق سے پہلے وقت ختم ہو گیا۔</p><h2 class="pt-1 text-[13px] font-semibold text-[#6b7280]">کتنی دیر</h2><p data-text="library" class="text-[15px] leading-snug text-[#374151]">۱۵ منٹ کی بات چیت کے اندر ۵ منٹ</p></section><section data-testid="s5-materials" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><h2 class="text-[15px] font-semibold leading-snug text-[#1d2025]">سامان</h2><ul class="flex flex-col divide-y divide-[#f0f1f3]"><li data-kind="print" class="py-2 text-[15px] leading-snug text-[#374151]"><span data-text="library">وقت کے نگران کا کارڈ: بورڈ کے کونے میں ۱۰ / ۱۷ / ۲۵؛ ہر نشان پر ایک بچہ «ٹائم ختم» کہے</span></li><li data-kind="other" class="py-2 text-[15px] leading-snug text-[#374151]"><span data-text="library">⁦NIETE⁩ کی اگلے قدم والی سطر «⁦manage⁩»: توجہ کا ایک اشارہ اور کام بدلنے کا ایک معمول، ہر بار</span></li><li data-kind="vidrec" class="py-2 text-[15px] leading-snug text-[#374151]"><span data-text="library">ویڈیو ماڈیول ۴۷ «⁦Five step lesson plan⁩»</span></li></ul></section><section data-testid="s5-listen-for" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><h2 class="text-[15px] font-semibold leading-snug text-[#1d2025]">آپ کس بات پر کان رکھیں</h2><p data-text="library" class="text-[15px] leading-snug text-[#374151]">وضاحت تقریباً دسویں منٹ تک «بس، اتنا کافی ہے، اب مل کر کرتے ہیں» جیسے جملے پر رکے اور مل کر ایک سوال ہو؛ پھر خود مشق اور اختتامی جانچ دونوں ہوں۔</p></section><section data-testid="s5-check" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><h2 class="text-[15px] font-semibold leading-snug text-[#1d2025]">جانچیں کہ کام کر گیا</h2><p data-text="library" class="text-[15px] leading-snug text-[#374151]">بورڈ پر ۱۰ لکھا تھا اور جس سبق کو کوچ نے دیکھا اس میں گیارہویں منٹ تک «ہم کریں» شروع ہو گیا۔</p><p data-testid="s5-check-rule" data-nonum="" class="text-[13px] leading-snug text-[#6b7280]">۱۴ دن کے اندر کوئی دورہ طے نہیں، اس لیے جانچ <span data-date="2026-11-09">پیر ۹ نومبر</span> کو ہے، قدم طے ہونے کے ۱۴ دن بعد۔</p></section><details data-testid="s5-evidence" class="rounded-2xl border border-[#e5e7eb] bg-white px-4 py-3"><summary class="flex min-h-[44px] cursor-pointer items-center text-[15px] font-semibold leading-snug text-[#1d2025]">یہ کیوں کام کرتا ہے</summary><ul class="flex flex-col gap-2 pt-1"><li class="text-[15px] leading-snug text-[#374151]"><p data-text="library" class="font-medium text-[#374151]">Rosenshine, B. (2012). Principles of Instruction. American Educator 36(1)</p><p data-text="library">تھوڑا مواد ایک وقت میں، پھر مل کر مشق؛ FLN منصوبے مشق کو ۱۰ منٹ دیتے ہیں، اس لیے وضاحت دورانیے کے ایک تہائی سے آگے نہیں جا سکتی۔</p></li></ul></details><section data-testid="s5-alternatives" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><h2 class="text-[15px] font-semibold leading-snug text-[#1d2025]">دوسرے قدم</h2><ul class="flex flex-col divide-y divide-[#f0f1f3]"><li data-i="I-IP-1" class="py-2 text-[15px] leading-snug text-[#374151]"><span data-text="library">کوچ استاد کی جماعت میں خود مشق کا مرحلہ کر کے دکھائے</span></li><li data-i="I-IP-TIME-2" class="py-2 text-[15px] leading-snug text-[#374151]"><span data-text="library">ایک بچہ وقت کا نگران اور بورڈ پر تین نشان</span></li></ul></section><p data-testid="s5-footer" class="px-1 text-center text-[12.5px] text-[#6b7280]">آپ کی فہرست میں لکھا جائے گا، استاد کی کسی فائل میں نہیں۔</p><div class="lg:hidden"><p data-testid="trust-line" class="px-1 pt-6 text-[13px] leading-[1.45] text-cp-ink-3">کوڈ، نام نہیں۔ کوچنگ کے لیے، جانچ پڑتال کے لیے نہیں۔</p></div></div></div></div></div></div></div></div>"`;

exports[`S5 Move (ur) > visit rule: the check is the booked visit, days counted from today (Karachi) 1`] = `"<div data-testid="layout"><div data-testid="insights-move" data-cp-shell="" class="cp bg-cp-ground text-cp-ink  "><div class="lg:ps-[240px]"><div class="mx-auto w-full max-w-[640px] lg:px-16 lg:pt-9 lg:max-w-[848px]"><div class=" pb-4 md:max-lg:pb-[calc(80px+env(safe-area-inset-bottom))] lg:pb-16"><div class="min-w-0"><header data-testid="insights-appbar" class="flex items-start gap-3 border-b border-cp-hairline bg-cp-surface px-5 pb-3 pt-4 lg:border-0 lg:bg-transparent lg:px-0 lg:pb-4 lg:pt-0"><a aria-label="واپس" class="mt-0.5 flex h-11 w-11 shrink-0 items-center justify-center rounded-full border-[1.5px] border-cp-hairline bg-white text-cp-navy outline-none focus-visible:ring-[3px] focus-visible:ring-cp-green" href="/portal/coach/insights/w/W-IP-TIME"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left rtl:rotate-180" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg></a><div class="min-w-0 flex-1"><div class="text-[13px] leading-snug text-cp-ink-3">لائبریری سے <span data-code="" dir="ltr" class="[unicode-bidi:isolate]">⁦I-IP-TIME-1⁩</span></div><h1 class="break-words text-[24px] font-extrabold leading-[1.2] tracking-[-0.01em] text-cp-navy [overflow-wrap:anywhere] lg:text-[30px]"><span data-text="library">سخت حد: وضاحت دسویں منٹ پر ختم (رکنے والا جملہ مشق کریں)</span></h1></div></header><div class="cp-enter flex flex-col px-5 pt-4 lg:px-0 lg:pt-2"><section data-testid="s5-w" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><p class="cp-eyebrow text-[12px] font-bold uppercase leading-snug tracking-[0.08em] text-cp-green-ink ">ایک قدم</p><p class="text-[15.5px] leading-snug text-[#1d2025]"><span data-num="17" data-den="49" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash" class="font-bold">۴۹ میں سے ۱۷</span> جن اسباق کے منصوبے میں خود مشق شامل تھی، ان میں مشق سے پہلے ہی وقت ختم ہو گیا۔</p><p data-window="w4-2026-09-28" class="text-[13px] leading-[1.45] text-cp-ink-3">۲۸ ستمبر تا ۲۵ اکتوبر، سبق کے منصوبے پر عمل، نمبر دینے کا طریقہ ۲۸ ستمبر کو بدلا</p></section><section data-testid="s5-step" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><h2 class="text-[15px] font-semibold leading-snug text-[#1d2025]">استاد کا ایک قدم</h2><p data-text="library" class="text-[15px] leading-snug text-[#374151] font-medium text-[#1d2025]">بورڈ کے کونے میں ۱۰ لکھیں؛ دسویں منٹ پر وضاحت روک کر «ہم کریں» شروع کریں</p></section><section data-testid="s5-try-tomorrow" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><p class="text-[15.5px] font-semibold leading-snug text-[#1d2025]"><span data-text="library">کل یہ آزمائیں: شروع کرنے سے پہلے بورڈ کے کونے میں ۱۰ لکھیں، اور دسویں منٹ پر رکنے والا جملہ کہہ کر «ہم کریں» کی طرف بڑھیں، چاہے وضاحت پوری نہ ہوئی ہو۔</span></p></section><section data-testid="s5-rehearsal" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><h2 class="text-[15px] font-semibold leading-snug text-[#1d2025]"><span data-nonum="">مشق، ۳۰ سیکنڈ</span></h2><p class="text-[15px] leading-snug text-[#374151]" data-nonum="">مشق، ۳۰ سیکنڈ۔ استاد ویسے کہے جیسے جماعت میں کہا جائے گا: <span data-text="library">استاد جماعت کو مخاطب کر کے رکنے والا جملہ کہیں: «بس، وضاحت یہیں ختم۔ اب ایک سوال مل کر کرتے ہیں۔» تین بار؛ ہر بار کوچ پہلے منٹ گنے («نو... دس... رکیں»)۔ کوچ کے لیے سننے کی بات: جملہ بغیر کسی اضافی وضاحت کے نکلے۔</span></p><a data-testid="s5-play" class="flex min-h-[44px] items-center justify-center rounded-xl border border-[#d1d5db] bg-white px-4 py-2.5 text-center text-[15px] font-semibold text-[#1d2025]" href="/portal/coach/insights/w/W-IP-TIME#moment">بات چیت میں لمحہ چلائیں</a></section><section data-testid="s5-facts" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><h2 class="text-[13px] font-semibold text-[#6b7280]">کس کے ساتھ</h2><p data-text="library" class="text-[15px] leading-snug text-[#374151]">ایک استاد، اس ریکارڈنگ کے بعد کی بات چیت میں جس میں مشق سے پہلے وقت ختم ہو گیا۔</p><h2 class="pt-1 text-[13px] font-semibold text-[#6b7280]">کتنی دیر</h2><p data-text="library" class="text-[15px] leading-snug text-[#374151]">۱۵ منٹ کی بات چیت کے اندر ۵ منٹ</p></section><section data-testid="s5-materials" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><h2 class="text-[15px] font-semibold leading-snug text-[#1d2025]">سامان</h2><ul class="flex flex-col divide-y divide-[#f0f1f3]"><li data-kind="print" class="py-2 text-[15px] leading-snug text-[#374151]"><span data-text="library">وقت کے نگران کا کارڈ: بورڈ کے کونے میں ۱۰ / ۱۷ / ۲۵؛ ہر نشان پر ایک بچہ «ٹائم ختم» کہے</span></li><li data-kind="other" class="py-2 text-[15px] leading-snug text-[#374151]"><span data-text="library">⁦NIETE⁩ کی اگلے قدم والی سطر «⁦manage⁩»: توجہ کا ایک اشارہ اور کام بدلنے کا ایک معمول، ہر بار</span></li><li data-kind="vidrec" class="py-2 text-[15px] leading-snug text-[#374151]"><span data-text="library">ویڈیو ماڈیول ۴۷ «⁦Five step lesson plan⁩»</span></li></ul></section><section data-testid="s5-listen-for" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><h2 class="text-[15px] font-semibold leading-snug text-[#1d2025]">آپ کس بات پر کان رکھیں</h2><p data-text="library" class="text-[15px] leading-snug text-[#374151]">وضاحت تقریباً دسویں منٹ تک «بس، اتنا کافی ہے، اب مل کر کرتے ہیں» جیسے جملے پر رکے اور مل کر ایک سوال ہو؛ پھر خود مشق اور اختتامی جانچ دونوں ہوں۔</p></section><section data-testid="s5-check" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><h2 class="text-[15px] font-semibold leading-snug text-[#1d2025]">جانچیں کہ کام کر گیا</h2><p data-text="library" class="text-[15px] leading-snug text-[#374151]">بورڈ پر ۱۰ لکھا تھا اور جس سبق کو کوچ نے دیکھا اس میں گیارہویں منٹ تک «ہم کریں» شروع ہو گیا۔</p><p data-testid="s5-check-rule" data-nonum="" class="text-[13px] leading-snug text-[#6b7280]">جانچ <span data-date="2026-11-04">بدھ ۴ نومبر</span> کے دورے پر ہے، قدم طے ہونے کے <span data-nonum="">۹</span> دن بعد (سات سے کم کبھی نہیں)۔</p></section><details data-testid="s5-evidence" class="rounded-2xl border border-[#e5e7eb] bg-white px-4 py-3"><summary class="flex min-h-[44px] cursor-pointer items-center text-[15px] font-semibold leading-snug text-[#1d2025]">یہ کیوں کام کرتا ہے</summary><ul class="flex flex-col gap-2 pt-1"><li class="text-[15px] leading-snug text-[#374151]"><p data-text="library" class="font-medium text-[#374151]">Rosenshine, B. (2012). Principles of Instruction. American Educator 36(1)</p><p data-text="library">تھوڑا مواد ایک وقت میں، پھر مل کر مشق؛ FLN منصوبے مشق کو ۱۰ منٹ دیتے ہیں، اس لیے وضاحت دورانیے کے ایک تہائی سے آگے نہیں جا سکتی۔</p></li></ul></details><section data-testid="s5-alternatives" class="flex flex-col gap-2 border-t border-cp-hairline py-5 first:border-t-0 first:pt-1 "><h2 class="text-[15px] font-semibold leading-snug text-[#1d2025]">دوسرے قدم</h2><ul class="flex flex-col divide-y divide-[#f0f1f3]"><li data-i="I-IP-1" class="py-2 text-[15px] leading-snug text-[#374151]"><span data-text="library">کوچ استاد کی جماعت میں خود مشق کا مرحلہ کر کے دکھائے</span></li><li data-i="I-IP-TIME-2" class="py-2 text-[15px] leading-snug text-[#374151]"><span data-text="library">ایک بچہ وقت کا نگران اور بورڈ پر تین نشان</span></li></ul></section><p data-testid="s5-footer" class="px-1 text-center text-[12.5px] text-[#6b7280]">آپ کی فہرست میں لکھا جائے گا، استاد کی کسی فائل میں نہیں۔</p><div class="lg:hidden"><p data-testid="trust-line" class="px-1 pt-6 text-[13px] leading-[1.45] text-cp-ink-3">کوڈ، نام نہیں۔ کوچنگ کے لیے، جانچ پڑتال کے لیے نہیں۔</p></div></div></div></div></div></div></div></div>"`;
