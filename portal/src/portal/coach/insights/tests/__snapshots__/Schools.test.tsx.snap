exports[`Schools tab (ur) > normal: API order, a WRow per top W, a school with none, contract, no identity 1`] = `"<div data-testid="layout"><div data-testid="insights-schools" data-cp-shell="" class="cp bg-cp-ground text-cp-ink  "><div class="lg:ps-[240px]"><div class="mx-auto w-full max-w-[640px] lg:px-16 lg:pt-9 lg:max-w-[848px]"><div class=" pb-4 md:max-lg:pb-[calc(80px+env(safe-area-inset-bottom))] lg:pb-16"><div class="min-w-0"><header data-testid="insights-band" class="cp-band"><div class="cp-lattice" aria-hidden="true"></div><div class="cp-band__top mb-2.5 flex min-h-[28px] items-center justify-between gap-3"><span class="cp-band__lockup flex items-center gap-2 text-[12px] font-extrabold tracking-[0.14em]" dir="ltr"><img src="/src/assets/niete-logo.png" alt="" class="block h-[22px] w-auto">NIETE</span><span class="flex items-center gap-2"></span></div><h1 class="cp-band__title text-[24px] font-extrabold leading-[1.2] tracking-[-0.01em] lg:text-[30px]">اسکول</h1><div class="cp-on-band-2 mt-1 text-[14px] leading-snug"><p data-window="w4-2026-09-28" class="text-[14px] leading-snug">۲۸ ستمبر تا ۲۵ اکتوبر، سبق کے منصوبے پر عمل، نمبر دینے کا طریقہ ۲۸ ستمبر کو بدلا</p></div><p data-testid="band-foot" class="cp-band__foot mt-3 text-[12px] leading-[1.45] lg:hidden">کوڈ، نام نہیں۔ کوچنگ کے لیے، جانچ پڑتال کے لیے نہیں۔</p></header><div class="cp-enter flex flex-col px-5 pt-4 lg:px-0 lg:pt-2"><div class="flex flex-col"><ul class="flex flex-col"><li data-testid="schools-row" data-school="00000000-0000-4000-8000-010000000006" class="flex flex-col gap-2.5 border-t border-cp-hairline py-4 first:border-t-0 first:pt-1"><div><p class="text-[17px] font-semibold leading-[1.4] text-cp-ink [overflow-wrap:anywhere]"><span data-code="" dir="ltr" class="[unicode-bidi:isolate]">⁦Govt. Primary School Fictional-06⁩</span></p><p class="mt-0.5 text-[13px] leading-[1.7] text-cp-ink-3 [&amp;_[data-num]]:inline-block [&amp;_[data-num]]:whitespace-nowrap [&amp;_[data-num]]:rounded-full [&amp;