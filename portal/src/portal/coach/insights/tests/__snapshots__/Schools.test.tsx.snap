exports[`Schools tab (ur) > normal: API order, a WRow per top W, a school with none, contract, no identity 1`] = `"<div data-testid="layout"><div data-testid="insights-schools" class="mx-auto flex w-full max-w-xl flex-col text-[#1d2025]"><div data-testid="page-hero" class="-mx-4 -mt-4 min-[576px]:mx-0 min-[576px]:mt-0 min-[576px]:overflow-hidden min-[576px]:rounded-[28px]"><div data-testid="insights-band" class="flex min-h-[72px] flex-col justify-center bg-[#333748] px-5 py-3 text-white min-[576px]:px-6"><h1 class="text-[22px] font-semibold leading-tight">اسکول</h1></div></div><div class="flex flex-col gap-2.5 pb-4 pt-3"><div class="flex flex-col gap-3"><p data-window="w4-2026-09-28" class="px-1 text-[12.5px] leading-snug text-[#6b7280]">۲۸ ستمبر تا ۲۵ اکتوبر، سبق کے منصوبے پر عمل، نمبر دینے کا طریقہ ۲۸ ستمبر کو بدلا</p><ul class="flex flex-col gap-3"><li data-testid="schools-row" data-school="00000000-0000-4000-8000-010000000006" class="flex flex-col gap-2 rounded-2xl border border-[#e5e7eb] bg-[#f9fafb] p-3"><div class="px-1"><p class="text-[15.5px] font-semibold leading-snug text-[#1d2025] [overflow-wrap:anywhere]"><span data-code="" dir="ltr" class="[unicode-bidi:isolate]">⁦Govt. Primary School Fictional-06⁩</span></p><p class="text-[13px] leading-snug text-[#6b7280]">پچھلا دورہ <span data-date="2026-09-14">پیر ۱۴ ستمبر</span>، <span data-num="7" data-den="9" data-win="w4-2026-09-28" data-grader="google/gemini-3.8-flash">۹ میں سے ۷</span> جانچی گئیں</p></div><a data-testid="wrow" data-w="W-IP-TIME" data-state="also_seen" class="flex w-full items-start gap-3 rounded-2xl border border-[#e5e7eb] bg-white px-3.5 py-3 text-start" href="/portal/coach/insights/w/W-IP-TIME"><span class="flex min-w-0 flex-1 flex-col gap-0.5"><span class="text-[15.5px] font-semibold leading-snug text-[#1d2025]">وقت ختم ہو گیا</span><span class="text-[14px] leading-snug text-[#374151]">جن اسباق کے منصوبے میں خود مشق شامل تھی، ان میں مشق سے پہلے ہی وقت ختم ہو گیا۔</span><span class="text-[1