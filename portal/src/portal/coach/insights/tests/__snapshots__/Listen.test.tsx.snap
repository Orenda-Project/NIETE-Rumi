exports[`Listen (ur) > empty filter: no moment of that W this week 1`] = `"<div data-testid="layout"><div data-testid="insights-listen" data-cp-shell="" class="cp bg-cp-ground text-cp-ink  "><div class="lg:ps-[240px]"><div class="mx-auto w-full max-w-[640px] lg:px-16 lg:pt-9 lg:max-w-[848px]"><div class=" pb-4 md:max-lg:pb-[calc(80px+env(safe-area-inset-bottom))] lg:pb-16"><div class="min-w-0"><header data-testid="insights-band" class="cp-band"><div class="cp-lattice" aria-hidden="true"></div><div class="cp-band__top mb-2.5 flex min-h-[28px] items-center justify-between gap-3"><span class="cp-band__lockup flex items-center gap-2 text-[12px] font-extrabold tracking-[0.14em]" dir="ltr"><img src="/src/assets/niete-logo.png" alt="" class="block h-[22px] w-auto">NIETE</span><span class="flex items-center gap-2"></span></div><h1 class="cp-band__title text-[24px] font-extrabold leading-[1.2] tracking-[-0.01em] lg:text-[30px]">سنیں</h1><div class="cp-on-band-2 mt-1 text-[14px] leading-snug"><p data-testid="listen-week" class="text-[14px] leading-snug">اس ہفتے، <span data-window="week-2026-10-19">۱۹ اکتوبر تا ۲۵ اکتوبر</span></p></div></header><div class="cp-enter flex flex-col px-5 pt-4 lg:px-0 lg:pt-2"><div class="flex flex-col gap-4"><p data-testid="listen-base" class="text-[13px] leading-[1.45] text-cp-ink-3">اس ہفتے <span data-num="5" data-den="14" data-win="week-2026-10-19" data-grader="google/gemini-3.8-flash">۱۴ میں سے ۵</span> جانچی گئی ریکارڈنگز میں ایک لمحہ ہے (سبق کے منصوبے پر عمل)، نئی پہلے۔ وقت پر ٹیپ کریں تو یہیں چلے گا؛ پورے پلیئر کے لیے قطار کھولیں۔</p><div role="group" class="flex flex-wrap gap-2"><button type="button" data-testid="listen-chip" data-w="" aria-pressed="false" class="cp-press flex min-h-[44px] items-center gap-1.5 rounded-full px-4 text-[14px] font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-cp-navy bg-cp-green-tint text-cp-green-ink"><span>سب</span><span class="text-[12px] font-medium"><span data-num="5" data-den="14" d