exports[`Listen (ur) > a filter chip re-reads the feed with ?w= and shows only that W 1`] = `"<div data-testid="layout"><div data-testid="insights-listen" class="mx-auto flex w-full max-w-xl flex-col text-[#1d2025]"><header class="flex flex-col gap-3 px-1 pb-1.5 pt-6"><div class="flex items-center gap-3"><h1 class="min-w-0 flex-1 break-words text-[32px] font-light leading-[1.15] tracking-[-0.015em] [overflow-wrap:anywhere]">سنیں</h1></div></header><div class="flex flex-col gap-2.5 pb-4 pt-3"><div class="flex flex-col gap-3"><p data-testid="listen-week" class="-mt-1 px-1 text-[13px] font-medium text-[#6b7280]">اس ہفتے، <span data-window="week-2026-10-19">۱۹ اکتوبر تا ۲۵ اکتوبر</span></p><p data-testid="listen-base" class="px-1 text-[14px] leading-snug text-[#374151]">اس ہفتے <span data-num="5" data-den="14" data-win="week-2026-10-19" data-grader="google/gemini-3.8-flash">۱۴ میں سے ۵</span> جانچی گئی ریکارڈنگز میں ایک لمحہ ہے (سبق کے منصوبے پر عمل)، نئی پہلے۔ وقت پر ٹیپ کریں تو یہیں چلے گا؛ پورے پلیئر کے لیے قطار کھولیں۔</p><div role="group" class="flex flex-wrap gap-2"><button type="button" data-testid="listen-chip" data-w="" aria-pressed="false" class="flex min-h-[44px] items-center gap-1.5 rounded-full border px-3.5 text-[14px] font-semibold border-[#d1d5db] bg-white text-[#1d2025]"><span>سب</span><span class="text-[12px] font-medium text-[#6b7280]"><span data-num="5" data-den="14" data-win="week-2026-10-19" data-grader="google/gemini-3.8-flash">۱۴ میں سے ۵</span></span></button><button type="button" data-testid="listen-chip" data-w="W-IP-TIME" aria-pressed="true" class="flex min-h-[44px] items-center gap-1.5 rounded-full border px-3.5 text-[14px] font-semibold border-[#33374a] bg-[#33374a] text-white"><span>وقت ختم ہو گیا</span><span class="text-[12px] font-medium text-white/80"><span data-num="3" data-den="14" data-win="week-2026-10-19" data-grader="google/gemini-3.8-flash">۱۴ میں سے ۳</span></span></button><button type="button" data-testid="listen-chip" data-w="