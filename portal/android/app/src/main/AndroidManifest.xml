<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="${appLabel}"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Android App Links: a tapped portal link opens this app instead of
              the browser, once Android has verified the domain against
              /.well-known/assetlinks.json on that host (served by the portal;
              it must list this build's package + signing SHA-256).
              Unverified, links keep opening in the browser as before.

              The host placeholder is the host of VITE_API_BASE_URL
              (app/build.gradle), so each build claims the portal it talks to.

              Scope: the exact paths /portal/dashboard and /portal/login, plus
              the areas a teacher or coach is sent to (bd-q4g7s.2): Training,
              Lesson plans / Curriculum (the assessment generator is one of its
              tabs), Coaching, and the coach's Observations. Each is a prefix,
              so its inner pages open in the app too. Never a bare /portal/
              prefix: reset-password and setup links stay in the browser. The
              web side (AppLinkListener) accepts any /portal/ page; widening
              this list is a Play release.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${deepLinkHost}" />
                <data android:path="/portal/dashboard" />
                <data android:path="/portal/login" />
                <data android:pathPrefix="/portal/training" />
                <data android:pathPrefix="/portal/curriculum" />
                <data android:pathPrefix="/portal/lesson-plans" />
                <data android:pathPrefix="/portal/coaching" />
                <data android:pathPrefix="/portal/leader/observations" />
                <data android:pathPrefix="/portal/leader/observe" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      bd-q4g7s: "Record your class" records the lesson with getUserMedia +
      MediaRecorder inside the WebView. Capacitor's BridgeWebChromeClient grants
      an AUDIO_CAPTURE request only when these two are declared (it asks for
      them at runtime the first time she taps Record now).
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!--
      bd-q4g7s.1: NO CAMERA permission, and no storage or media permissions.
      "Take a photo" is <input accept="image/*" capture>: with CAMERA NOT
      declared, Capacitor hands it straight to the camera app (no permission
      needed, the photo comes back through the FileProvider above); declaring
      it would only add a runtime prompt first. Every file arrives through the
      system picker, which needs no READ_EXTERNAL_STORAGE / READ_MEDIA_*.

      Declaring RECORD_AUDIO makes Play IMPLY a microphone is required and hide
      the app from phones without one. It is not: such a phone can still upload.
    -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
