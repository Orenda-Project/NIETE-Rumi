<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="${appLabel}"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Android App Links: a tapped portal link opens this app instead of
              the browser, once Android has verified the domain against
              /.well-known/assetlinks.json on that host (served by the portal;
              it must list this build's package + signing SHA-256).
              Unverified, links keep opening in the browser as before.

              The host placeholder is the host of VITE_API_BASE_URL
              (app/build.gradle), so each build claims the portal it talks to.

              Scope is deliberately exact paths. The web side (AppLinkListener)
              already accepts any /portal/ page, so widening this list is the
              only change needed later, but it IS a Play release.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${deepLinkHost}" />
                <data android:path="/portal/dashboard" />
                <data android:path="/portal/login" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      bd-q4g7s: "Record your class" records the lesson with getUserMedia +
      MediaRecorder inside the WebView. Capacitor's BridgeWebChromeClient grants
      an AUDIO_CAPTURE request only when these two are declared (it asks for
      them at runtime the first time she taps Record now).
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!--
      "Take a photo" of her lesson plan opens the camera from <input capture>.
      Once CAMERA is declared, Capacitor asks for it at runtime before opening
      the camera; the photo is written through the FileProvider above.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      Declaring those permissions makes Play IMPLY the hardware is required and
      hide the app from phones without it. Neither is: a phone with no camera
      can still record, and one with no usable microphone can still upload.
    -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
