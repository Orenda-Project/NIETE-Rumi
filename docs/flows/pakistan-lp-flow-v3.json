{
  "version": "7.0",
  "data_api_version": "3.0",
  "routing_model": {
    "SELECT_GRADE": [
      "SELECT_SUBJECT"
    ],
    "SELECT_SUBJECT": [
      "SELECT_CHAPTER"
    ],
    "SELECT_CHAPTER": [
      "SELECT_LESSON"
    ],
    "SELECT_LESSON": [
      "SELECT_LESSON_MORE",
      "SUCCESS"
    ],
    "SELECT_LESSON_MORE": [
      "SUCCESS"
    ],
    "SUCCESS": []
  },
  "screens": [
    {
      "id": "SELECT_GRADE",
      "title": "📘 Lesson Plans",
      "data": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "main-content": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "metadata": {
                    "type": "string"
                  }
                }
              },
              "start": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string"
                  },
                  "alt-text": {
                    "type": "string"
                  }
                }
              },
              "on-click-action": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "payload": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "__example__": [
            {
              "id": "3",
              "main-content": {
                "title": "Grade 3",
                "description": "Tap to open",
                "metadata": "Primary curriculum lesson plans"
              },
              "on-click-action": {
                "name": "data_exchange",
                "payload": {
                  "step": "grade",
                  "grade": "3"
                }
              }
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "NavigationList",
            "name": "grade_list",
            "list-items": "${data.items}"
          }
        ]
      }
    },
