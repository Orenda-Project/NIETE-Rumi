    {
      "id": "SUCCESS",
      "title": "On its way!",
      "terminal": true,
      "data": {
        "message": {
          "type": "string",
          "__example__": "Your lesson plan \"Introducing Myself\" is on its way to your chat!"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Sent! 📘"
          },
          {
            "type": "TextBody",
            "text": "${data.message}"
          },
          {
            "type": "TextBody",
            "text": "Check your chat — the PDF arrives in a few seconds. You can close this now."
          },
          {
            "type": "Footer",
            "label": "Done",
            "on-click-action": {
