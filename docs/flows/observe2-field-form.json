                  }
                ]
              },
              {
                "type": "If",
                "condition": "${form.p2_groups} != 'none' && ${form.p2_groups} != 'cannot'",
                "then": [
                  {
                    "type": "CheckboxGroup",
                    "name": "p2_listen",
                    "label": "When you sat with a group",
                    "description": "Tick everything you saw",
                    "required": false,
                    "data-source": [
                      {
                        "id": "turns",
