                "required": true,
                "data-source": [
                  {
                    "id": "hands",
                    "title": "Only raised hands",
                    "description": "The teacher only asked children who put a hand up."
                  },
                  {
                    "id": "once",
                    "title": "One child without a hand up",
                    "description": "Once, the teacher asked a child who had not put a hand up."
                  },
                  {
