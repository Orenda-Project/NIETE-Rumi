    },
    {
      "id": "AFTER",
      "title": "Before you seal",
      "data": {
        "error_messages": {
          "type": "object",
          "__example__": {}
        },
        "error": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "after_form",
            "error-messages": "${data.error_messages}",
            "children": [
              {
                "type": "TextHeading",
                "text": "Before you seal"
              },
              {
                "type": "TextCaption",
                "text": "About two minutes, before you leave the room."
              },
              {
                "type": "RadioButtonsGroup",
                "name": "incident",
                "label": "Anything to report?",
                "required": true,
                "data-source": [
                  {
                    "id": "none",
                    "title": "Nothing to report"
                  },
                  {
                    "id": "sarcastic",
                    "title": "Praise that sounded mocking",
                    "description": "Words like 'well done' said in a way that made fun of a child."
                  },
                  {
                    "id": "ridicule",
                    "title": "A child was shamed or mocked",
                    "description": "Any ridicule, humiliation or threat towards a child."
                  },
                  {
                    "id": "error",
                    "title": "Wrong fact left uncorrected",
                    "description": "The teacher said or wrote something wrong and did not correct it."
                  },
                  {
                    "id": "tech",
                    "title": "The recording failed",
                    "description": "The recorder stopped, or nothing was recorded."
                  }
                ]
              },
              {
                "type": "If",
                "condition": "${form.incident} != 'none'",
                "then": [
                  {
                    "type": "TextArea",
                    "name": "detail",
                    "label": "What happened, when",
                    "required": true,
                    "max-length": 600,
                    "helper-text": "The words used and the minute"
                  }
                ],
                "else": []
              },
              {
                "type": "TextArea",
                "name": "note",
                "label": "Only you could see",
                "required": false,
                "max-length": 600,
                "helper-text": "What a recorder can't catch: the back rows, the board, how the class reacted"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "lp",
                "label": "Lesson plan",
                "required": true,
                "data-source": [
                  {
                    "id": "used",
                    "title": "Followed a lesson plan"
                  },
                  {
                    "id": "notfollowed",
                    "title": "Had one, didn't follow it"
                  },
                  {
                    "id": "none",
                    "title": "No plan for this lesson"
                  }
                ]
              },
              {
                "type": "PhotoPicker",
                "name": "photos",
                "label": "Photos (optional)",
                "description": "Boards, notebooks, groups at work. Never faces.",
                "photo-source": "camera_gallery",
                "min-uploaded-photos": 0,
                "max-uploaded-photos": 9,
                "max-file-size-kb": 10240
              },
              {
                "type": "Dropdown",
                "name": "priority",
                "label": "Work on first",
                "required": true,
                "data-source": [
                  {
                    "id": "C1",
                    "title": "Questions that make them think"
                  },
                  {
                    "id": "C3",
                    "title": "Picking quiet children too"
                  },
                  {
                    "id": "D1",
                    "title": "Children explaining why"
                  },
                  {
                    "id": "D2",
                    "title": "More children speaking"
                  },
                  {
                    "id": "D5",
                    "title": "Children asking questions"
                  },
                  {
                    "id": "C2",
                    "title": "Helping when a child is wrong"
                  },
                  {
                    "id": "C6",
                    "title": "Making it safe to be wrong"
                  },
                  {
                    "id": "D4",
                    "title": "Children trying when unsure"
                  },
                  {
                    "id": "C4",
                    "title": "Giving children real choices"
                  },
                  {
                    "id": "C5",
                    "title": "Smooth switches of activity"
                  },
                  {
                    "id": "C7",
                    "title": "Real group work"
                  },
                  {
                    "id": "C8",
                    "title": "Children using materials"
                  },
                  {
                    "id": "D3",
                    "title": "Children talking to each other"
                  },
                  {
                    "id": "F1",
                    "title": "Getting the content right"
                  },
                  {
                    "id": "F2",
                    "title": "Using subject words"
                  },
                  {
                    "id": "F3",
                    "title": "Explaining why it works"
                  },
                  {
                    "id": "F4",
                    "title": "Linking to real life"
                  }
                ]
              },
              {
                "type": "OptIn",
                "name": "seal_ok",
                "label": "Seal this record. I can't change it afterwards, and Rumi's findings open only after I seal.",
                "required": true
              },
              {
                "type": "TextBody",
                "text": "${data.error}",
                "visible": "${data.has_error}"
              },
              {
                "type": "Footer",
                "label": "Seal and send",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "screen": "AFTER",
                    "incident": "${form.incident}",
                    "detail": "${form.detail}",
                    "note": "${form.note}",
                    "lp": "${form.lp}",
                    "priority": "${form.priority}",
                    "seal_ok": "${form.seal_ok}",
                    "photos": "${form.photos}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "SEALED",
      "title": "Sealed",
      "terminal": true,
      "success": true,
      "data": {
        "sealed_line": {
          "type": "string",
          "__example__": "Sealed at 10:39"
        },
        "next_line": {
          "type": "string",
          "__example__": "Next: send me the recording."
        },
        "record_id": {
          "type": "string",
          "__example__": "00000000-0000-4000-8000-000000000000"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "${data.sealed_line}"
          },
          {
            "type": "TextBody",
            "text": "${data.next_line}"
          },
          {
            "type": "Footer",
            "label": "Done",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "observe2": "sealed",
                "record_id": "${data.record_id}"
              }
            }
          }
        ]
      }
    }
  ]
}
