{
  "version": "7.3",
  "data_api_version": "3.0",
  "routing_model": {
    "PART_1": [
      "PART_2"
    ],
    "PART_2": [
      "AFTER"
    ],
    "AFTER": [
      "SEALED"
    ],
    "SEALED": []
  },
  "screens": [
    {
      "id": "PART_1",
      "title": "Part 1",
      "data": {
        "teacher_line": {
          "type": "string",
          "__example__": "Rabia's lesson · Grade 4 · Maths"
        },
        "part_hint": {
          "type": "string",
          "__example__": "Minutes 0 to 20. Tap \"Part 1 done\" at minute 20; your answers are saved then."
        },
        "error_messages": {
          "type": "object",
          "__example__": {}
        },
        "error": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "part_1_form",
            "error-messages": "${data.error_messages}",
            "children": [
              {
                "type": "TextHeading",
                "text": "Fill this in as you watch"
              },
              {
                "type": "TextSubheading",
                "text": "${data.teacher_line}"
              },
              {
                "type": "TextCaption",
                "text": "${data.part_hint}"
              },
              {
                "type": "TextInput",
                "name": "present",
                "label": "Children present",
                "input-type": "number",
                "required": true,
                "helper-text": "Everyone in class today"
              },
              {
                "type": "TextInput",
                "name": "p1_spoke",
                "label": "Children who spoke",
                "input-type": "number",
                "required": true,
                "helper-text": "Count each child once. You can change it as you go."
              },
              {
                "type": "RadioButtonsGroup",
                "name": "p1_picked",
                "label": "Who did the teacher ask?",
                "required": true,
                "data-source": [
                  {
                    "id": "hands",
                    "title": "Only raised hands",
                    "description": "The teacher only asked children who put a hand up."
                  },
                  {
                    "id": "once",
                    "title": "One child without a hand up",
                    "description": "Once, the teacher asked a child who had not put a hand up."
                  },
                  {
                    "id": "often",
                    "title": "Several without hands up",
                    "description": "More than once, the teacher asked children who had not put a hand up."
                  },
                  {
                    "id": "varied",
                    "title": "Several ways to include all",
                    "description": "For example: said the child's name before the question, pair talk, everyone writes an answer, name sticks."
                  }
                ]
              },
              {
                "type": "RadioButtonsGroup",
                "name": "p1_groups",
                "label": "Did children work together?",
                "required": true,
                "data-source": [
                  {
                    "id": "none",
                    "title": "No, alone or whole class",
                    "description": "No pair or group task in this part."
                  },
                  {
                    "id": "alone",
                    "title": "Sat together, worked alone",
                    "description": "Children sat in pairs or groups, but each did their own work."
                  },
                  {
                    "id": "combine",
                    "title": "Made one thing together",
                    "description": "The task needed the group to work together, e.g. one chart or one answer per group."
                  },
                  {
                    "id": "roles",
                    "title": "Had roles and reported back",
                    "description": "Each child had a job, and the group told the class what they did."
                  },
                  {
                    "id": "cannot",
                    "title": "The room can't seat groups",
                    "description": "Fixed benches, or no space to sit together."
                  }
                ]
              },
              {
                "type": "If",
                "condition": "${form.p1_groups} != 'none' && ${form.p1_groups} != 'cannot'",
                "then": [
                  {
                    "type": "CheckboxGroup",
                    "name": "p1_listen",
                    "label": "When you sat with a group",
                    "description": "Tick everything you saw",
                    "required": false,
                    "data-source": [
                      {
                        "id": "turns",
                        "title": "Each spoke, no one replied",
                        "description": "Children spoke in turn but did not answer each other."
                      },
                      {
                        "id": "once",
                        "title": "One child replied to another",
                        "description": "Once, a child answered or added to another child's idea."
                      },
                      {
                        "id": "often",
                        "title": "Replied to each other often",
                        "description": "Two or more times, children answered or added to each other's ideas."
                      },
                      {
                        "id": "agreed",
                        "title": "Disagreed, then agreed",
                        "description": "Children gave reasons, questioned each other and agreed on one answer."
                      }
                    ]
                  },
                  {
                    "type": "TextInput",
                    "name": "p1_listen_other",
                    "label": "Something else",
                    "required": false,
                    "helper-text": "What the children did, in a few words"
                  }
                ],
                "else": []
              },
              {
                "type": "RadioButtonsGroup",
                "name": "p1_materials",
                "label": "Who used books or materials?",
                "required": true,
                "data-source": [
                  {
                    "id": "none",
                    "title": "Nobody, though they would help",
                    "description": "No book, board, chart or objects were used, though they would have helped."
                  },
                  {
                    "id": "teacher",
                    "title": "Only the teacher",
                    "description": "The teacher showed or wrote; the children did not touch them."
                  },
                  {
                    "id": "children",
                    "title": "The children used them",
                    "description": "Children used books, cards or objects, or wrote on the board."
                  },
                  {
                    "id": "explain",
                    "title": "Children explained with them",
                    "description": "A child used a material to show or explain their thinking."
                  },
                  {
                    "id": "nofit",
                    "title": "Nothing suits this topic",
                    "description": "No material would help with this topic."
                  }
                ]
              },
              {
                "type": "RadioButtonsGroup",
                "name": "p1_change",
                "label": "Did the class switch activity?",
                "required": true,
                "data-source": [
                  {
                    "id": "yes",
                    "title": "Yes"
                  },
                  {
                    "id": "no",
                    "title": "No"
                  }
                ],
                "description": "For example: from listening to writing, or into groups."
              },
              {
                "type": "If",
                "condition": "${form.p1_change} == 'yes'",
                "then": [
                  {
                    "type": "RadioButtonsGroup",
                    "name": "p1_change_how",
                    "label": "What happened at the switch?",
                    "required": true,
                    "data-source": [
                      {
                        "id": "stalled",
                        "title": "No signal, children drifted",
                        "description": "The teacher gave no signal; children kept talking or wandering, and the lesson stopped."
                      },
                      {
                        "id": "slow",
                        "title": "Signal, but slow to settle",
                        "description": "The teacher gave a signal, but many children took more than a minute or had to be called back."
                      },
                      {
                        "id": "clear",
                        "title": "Settled within a minute",
                        "description": "The teacher gave a clear signal and the children were ready within about a minute."
                      },
                      {
                        "id": "ahead",
                        "title": "Ready before being told",
                        "description": "The teacher said what comes next beforehand; children moved without being told one by one."
                      }
                    ],
                    "description": "If there was more than one switch, pick what happened most."
                  }
                ],
                "else": []
              },
              {
                "type": "TextArea",
                "name": "p1_notes",
                "label": "Anything else",
                "required": false,
                "max-length": 600,
                "helper-text": "The minute and what you saw, e.g. 8 min: board wiped before copying"
              },
              {
                "type": "TextBody",
                "text": "${data.error}",
                "visible": "${data.has_error}"
              },
              {
                "type": "Footer",
                "label": "Part 1 done",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "screen": "PART_1",
                    "present": "${form.present}",
                    "p1_spoke": "${form.p1_spoke}",
                    "p1_picked": "${form.p1_picked}",
                    "p1_groups": "${form.p1_groups}",
                    "p1_listen": "${form.p1_listen}",
                    "p1_listen_other": "${form.p1_listen_other}",
                    "p1_materials": "${form.p1_materials}",
                    "p1_change": "${form.p1_change}",
                    "p1_change_how": "${form.p1_change_how}",
                    "p1_notes": "${form.p1_notes}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
