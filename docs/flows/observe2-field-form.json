                      },
                      {
                        "id": "once",
                        "title": "One child replied to another",
                        "description": "Once, a child answered or added to another child's idea."
                      },
                      {
                        "id": "often",
                        "title": "Replied to each other often",
                        "description": "Two or more times, children answered or added to each other's ideas."
                      },
                      {
                        "id": "agreed",
                        "title": "Disagreed, then agreed",
                        "description": "Children gave reasons, questioned each other and agreed on one answer."
                      }
                    ]
                  },
                  {
                    "type": "TextInput",
                    "name": "p2_listen_other",
                    "label": "Something else",
                    "required": false,
                    "helper-text": "What the children did, in a few words"
                  }
                ],
                "else": []
              },
              {
                "type": "RadioButtonsGroup",
