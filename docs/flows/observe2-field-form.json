    {
      "id": "LESSON_PLAN",
      "title": "Lesson plan",
      "data": {
        "lp_hint": {
          "type": "string",
          "__example__": "Rabia's most recent plans from the bot. If the plan isn't here, pick \"Upload new\" to add it."
        },
        "lp_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "asset-1",
              "title": "Comparing & ordering un…",
              "description": "Grade 4 Math · Ch5 Day 3 · p.79-81 · today"
            },
            {
              "id": "upload",
              "title": "Upload new",
              "description": "Photos of a paper plan, a PDF or Word file, or typed text"
            }
          ]
        },
        "error_messages": {
          "type": "object",
          "__example__": {}
        },
        "error": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "lesson_plan_form",
            "error-messages": "${data.error_messages}",
            "children": [
              {
                "type": "TextHeading",
                "text": "The lesson plan"
              },
              {
                "type": "TextCaption",
                "text": "So the recording can be checked against what the plan asked for."
              },
              {
                "type": "RadioButtonsGroup",
                "name": "lp",
                "label": "Was there a lesson plan?",
                "required": true,
                "data-source": [
                  {
                    "id": "used",
                    "title": "Followed a lesson plan"
                  },
                  {
                    "id": "notfollowed",
                    "title": "Had one, didn't follow it"
                  },
                  {
                    "id": "none",
                    "title": "No plan for this lesson"
                  }
                ]
              },
              {
                "type": "If",
                "condition": "${form.lp} != 'none'",
                "then": [
                  {
                    "type": "TextCaption",
                    "text": "${data.lp_hint}"
                  },
                  {
                    "type": "Dropdown",
                    "name": "lp_pick",
                    "label": "Which plan?",
                    "required": false,
                    "data-source": "${data.lp_options}"
                  },
                  {
                    "type": "If",
                    "condition": "${form.lp_pick} == 'upload'",
                    "then": [
                      {
                        "type": "RadioButtonsGroup",
                        "name": "lp_how",
                        "label": "How will you add it?",
                        "required": false,
                        "data-source": [
                          {
                            "id": "photos",
                            "title": "Photos of the paper plan",
                            "description": "One photo per page, up to 10."
                          },
                          {
                            "id": "file",
                            "title": "A PDF or Word file",
                            "description": "From the phone's files."
                          },
                          {
                            "id": "text",
                            "title": "Type it",
                            "description": "The steps the teacher planned, in order."
                          }
                        ]
                      }
                    ],
                    "else": []
                  }
                ],
                "else": []
              },
              {
                "type": "TextBody",
                "text": "${data.error}",
                "visible": "${data.has_error}"
              },
              {
                "type": "Footer",
                "label": "Next",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "screen": "LESSON_PLAN",
                    "lp": "${form.lp}",
                    "lp_pick": "${form.lp_pick}",
                    "lp_how": "${form.lp_how}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "LP_PHOTOS",
      "title": "Plan photos",
      "data": {
        "error_messages": {
