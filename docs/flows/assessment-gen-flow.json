        },
        "help_8": {
          "type": "string",
          "__example__": ""
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "counts_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Unseen questions: how many of each?"
              },
              {
                "type": "TextCaption",
                "text": "${data.summary}"
              },
              {
                "type": "TextBody",
                "text": "${data.error}",
                "visible": "${data.has_error}"
              },
              {
                "type": "TextInput",
                "name": "count_1",
                "label": "${data.label_1}",
                "required": false,
                "input-type": "number",
                "visible": "${data.show_1}",
                "helper-text": "${data.help_1}"
              },
              {
                "type": "TextInput",
                "name": "count_2",
                "label": "${data.label_2}",
                "required": false,
                "input-type": "number",
                "visible": "${data.show_2}",
                "helper-text": "${data.help_2}"
              },
              {
                "type": "TextInput",
                "name": "count_3",
                "label": "${data.label_3}",
                "required": false,
                "input-type": "number",
                "visible": "${data.show_3}",
                "helper-text": "${data.help_3}"
              },
              {
                "type": "TextInput",
                "name": "count_4",
                "label": "${data.label_4}",
                "required": false,
                "input-type": "number",
                "visible": "${data.show_4}",
                "helper-text": "${data.help_4}"
              },
              {
                "type": "TextInput",
                "name": "count_5",
                "label": "${data.label_5}",
                "required": false,
                "input-type": "number",
                "visible": "${data.show_5}",
                "helper-text": "${data.help_5}"
              },
              {
                "type": "TextInput",
                "name": "count_6",
                "label": "${data.label_6}",
                "required": false,
                "input-type": "number",
                "visible": "${data.show_6}",
                "helper-text": "${data.help_6}"
              },
              {
                "type": "TextInput",
                "name": "count_7",
                "label": "${data.label_7}",
                "required": false,
                "input-type": "number",
                "visible": "${data.show_7}",
                "helper-text": "${data.help_7}"
              },
              {
                "type": "TextInput",
                "name": "count_8",
                "label": "${data.label_8}",
                "required": false,
                "input-type": "number",
