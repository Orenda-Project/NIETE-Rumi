{
  "version": "7.0",
  "data_api_version": "3.0",
  "routing_model": {
    "CLASS": [
      "COVERAGE"
    ],
    "COVERAGE": [
      "PAGES",
      "QUESTIONS"
    ],
    "PAGES": [
      "QUESTIONS"
    ],
    "QUESTIONS": [
      "TYPES",
      "CONFIRM"
    ],
    "TYPES": [
      "CONFIRM"
    ],
    "CONFIRM": []
  },
  "screens": [
    {
      "id": "CLASS",
      "title": "New assessment",
      "data": {
        "grades": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "1",
              "title": "Grade 1"
            },
            {
              "id": "2",
              "title": "Grade 2"
            }
          ]
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "english",
              "title": "English"
            },
            {
              "id": "urdu",
              "title": "Urdu"
            }
          ]
        },
        "error": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "class_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Which class is this for?"
              },
              {
                "type": "TextBody",
                "text": "${data.error}",
                "visible": "${data.has_error}"
              },
              {
                "type": "Dropdown",
                "name": "grade",
                "label": "Grade",
                "required": true,
                "data-source": "${data.grades}"
              },
              {
                "type": "Dropdown",
                "name": "subject",
                "label": "Subject",
                "required": true,
                "data-source": "${data.subjects}"
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "grade": "${form.grade}",
                    "subject": "${form.subject}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "COVERAGE",
      "title": "New assessment",
      "data": {
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "1",
              "title": "1 · Hello World! (pages 4-14)"
            },
            {
              "id": "3",
              "title": "3 · Pinky's Yummy Tummy (pages 28-40)"
            }
          ]
        },
        "summary": {
          "type": "string",
          "__example__": "Grade 1 · English"
        },
        "has_chapters": {
          "type": "boolean",
          "__example__": true
        },
        "error": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "coverage_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Which chapter?"
              },
              {
                "type": "TextCaption",
                "text": "${data.summary}"
              },
              {
                "type": "TextBody",
                "text": "${data.error}",
                "visible": "${data.has_error}"
              },
              {
                "type": "Dropdown",
                "name": "chapter",
                "label": "Chapter",
                "required": false,
                "data-source": "${data.chapters}",
                "visible": "${data.has_chapters}"
              },
              {
                "type": "OptIn",
                "name": "use_pages",
                "label": "Type page numbers instead"
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "chapter": "${form.chapter}",
                    "use_pages": "${form.use_pages}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "PAGES",
      "title": "New assessment",
      "data": {
        "summary": {
          "type": "string",
          "__example__": "Grade 1 · English"
        },
        "hint": {
          "type": "string",
          "__example__": "This book has pages 1-166."
        },
        "error": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "pages_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Which pages?"
              },
              {
                "type": "TextCaption",
                "text": "${data.summary}"
              },
              {
                "type": "TextBody",
                "text": "${data.error}",
                "visible": "${data.has_error}"
              },
              {
                "type": "TextInput",
                "name": "page_ranges",
                "label": "Pages",
                "required": true,
                "input-type": "text",
                "helper-text": "${data.hint}"
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "page_ranges": "${form.page_ranges}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "QUESTIONS",
      "title": "New assessment",
      "data": {
        "summary": {
          "type": "string",
          "__example__": "Grade 1 · English · Chapter 1"
        },
        "error": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        },
        "count_hint": {
          "type": "string",
          "__example__": "Between 1 and 25."
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "questions_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "What kind of questions?"
              },
              {
                "type": "TextCaption",
                "text": "${data.summary}"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "content_source",
                "label": "Where questions come from",
                "required": true,
                "data-source": [
                  {
                    "id": "seen",
                    "title": "From the book"
                  },
                  {
                    "id": "unseen",
                    "title": "New questions on the same topics"
                  },
                  {
                    "id": "both",
                    "title": "A mix of both"
                  }
                ]
              },
              {
                "type": "TextInput",
                "name": "question_count",
                "label": "How many questions",
                "required": true,
                "input-type": "number",
                "helper-text": "${data.count_hint}"
              },
              {
                "type": "OptIn",
                "name": "pick_types",
                "label": "Choose question types myself"
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "content_source": "${form.content_source}",
                    "question_count": "${form.question_count}",
                    "pick_types": "${form.pick_types}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "TYPES",
      "title": "New assessment",
      "data": {
        "summary": {
          "type": "string",
          "__example__": "Grade 1 · English"
        },
        "types": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "MCQs",
              "title": "MCQs"
            },
            {
              "id": "Fill in the Blanks",
              "title": "Fill in the Blanks"
            }
          ]
        },
        "error": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "types_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Which kinds of question?"
              },
              {
                "type": "TextCaption",
                "text": "${data.summary}"
              },
              {
                "type": "TextBody",
                "text": "${data.error}",
                "visible": "${data.has_error}"
              },
              {
                "type": "CheckboxGroup",
                "name": "question_types",
                "label": "Question types",
                "required": true,
                "data-source": "${data.types}"
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "question_types": "${form.question_types}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CONFIRM",
      "title": "New assessment",
      "data": {
        "recap": {
          "type": "string",
          "__example__": "Grade 1 English\nChapter 1 · Hello World!\nNew questions · 20 questions"
        },
        "error": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        },
        "extension_message_response": {
          "type": "object",
          "properties": {
            "params": {
              "type": "object",
              "properties": {
                "assessment_action": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                }
              }
            }
          },
          "__example__": {
            "params": {
              "assessment_action": "queued",
              "summary": "Grade 4 Science · 20 questions"
            }
          }
        },
        "formats": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "pdf",
              "title": "PDF — ready to print"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "confirm_form",
            "init-values": {
              "output_format": "pdf"
            },
            "children": [
              {
                "type": "TextHeading",
                "text": "Ready?"
              },
              {
                "type": "TextBody",
                "text": "${data.recap}"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "output_format",
                "label": "File type",
                "required": true,
                "data-source": "${data.formats}"
              },
              {
                "type": "OptIn",
                "name": "answer_lines",
                "label": "Lines for the answers"
              },
              {
                "type": "OptIn",
                "name": "answer_key",
                "label": "Include an answer key"
              },
              {
                "type": "Footer",
                "label": "Make my paper",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "output_format": "${form.output_format}",
                    "answer_lines": "${form.answer_lines}",
                    "answer_key": "${form.answer_key}",
                    "extension_message_response": "${data.extension_message_response}"
                  }
                }
              }
            ]
          }
        ]
      },
      "terminal": true,
      "success": true
    }
  ]
}
