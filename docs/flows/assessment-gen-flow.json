              },
              {
                "type": "TextBody",
                "text": "${data.hint}"
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "count_1": "${form.count_1}",
                    "count_2": "${form.count_2}",
                    "count_3": "${form.count_3}",
                    "count_4": "${form.count_4}",
                    "count_5": "${form.count_5}",
                    "count_6": "${form.count_6}",
                    "count_7": "${form.count_7}",
                    "count_8": "${form.count_8}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CONFIRM",
      "title": "New assessment",
      "data": {
        "recap": {
          "type": "string",
          "__example__": "Grade 1 English\nChapter 1 · Hello World!\nNew questions · 20 questions"
        },
        "error": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        },
        "extension_message_response": {
          "type": "object",
          "properties": {
            "params": {
              "type": "object",
              "properties": {
                "assessment_action": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                }
              }
            }
          },
          "__example__": {
            "params": {
              "assessment_action": "queued",
              "summary": "Grade 4 Science · 20 questions"
            }
          }
        },
        "formats": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "pdf",
              "title": "PDF — ready to print"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "confirm_form",
            "init-values": {
              "output_format": "pdf"
            },
            "children": [
              {
                "type": "TextHeading",
                "text": "Ready?"
              },
              {
                "type": "TextBody",
                "text": "${data.recap}"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "output_format",
                "label": "File type",
                "required": true,
                "data-source": "${data.formats}"
              },
              {
                "type": "OptIn",
                "name": "answer_lines",
                "label": "Lines for the answers"
              },
              {
                "type": "OptIn",
                "name": "answer_key",
                "label": "Include an answer key"
              },
              {
                "type": "Footer",
                "label": "Make my paper",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "output_format": "${form.output_format}",
                    "answer_lines": "${form.answer_lines}",
                    "answer_key": "${form.answer_key}",
                    "extension_message_response": "${data.extension_message_response}"
                  }
                }
              }
            ]
          }
        ]
      },
      "terminal": true,
      "success": true
    }
  ]
}
