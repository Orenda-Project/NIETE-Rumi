        },
        "label_8": {
          "type": "string",
          "__example__": ""
        },
        "show_8": {
          "type": "boolean",
          "__example__": false
        },
        "help_1": {
          "type": "string",
          "__example__": "How many MCQs?"
        },
        "help_2": {
          "type": "string",
