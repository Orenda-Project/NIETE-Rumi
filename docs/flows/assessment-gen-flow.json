{
  "version": "7.2",
  "data_api_version": "3.0",
  "routing_model": {
    "CLASS": [
      "COVERAGE"
    ],
    "COVERAGE": [
      "PAGES",
      "QUESTIONS"
    ],
    "PAGES": [
      "QUESTIONS"
    ],
    "QUESTIONS": [
      "SEEN_COUNT",
      "TYPES"
    ],
    "TYPES": [
      "COUNTS"
    ],
    "CONFIRM": [],
    "COUNTS": [
      "CONFIRM"
    ],
    "SEEN_COUNT": [
      "TYPES",
      "CONFIRM"
    ]
  },
  "screens": [
    {
      "id": "CLASS",
      "title": "New assessment",
      "data": {
        "grades": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "1",
              "title": "Grade 1"
            },
            {
              "id": "2",
              "title": "Grade 2"
            }
          ]
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "english",
              "title": "English"
            },
            {
              "id": "urdu",
              "title": "Urdu"
            }
          ]
        },
        "error": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "class_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Which class is this for?"
              },
              {
                "type": "TextBody",
                "text": "${data.error}",
                "visible": "${data.has_error}"
              },
              {
                "type": "Dropdown",
                "name": "grade",
                "label": "Grade",
                "required": true,
                "data-source": "${data.grades}"
              },
              {
                "type": "Dropdown",
                "name": "subject",
                "label": "Subject",
                "required": true,
                "data-source": "${data.subjects}"
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "grade": "${form.grade}",
                    "subject": "${form.subject}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "COVERAGE",
      "title": "New assessment",
      "data": {
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "1",
              "title": "1 · Hello World! (pages 4-14)"
            },
            {
              "id": "3",
              "title": "3 · Pinky's Yummy Tummy (pages 28-40)"
            }
          ]
        },
        "summary": {
          "type": "string",
          "__example__": "Grade 1 · English"
        },
        "has_chapters": {
          "type": "boolean",
          "__example__": true
        },
        "error": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "coverage_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Which chapters?"
              },
              {
                "type": "TextCaption",
                "text": "${data.summary}"
              },
              {
                "type": "TextBody",
                "text": "${data.error}",
                "visible": "${data.has_error}"
              },
              {
                "type": "CheckboxGroup",
                "name": "chapters",
                "label": "Chapters",
                "description": "Tick every chapter the test should cover.",
                "required": false,
                "data-source": "${data.chapters}",
                "visible": "${data.has_chapters}",
                "max-selected-items": 6
              },
              {
                "type": "OptIn",
                "name": "use_pages",
                "label": "Type page numbers instead"
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "chapters": "${form.chapters}",
                    "use_pages": "${form.use_pages}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "PAGES",
      "title": "New assessment",
      "data": {
        "summary": {
          "type": "string",
          "__example__": "Grade 1 · English"
        },
        "hint": {
          "type": "string",
          "__example__": "This book has pages 1-166."
        },
        "error": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "pages_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Which pages?"
              },
              {
                "type": "TextCaption",
                "text": "${data.summary}"
              },
              {
                "type": "TextBody",
                "text": "${data.error}",
                "visible": "${data.has_error}"
              },
              {
                "type": "TextInput",
                "name": "page_ranges",
                "label": "Pages",
                "required": true,
                "input-type": "text",
                "helper-text": "${data.hint}"
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "page_ranges": "${form.page_ranges}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "QUESTIONS",
      "title": "New assessment",
      "data": {
        "summary": {
          "type": "string",
          "__example__": "Grade 1 · English · Chapter 1"
        },
        "error": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        },
        "marks_hint": {
          "type": "string",
          "__example__": "Optional — up to 500. Leave blank for no limit."
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "questions_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Seen or Unseen questions?"
              },
              {
                "type": "TextCaption",
                "text": "${data.summary}"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "content_source",
                "label": "Questions",
                "required": true,
                "data-source": [
                  {
                    "id": "seen",
                    "title": "Seen (from the book)"
                  },
                  {
                    "id": "unseen",
                    "title": "Unseen (outside the book)"
                  },
                  {
                    "id": "both",
                    "title": "Both Seen and Unseen"
                  }
                ]
              },
              {
                "type": "TextInput",
                "name": "total_marks",
                "label": "Total marks",
                "required": false,
                "input-type": "number",
                "helper-text": "${data.marks_hint}"
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "content_source": "${form.content_source}",
                    "total_marks": "${form.total_marks}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "SEEN_COUNT",
      "title": "New assessment",
      "data": {
        "summary": {
          "type": "string",
          "__example__": "Grade 4 · Science · Chapter 3"
        },
        "hint": {
          "type": "string",
          "__example__": "Between 1 and 25."
        },
        "error": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "seen_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Seen questions (from the book)"
              },
              {
                "type": "TextCaption",
                "text": "${data.summary}"
              },
              {
                "type": "TextBody",
                "text": "${data.error}",
                "visible": "${data.has_error}"
              },
              {
                "type": "TextInput",
                "name": "seen_count",
                "label": "How many Seen?",
                "required": true,
                "input-type": "number",
                "helper-text": "${data.hint}"
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "seen_count": "${form.seen_count}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "TYPES",
      "title": "New assessment",
      "data": {
        "summary": {
          "type": "string",
          "__example__": "Grade 1 · English"
        },
        "types": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "MCQs",
              "title": "MCQs"
            },
            {
              "id": "Fill in the Blanks",
              "title": "Fill in the Blanks"
            }
          ]
        },
        "error": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "types_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Unseen questions: which types?"
              },
              {
                "type": "TextCaption",
                "text": "${data.summary}"
              },
              {
                "type": "TextBody",
                "text": "${data.error}",
                "visible": "${data.has_error}"
              },
              {
                "type": "CheckboxGroup",
                "name": "question_types",
                "label": "Unseen question types",
                "required": true,
                "data-source": "${data.types}"
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "question_types": "${form.question_types}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "COUNTS",
      "title": "New assessment",
      "data": {
        "summary": {
          "type": "string",
          "__example__": "Grade 1 · English · Chapter 1"
        },
        "hint": {
          "type": "string",
          "__example__": "Up to 25 questions in total."
        },
        "error": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        },
        "label_1": {
          "type": "string",
          "__example__": "How many MCQs?"
        },
        "show_1": {
          "type": "boolean",
          "__example__": true
        },
        "label_2": {
          "type": "string",
          "__example__": ""
        },
        "show_2": {
          "type": "boolean",
          "__example__": false
        },
        "label_3": {
          "type": "string",
          "__example__": ""
        },
        "show_3": {
          "type": "boolean",
          "__example__": false
        },
        "label_4": {
          "type": "string",
          "__example__": ""
        },
        "show_4": {
