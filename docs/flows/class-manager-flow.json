{
  "version": "6.3",
  "data_api_version": "3.0",
  "routing_model": {
    "CLASSES": [
      "ADD",
      "ROSTER"
    ],
    "ADD": [
      "SUBJECTS"
    ],
    "SUBJECTS": [
      "SAVED",
      "ADD_STUDENTS"
    ],
    "ROSTER": [
      "ADD_STUDENTS",
      "REMOVE_STUDENTS"
    ],
    "ADD_STUDENTS": [
      "SAVED"
    ],
    "REMOVE_STUDENTS": [
      "SAVED"
    ],
    "SAVED": []
  },
  "screens": [
    {
      "id": "CLASSES",
      "title": "Your classes",
      "data": {
        "heading": {
          "type": "string",
          "__example__": "Your classes"
        },
        "summary": {
          "type": "string",
          "__example__": "Grade 4 - A · 2026-2027\nGrade 5 · 2026-2027"
        },
        "add_label": {
          "type": "string",
          "__example__": "Add a class"
        },
        "choose_label": {
          "type": "string",
          "__example__": "Which class?"
        },
        "next_label": {
          "type": "string",
          "__example__": "Next"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "uuid-1",
              "title": "Grade 4 - A"
            },
            {
              "id": "__add__",
              "title": "Add a new class"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "classes_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "${data.heading}"
              },
              {
                "type": "TextBody",
                "text": "${data.summary}"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "target",
                "label": "${data.choose_label}",
                "required": true,
                "data-source": "${data.options}"
              },
              {
                "type": "Footer",
                "label": "${data.next_label}",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "screen": "CLASSES",
                    "target": "${form.target}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ADD",
      "title": "Add a class",
      "data": {
        "heading": {
          "type": "string",
          "__example__": "Which class is this?"
        },
        "grade_label": {
          "type": "string",
          "__example__": "Class"
        },
        "section_label": {
          "type": "string",
          "__example__": "Section"
        },
        "section_helper": {
          "type": "string",
          "__example__": "Only if your school splits this class"
        },
        "next_label": {
          "type": "string",
          "__example__": "Next"
        },
        "grades": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "grade_4",
              "title": "Grade 4"
            },
            {
              "id": "grade_5",
              "title": "Grade 5"
            }
          ]
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "A",
              "title": "A"
            },
            {
              "id": "B",
              "title": "B"
            }
          ]
        },
        "shifts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "morning",
              "title": "Morning"
            },
            {
              "id": "evening",
              "title": "Evening"
            }
          ]
        },
        "shift_label": {
          "type": "string",
          "__example__": "Shift"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "add_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "${data.heading}"
              },
              {
                "type": "Dropdown",
                "name": "grade",
                "label": "${data.grade_label}",
                "required": true,
                "data-source": "${data.grades}"
              },
              {
                "type": "Dropdown",
                "name": "section",
                "label": "${data.section_label}",
                "required": false,
                "data-source": "${data.sections}"
              },
              {
                "type": "Dropdown",
                "name": "shift",
                "label": "${data.shift_label}",
                "required": true,
                "data-source": "${data.shifts}"
              },
              {
                "type": "Footer",
                "label": "${data.next_label}",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "screen": "ADD",
                    "grade": "${form.grade}",
                    "section": "${form.section}",
                    "shift": "${form.shift}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "SUBJECTS",
      "title": "What do you teach?",
      "data": {
        "heading": {
          "type": "string",
          "__example__": "What do you teach in Grade 4 - A?"
        },
        "subjects_label": {
          "type": "string",
          "__example__": "Subjects"
        },
        "class_teacher_label": {
          "type": "string",
          "__example__": "I am the class teacher"
        },
        "save_label": {
          "type": "string",
          "__example__": "Save"
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "maths",
              "title": "Mathematics"
            },
            {
              "id": "urdu",
              "title": "Urdu"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "subjects_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "${data.heading}"
              },
              {
                "type": "CheckboxGroup",
                "name": "subjects",
                "label": "${data.subjects_label}",
                "required": false,
                "data-source": "${data.subjects}"
              },
              {
                "type": "OptIn",
                "name": "is_class_teacher",
                "label": "${data.class_teacher_label}"
              },
              {
                "type": "Footer",
                "label": "${data.save_label}",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "screen": "SUBJECTS",
                    "subjects": "${form.subjects}",
                    "is_class_teacher": "${form.is_class_teacher}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ROSTER",
      "title": "Students",
      "data": {
        "heading": {
          "type": "string",
          "__example__": "Grade 4 - A"
        },
        "roster": {
          "type": "string",
          "__example__": "1. Ayesha Bibi\n2. Bilal Ahmed"
        },
        "choose_label": {
          "type": "string",
          "__example__": "What would you like to do?"
        },
        "next_label": {
          "type": "string",
          "__example__": "Next"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "add",
              "title": "Add students"
            },
            {
              "id": "remove",
              "title": "Remove students"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "roster_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "${data.heading}"
              },
              {
                "type": "TextBody",
                "text": "${data.roster}"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "action",
                "label": "${data.choose_label}",
                "required": true,
                "data-source": "${data.actions}"
              },
              {
                "type": "Footer",
                "label": "${data.next_label}",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "screen": "ROSTER",
                    "action": "${form.action}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ADD_STUDENTS",
      "title": "Add students",
      "data": {
        "heading": {
          "type": "string",
          "__example__": "Add students to Grade 4 - A"
        },
        "hint": {
          "type": "string",
          "__example__": "One per line. Numbering is fine."
        },
        "field_label": {
          "type": "string",
          "__example__": "Student names"
        },
        "save_label": {
          "type": "string",
          "__example__": "Add to class"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "add_students_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "${data.heading}"
              },
              {
                "type": "TextCaption",
                "text": "${data.hint}"
              },
              {
                "type": "TextArea",
                "name": "roster",
                "label": "${data.field_label}",
                "required": true
              },
              {
                "type": "Footer",
                "label": "${data.save_label}",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "screen": "ADD_STUDENTS",
                    "roster": "${form.roster}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "REMOVE_STUDENTS",
      "title": "Remove students",
      "data": {
        "heading": {
          "type": "string",
          "__example__": "Who has left Grade 4 - A?"
        },
        "hint": {
          "type": "string",
          "__example__": "Every teacher on this class stops seeing them."
        },
        "field_label": {
          "type": "string",
          "__example__": "Students"
        },
        "remove_label": {
          "type": "string",
          "__example__": "Remove"
        },
        "students": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "uuid-a",
              "title": "1. Ayesha Bibi"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "remove_students_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "${data.heading}"
              },
              {
                "type": "TextCaption",
                "text": "${data.hint}"
              },
              {
                "type": "CheckboxGroup",
                "name": "remove",
                "label": "${data.field_label}",
                "required": true,
                "data-source": "${data.students}"
              },
              {
                "type": "Footer",
                "label": "${data.remove_label}",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "screen": "REMOVE_STUDENTS",
                    "remove": "${form.remove}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "SAVED",
      "title": "Class saved",
      "terminal": true,
      "data": {
        "heading": {
          "type": "string",
          "__example__": "Class saved"
        },
        "detail": {
          "type": "string",
          "__example__": "Grade 4 - A, 2026-2027. You are the class teacher."
        },
        "done_label": {
          "type": "string",
          "__example__": "Done"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "${data.heading}"
          },
          {
            "type": "TextBody",
            "text": "${data.detail}"
          },
          {
            "type": "Footer",
            "label": "${data.done_label}",
            "on-click-action": {
              "name": "complete",
              "payload": {}
            }
          }
        ]
      }
    }
  ]
}
