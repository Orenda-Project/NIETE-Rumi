{
  "version": "6.3",
  "data_api_version": "3.0",
  "routing_model": {
    "CLASSES": [
      "ADD",
      "ROSTER"
    ],
    "ADD": [
      "SUBJECTS"
    ],
    "SUBJECTS": [
      "SAVED",
      "ROSTER"
    ],
    "ROSTER": [
      "SAVED"
    ],
    "SAVED": []
  },
  "screens": [
    {
      "id": "CLASSES",
      "title": "Your classes",
      "data": {
        "heading": {
          "type": "string",
          "__example__": "Your classes"
        },
        "summary": {
          "type": "string",
          "__example__": "Grade 4 - A · 2026-2027\nGrade 5 · 2026-2027"
        },
        "add_label": {
          "type": "string",
          "__example__": "Add a class"
        },
        "choose_label": {
          "type": "string",
          "__example__": "Which class?"
        },
        "next_label": {
          "type": "string",
          "__example__": "Next"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "uuid-1",
              "title": "Grade 4 - A"
            },
            {
              "id": "__add__",
              "title": "Add a new class"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "classes_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "${data.heading}"
              },
              {
                "type": "TextBody",
                "text": "${data.summary}"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "target",
                "label": "${data.choose_label}",
                "required": true,
                "data-source": "${data.options}"
              },
              {
                "type": "Footer",
                "label": "${data.next_label}",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "screen": "CLASSES",
                    "target": "${form.target}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ADD",
      "title": "Add a class",
      "data": {
        "heading": {
          "type": "string",
          "__example__": "Which class is this?"
        },
        "grade_label": {
          "type": "string",
          "__example__": "Class"
        },
        "section_label": {
          "type": "string",
          "__example__": "Section"
        },
        "section_helper": {
          "type": "string",
          "__example__": "Only if your school splits this class"
        },
        "next_label": {
          "type": "string",
          "__example__": "Next"
        },
        "grades": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "grade_4",
              "title": "Grade 4"
            },
            {
              "id": "grade_5",
              "title": "Grade 5"
            }
          ]
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "A",
              "title": "A"
            },
            {
              "id": "B",
              "title": "B"
            }
          ]
        },
        "shifts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "morning",
              "title": "Morning"
            },
            {
              "id": "evening",
              "title": "Evening"
            }
          ]
        },
        "shift_label": {
          "type": "string",
          "__example__": "Shift"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "add_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "${data.heading}"
              },
              {
                "type": "Dropdown",
                "name": "grade",
                "label": "${data.grade_label}",
                "required": true,
                "data-source": "${data.grades}"
              },
              {
                "type": "Dropdown",
                "name": "section",
                "label": "${data.section_label}",
                "required": false,
                "data-source": "${data.sections}"
              },
              {
                "type": "Dropdown",
                "name": "shift",
                "label": "${data.shift_label}",
                "required": true,
                "data-source": "${data.shifts}"
              },
              {
                "type": "Footer",
                "label": "${data.next_label}",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "screen": "ADD",
                    "grade": "${form.grade}",
                    "section": "${form.section}",
                    "shift": "${form.shift}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "SUBJECTS",
      "title": "What do you teach?",
      "data": {
        "heading": {
          "type": "string",
          "__example__": "What do you teach in Grade 4 - A?"
        },
        "subjects_label": {
          "type": "string",
          "__example__": "Subjects"
        },
        "class_teacher_label": {
          "type": "string",
          "__example__": "I am the class teacher"
        },
        "save_label": {
          "type": "string",
          "__example__": "Save"
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "maths",
              "title": "Mathematics"
            },
            {
              "id": "urdu",
              "title": "Urdu"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "subjects_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "${data.heading}"
              },
              {
                "type": "CheckboxGroup",
                "name": "subjects",
                "label": "${data.subjects_label}",
                "required": false,
                "data-source": "${data.subjects}"
              },
              {
                "type": "OptIn",
                "name": "is_class_teacher",
                "label": "${data.class_teacher_label}"
              },
              {
                "type": "Footer",
                "label": "${data.save_label}",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "screen": "SUBJECTS",
                    "subjects": "${form.subjects}",
                    "is_class_teacher": "${form.is_class_teacher}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ROSTER",
      "title": "Students",
      "data": {
        "heading": {
          "type": "string",
          "__example__": "Grade 4 - A"
        },
        "roster": {
          "type": "string",
          "__example__": "1. Aleeha Noor\n2. Bilal Ahmed"
        },
        "hint": {
          "type": "string",
          "__example__": "Tick anyone leaving, and paste any new names below."
        },
        "remove_label": {
          "type": "string",
          "__example__": "Remove from this class"
        },
        "has_students": {
          "type": "boolean",
          "__example__": true
        },
        "remove_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "s1",
              "title": "1. Aleeha Noor"
            }
          ]
        },
        "remove_label1": {
          "type": "string",
          "__example__": "Remove from this class"
        },
        "has_group1": {
          "type": "boolean",
          "__example__": true
        },
        "remove_options1": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "s1",
              "title": "1. Aleeha Noor"
            },
            {
              "id": "s2",
              "title": "2. Bilal Ahmed"
            }
          ]
        },
        "remove_label2": {
          "type": "string",
          "__example__": "Remove from class (21–40)"
        },
        "has_group2": {
          "type": "boolean",
          "__example__": true
        },
        "remove_options2": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "s21",
              "title": "21. Zainab Fatima"
            }
          ]
        },
        "remove_label3": {
          "type": "string",
          "__example__": "Remove from class (41–60)"
        },
        "has_group3": {
          "type": "boolean",
          "__example__": false
        },
        "remove_options3": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "s41",
              "title": "41. Hamza Tariq"
            }
          ]
        },
        "remove_label4": {
          "type": "string",
          "__example__": "Remove from class (61–80)"
        },
        "has_group4": {
          "type": "boolean",
          "__example__": false
        },
        "remove_options4": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "s61",
              "title": "61. Ayesha Khan"
            }
          ]
        },
        "remove_label5": {
          "type": "string",
          "__example__": "Remove from class (81–100)"
        },
        "has_group5": {
          "type": "boolean",
          "__example__": false
        },
        "remove_options5": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "s81",
              "title": "81. Usman Raza"
            }
          ]
        },
        "add_label": {
          "type": "string",
          "__example__": "Add students"
        },
        "add_hint": {
          "type": "string",
          "__example__": "One name per line."
        },
        "save_label": {
          "type": "string",
          "__example__": "Save changes"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "roster_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "${data.heading}"
              },
              {
                "type": "TextBody",
                "text": "${data.roster}"
              },
              {
                "type": "TextCaption",
                "text": "${data.hint}"
              },
              {
                "type": "CheckboxGroup",
                "name": "remove1",
                "label": "${data.remove_label1}",
                "required": false,
                "visible": "${data.has_group1}",
                "data-source": "${data.remove_options1}"
              },
              {
                "type": "CheckboxGroup",
                "name": "remove2",
                "label": "${data.remove_label2}",
                "required": false,
                "visible": "${data.has_group2}",
                "data-source": "${data.remove_options2}"
              },
              {
                "type": "CheckboxGroup",
                "name": "remove3",
                "label": "${data.remove_label3}",
                "required": false,
                "visible": "${data.has_group3}",
                "data-source": "${data.remove_options3}"
              },
              {
                "type": "CheckboxGroup",
                "name": "remove4",
                "label": "${data.remove_label4}",
                "required": false,
                "visible": "${data.has_group4}",
                "data-source": "${data.remove_options4}"
              },
              {
                "type": "CheckboxGroup",
                "name": "remove5",
                "label": "${data.remove_label5}",
                "required": false,
                "visible": "${data.has_group5}",
                "data-source": "${data.remove_options5}"
              },
              {
                "type": "TextArea",
                "name": "add",
                "label": "${data.add_label}",
                "required": false,
                "helper-text": "${data.add_hint}"
              },
              {
                "type": "Footer",
                "label": "${data.save_label}",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "screen": "ROSTER",
                    "remove1": "${form.remove1}",
                    "remove2": "${form.remove2}",
                    "remove3": "${form.remove3}",
                    "remove4": "${form.remove4}",
                    "remove5": "${form.remove5}",
                    "add": "${form.add}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "SAVED",
      "title": "Class saved",
      "terminal": true,
      "data": {
        "heading": {
          "type": "string",
          "__example__": "Class saved"
        },
        "detail": {
          "type": "string",
          "__example__": "Grade 4 - A, 2026-2027. You are the class teacher."
        },
        "done_label": {
          "type": "string",
          "__example__": "Done"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "${data.heading}"
          },
          {
            "type": "TextBody",
            "text": "${data.detail}"
          },
          {
            "type": "Footer",
            "label": "${data.done_label}",
            "on-click-action": {
              "name": "complete",
              "payload": {}
            }
          }
        ]
      }
    }
  ]
}
