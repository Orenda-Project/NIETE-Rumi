{
  "version": "7.0",
  "data_api_version": "3.0",
  "routing_model": {
    "LESSONS": [
      "LESSON"
    ],
    "LESSON": [
      "DONE"
    ],
    "DONE": []
  },
  "screens": [
    {
      "id": "LESSONS",
      "title": "${data.screen_title}",
      "data": {
        "screen_title": {
          "type": "string",
          "__example__": "Your lessons"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "main-content": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "metadata": {
                    "type": "string"
                  }
                }
              },
              "on-click-action": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "payload": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "__example__": [
            {
              "id": "00000000-0000-0000-0000-000000000001",
              "main-content": {
                "title": "5 Sep · Science",
                "description": "12 started",
                "metadata": "Electric circuits and how a switch works"
              },
              "on-click-action": {
                "name": "data_exchange",
                "payload": {
                  "step": "lesson",
                  "session_id": "00000000-0000-0000-0000-000000000001"
                }
              }
            },
            {
              "id": "__older__",
              "main-content": {
                "title": "Older lessons…",
                "description": "Page 2",
                "metadata": "The next 18, going further back"
              },
              "on-click-action": {
                "name": "data_exchange",
                "payload": {
                  "step": "page",
                  "page": "2"
                }
              }
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "NavigationList",
            "name": "lesson_list",
            "list-items": "${data.items}"
          }
        ]
      }
    },
    {
      "id": "LESSON",
      "title": "${data.screen_title}",
      "data": {
        "screen_title": {
          "type": "string",
          "__example__": "This lesson"
        },
        "heading": {
          "type": "string",
          "__example__": "Electric circuits and how a switch works"
        },
        "subline": {
          "type": "string",
          "__example__": "5 Sep · Science · 12 started"
        },
        "results": {
          "type": "string",
          "__example__": "12 started · 9 finished · average 71%\n\nHow each student did\n• Ayesha (5-A) — 7/8 (88%)\n• Bilal (5-A) — 5/8 (63%)\n\nStill going: Danish, Hira, Imran"
        },
        "actions_label": {
          "type": "string",
          "__example__": "What next?"
        },
        "actions_visible": {
          "type": "boolean",
          "__example__": true
        },
        "action_required": {
          "type": "boolean",
          "__example__": true
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "report",
              "title": "Generate report",
              "description": "Counted again right now — everyone who has finished since the last report is in it."
            },
            {
              "id": "link",
              "title": "Resend link",
              "description": "The PDF, then the message to forward — the same link as before, never a new one."
            }
          ]
        },
        "cta": {
          "type": "string",
          "__example__": "Continue"
        },
        "session_id": {
          "type": "string",
          "__example__": "00000000-0000-0000-0000-000000000001"
        },
        "quiz_id": {
          "type": "string",
          "__example__": "00000000-0000-0000-0000-000000000002"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "lesson_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "${data.heading}"
              },
              {
                "type": "TextCaption",
                "text": "${data.subline}"
              },
              {
                "type": "TextBody",
                "text": "${data.results}"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "tq_action",
                "label": "${data.actions_label}",
                "data-source": "${data.actions}",
                "required": true
              },
              {
                "type": "Footer",
                "label": "${data.cta}",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "step": "action",
                    "tq_action": "${form.tq_action}",
                    "session_id": "${data.session_id}",
                    "quiz_id": "${data.quiz_id}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "DONE",
      "title": "${data.screen_title}",
      "terminal": true,
      "success": true,
      "data": {
        "screen_title": {
          "type": "string",
          "__example__": "On its way"
        },
        "heading": {
          "type": "string",
          "__example__": "Your report is on its way"
        },
        "body": {
          "type": "string",
          "__example__": "Recounting now. The report will arrive in your chat in a minute or two."
        },
        "close": {
          "type": "string",
          "__example__": "Close"
        },
        "kind": {
          "type": "string",
          "__example__": "report"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "${data.heading}"
          },
          {
            "type": "TextBody",
            "text": "${data.body}"
          },
          {
            "type": "Footer",
            "label": "${data.close}",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "tq_action": "${data.kind}"
              }
            }
          }
        ]
      }
    }
  ]
}
