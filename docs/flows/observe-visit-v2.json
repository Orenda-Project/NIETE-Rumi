     "__example__": "In the debrief, pick just ONE thing to work on with her — and open with a genuine strength."
    },
    "guidance_text": {
     "type": "string",
     "__example__": "This is guidance to support your visit — not a grade or a ranking."
    },
    "teacher_ext_id": {
     "type": "string",
     "__example__": "t1"
    },
    "school_ext_id": {
     "type": "string",
     "__example__": "s1"
    }
   },
   "layout": {
    "type": "SingleColumnLayout",
    "children": [
     {
      "type": "TextHeading",
      "text": "${data.teacher_name}"
     },
     {
      "type": "TextSubheading",
      "text": "${data.subtitle}"
     },
     {
      "type": "TextBody",
      "text": "${data.strength_text}"
     },
     {
      "type": "TextBody",
      "text": "${data.growth_text}"
     },
     {
      "type": "TextSubheading",
      "text": "${data.moves_intro}"
     },
     {
      "type": "TextBody",
      "text": "${data.moves_text}"
     },
     {
      "type": "TextBody",
      "text": "${data.trend_text}"
     },
     {
      "type": "TextBody",
      "text": "${data.debrief_reminder}"
     },
     {
      "type": "TextCaption",
      "text": "${data.guidance_text}"
     },
     {
      "type": "Footer",
      "label": "Start observation",
      "on-click-action": {
       "name": "complete",
       "payload": {
        "step": "start",
        "teacher_ext_id": "${data.teacher_ext_id}",
        "school_ext_id": "${data.school_ext_id}"
       }
      }
     }
    ]
   }
  },
  {
   "id": "SUCCESS",
   "title": "Done",
   "terminal": true,
   "success": true,
   "data": {
    "extension_message_response": {
     "type": "object",
     "properties": {
      "params": {
       "type": "object"
      }
     },
     "__example__": {
      "params": {
       "observe_visit_action": "done"
      }
     }
    },
    "heading": {
     "type": "string",
     "__example__": "Observation scheduled"
    },
    "body": {
     "type": "string",
     "__example__": "Tap /observe anytime to see your schedule."
    }
   },
   "layout": {
    "type": "SingleColumnLayout",
    "children": [
     {
      "type": "TextHeading",
      "text": "${data.heading}"
     },
     {
      "type": "TextBody",
      "text": "${data.body}"
     }
    ]
   }
  }
 ]
}