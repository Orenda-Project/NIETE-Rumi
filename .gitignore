# Flow asset backups written by bot/scripts/setup/republish-flow.js. These are
# point-in-time dumps of what Meta was serving, kept locally as a rollback
# artifact — not source, and per-environment, so they must not be committed.
bot/scripts/setup/assets/backups/

# Worktree tooling: claude-on-bead.sh symlinks .beads/ to the parent project so a
# worktree shares the beads ledger. It is a machine-absolute symlink and must never
# be committed — it breaks every clone.
.beads

# bd-2540 working notes (accidentally committed in Phase 1b)
.plans/
.baseline-failing-*.txt

# Migration run artifacts — contain user UUIDs. Local evidence, never source.
.migration-snapshots/

# data-standards local state (machine-local; never committed).
