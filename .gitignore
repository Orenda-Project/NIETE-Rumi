# Dependencies
node_modules/
.pnp
.pnp.js
bun.lockb

# Environment variables - NEVER commit these
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging
# Catch-all: the list above is exact filenames, so copies and backups
# (.env.bak-<ts>, .env.old, .env.2) were NOT covered. One such backup —
# 91 keys including the Supabase service-role key — sat untracked in this
# repo for four days, one `git add .` from being committed. Keep the glob.
.env.*
# ...but the templates are meant to be committed.
!.env.template
!.env.example

# Secrets and credentials
keys/
*.pem
*.key
*.cert
*.p12
credentials*
service-account*.json
.railway-token

# Setup state (generated during /setup)
.setup-state.json

# Temporary files
temp/
tmp/
*.tmp
*.zip

# Build outputs
dist/
build/
.next/
out/

# Exception: dashboard serves the portal SPA from this pre-built dist folder at runtime.
# Rebuild flow: cd portal && npm ci && npm run build && cp -r dist ../dashboard/portal-frontend/
!dashboard/portal-frontend/dist/
!dashboard/portal-frontend/dist/**

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Debug and logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
bot/logs/

# Testing
coverage/
.nyc_output/

# Script output files
bot/scripts/output/

# OS generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# Claude Code local files
.claude/ralph-loop.local.md
claude-progress.txt

# Redis dump
dump.rdb

# Docker
.docker/

# Supabase local
.supabase/
supabase/.temp/
**/supabase/.temp/
dashboard/supabase/.temp/
.env.provisioner

# Capacitor Android build artifacts + local build config (bd-2343/bd-2351).
# The generated android/ project is committed, but never build output,
# local SDK paths, or signing material.
portal/android/build/
portal/android/app/build/
portal/android/.gradle/
portal/android/local.properties
portal/android/keystore.properties
portal/android/app/src/main/assets/public/
portal/.env.app
portal/.android-env.sh
*.jks
*.keystore
.staging-bootstrap/

# Python build artifacts (the repo has a few scripts/ helpers)
__pycache__/
*.pyc

# Flow asset backups written by bot/scripts/setup/republish-flow.js. These are
# point-in-time dumps of what Meta was serving, kept locally as a rollback
# artifact — not source, and per-environment, so they must not be committed.
bot/scripts/setup/assets/backups/
