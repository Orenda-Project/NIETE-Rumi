# Dependencies
node_modules/
.pnp
.pnp.js
bun.lockb

# Environment variables - NEVER commit these
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging
# Catch-all: the list above is exact filenames, so copies and backups
# (.env.bak-<ts>, .env.old, .env.2) were NOT covered. One such backup —
# 91 keys including the Supabase service-role key — sat untracked in this
# repo for four days, one `git add .` from being committed. Keep the glob.
.env.*
# ...but the templates are meant to be committed.
!.env.template
!.env.example

# Secrets and credentials
keys/
*.pem
*.key
*.cert
*.p12
credentials*
service-account*.json
.railway-token

# Setup state (generated during /setup)
.setup-state.json

# Temporary files
temp/
tmp/
*.tmp
*.zip

# Build outputs
dist/

# ...except the katex stub's dist/, which is a TEST FIXTURE and not build output.
# bot/vendor/lp-v9/lib/fonts.js inlines katex's stylesheet by resolving the package's
# own package.json and reading ../dist/katex.min.css beside it, so the stub has to sit at
# exactly this path. Without it every test that calls buildHtml() dies on ENOENT.
!tests/__mocks__/katex-stub/dist/
!tests/__mocks__/katex-stub/dist/katex.min.css
build/
.next/
out/

# bd-2555: dashboard/portal-frontend/dist is NO LONGER committed.
#
# It used to be force-included here (`!dashboard/portal-frontend/dist/**`) so a
# laptop-built, hand-copied bundle could be served by express.static. That made
# shipping a portal change depend on a human remembering to rebuild and copy —
# and when it was forgotten the PR still merged green while production kept
# serving the old bundle. On 2026-08-12 prod and staging were both 122KB behind
# the source, leaving the i18n Phase 5.x work half-live.
#
# Railway now builds it: `npm run build:portal` (see railpack.portal.json).
# Do NOT re-add a negation here — a committed build output is a build output
# that goes stale silently.

