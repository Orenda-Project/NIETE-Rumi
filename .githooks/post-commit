#!/usr/bin/env bash
# Shim. git runs this (core.hooksPath=.githooks); the harness itself is the SHARED engine, authored in
# rumi-agent-home and linked in at .claude/qa/engine by scripts/qa/link-engine.sh, which `npm install` runs.
# No engine on this machine means there is nothing to arm — and never a blocked commit.
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
H="$ROOT/.claude/qa/engine/githooks/post-commit"
[ -f "$H" ] || exit 0
exec bash "$H" "$@"
