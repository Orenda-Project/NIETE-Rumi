#!/bin/bash
# pre-push — before code leaves this machine, say what it will need.
#
# For EVERY ref being pushed this runs the impact analysis (scripts/qa/impact.py)
# over exactly the commits the push sends, and prints: the affected features,
# whether their Gherkin specs were synced in that range, and the commands.
#
# Until 2026-09-09 only develop/main/staging were watched and feature-branch
# pushes were silent, because "nothing deploys from them". Two things made that
# wrong: the landing branch became `sandbox` (not in the list), and every real
# PR is pushed from a feature branch and merged in the GitHub UI — so the one
# push a developer actually makes was the one push that said nothing (NIETE-Rumi
# PRs #835/#836 reached sandbox with stale coaching specs and no E2E). Now every
# push reports, and the base for a brand-new branch is its merge-base with
# origin/sandbox (then develop, then main).
#
# ADVISORY by default: exit 0 whatever it finds, so a stale spec is a warning at
# push time, never a locked terminal. QA_HOOKS_STRICT=1 makes a stale spec block
# the push locally. The server-side counterpart is .github/workflows/qa-impact.yml,
# which runs the same analysis on the PR and DOES fail on a stale spec.
#
# Off: QA_HOOKS_OFF=1     Strict: QA_HOOKS_STRICT=1
[ "${QA_HOOKS_OFF:-}" = "1" ] && exit 0
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
command -v python3 >/dev/null 2>&1 || { echo "qa: python3 not on PATH — pre-push impact report skipped" >&2; exit 0; }
IMPACT="$ROOT/scripts/qa/impact.py"
[ -f "$IMPACT" ] || exit 0
ZERO=0000000000000000000000000000000000000000
MODE=warn; [ "${QA_HOOKS_STRICT:-}" = "1" ] && MODE=block
RC=0
while read -r _lref lsha rref rsha; do
  [ -n "${rref:-}" ] || continue
  case "$rref" in refs/heads/*) ;; *) continue ;; esac   # tags etc. carry no review
  [ "$lsha" = "$ZERO" ] && continue                       # a branch deletion
  base="$rsha"
  if [ "$rsha" = "$ZERO" ]; then                          # first push of this branch
    base=""
    for ref in origin/sandbox origin/develop origin/main; do
      base=$(git merge-base "$lsha" "$ref" 2>/dev/null) && [ -n "$base" ] && break
      base=""
    done
    [ -n "$base" ] || continue
  fi
  out=$(python3 "$IMPACT" --repo "$ROOT" --base "$base" --head "$lsha" \
          --target-branch "${rref#refs/heads/}" --format text --freshness "$MODE" --proof off 2>/dev/null)
  rc=$?
  [ -n "$out" ] && printf '%s\n' "$out" >&2
  [ "$rc" -ne 0 ] && RC=1
done
[ "$MODE" = "block" ] && exit $RC
exit 0
