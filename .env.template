# ─── Feedback-uptake loop (coaching) ────────────────────────────────────────
# Carries the ONE thing a teacher was asked to try into her next observation,
# tallies uptake inside the existing scoring call, re-angles the ask until it
# lands, and surfaces the open target to her coach. Unset = off (the pipeline,
# the record and every surface are byte-identical to the loop-less build).
# Set on the web service AND both SQS workers. true|1 = on.
# UPTAKE_LOOP_ENABLED=true

# ─── Live voice calls ───────────────────────────────────────────────────────
# Calls run in their OWN service (`node bot/calls-server.js`), not in the bot.
# The bot owns the single public webhook Meta posts to, recognises a calls
# payload and forwards it over private networking; a calls payload never enters
# message handling. So these vars split across two services:
#
#   ON THE BOT      CALLS_SERVICE_URL + CALLS_FORWARD_SECRET (+ the timeout)
#   ON THE CALLS    everything else, including CALLS_ENABLED
#
# Everything below is OPTIONAL and every value shown is the code default, so an
# unset deployment simply has no calls. The one non-negotiable is CALLS_ENABLED:
# calls are OFF unless it is the exact string "true".

# --- on the BOT service: the forward ---
# Private-network URL of the calls service. Blank = the bot forwards nothing,
# which is the correct setting for any deployment not running calls.
CALLS_SERVICE_URL=
# Shared secret authenticating bot → calls. The forward FAILS CLOSED: with no
# secret nothing is forwarded, because anything that can reach the public webhook
# could otherwise make us dial Graph and burn call slots. Generate per env.
CALLS_FORWARD_SECRET=
# How long the bot waits on the calls service before abandoning a forward. The
# forward is fire-and-forget, so this cannot delay the webhook 200 — it bounds
# the sockets left behind by a calls service that accepts and never answers.
CALLS_FORWARD_TIMEOUT_MS=3000

# --- on the CALLS service: the master switch ---
# Calls are OFF unless this is exactly "true". Deploy the service with this
# unset first, confirm it boots and idles, and flip it as a separate step.
CALLS_ENABLED=

# --- the realtime model ---
# Falls back to OPENAI_API_KEY when OPENAI_REALTIME_API_KEY is unset. Give calls
# their own key where you want per-minute spend attributable and separately
# capped — realtime audio bills differently from text.
OPENAI_REALTIME_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
# Turn detection. server_vad ships by default for the latency win;
# CALLS_VAD=semantic_vad hands turn-taking to the model, which interrupts less
# over a noisy line. CALLS_VAD_EAGERNESS (low|auto|high) applies to semantic_vad
# only; CALLS_VAD_SILENCE_MS is the server_vad turn-end window.
CALLS_VAD=server_vad
CALLS_VAD_EAGERNESS=auto
CALLS_VAD_SILENCE_MS=500
CALLS_REASONING_EFFORT=minimal
CALLS_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# The cheap model that folds a finished call into the caller's rolling memory.
CALLS_MEMORY_MODEL=gpt-4o-mini

# --- limits, and the budget governor ---
# These are the blast radius. The governor refuses a call past any of them and
# FAILS CLOSED — if it cannot read the ledger it declines rather than guesses.
# On a fleet-wide rollout, start well below what you think you need.
CALLS_MAX_CONCURRENT=5
CALLS_MAX_SECONDS=300
# Wrap-up cue, so a long call gets a goodbye instead of a mid-sentence hangup.
# Clamped to 90% of CALLS_MAX_SECONDS if set at or above it.
CALLS_WRAPUP_SECONDS=270
CALLS_WEEKLY_BUDGET_USD=150
CALLS_PER_CALLER_DAILY=3
CALLS_SILENCE_TIMEOUT_MS=60000
# Grace period for in-flight calls when the service is asked to shut down.
CALLS_DRAIN_GRACE_MS=60000
# Only needed where the platform does not set RAILWAY_REPLICA_COUNT; the
# concurrency cap is divided across replicas so N instances do not each admit
# CALLS_MAX_CONCURRENT calls.
CALLS_REPLICA_COUNT=

# --- the voice engine ---
# Which engine SPEAKS. 'openai' (default) = the native realtime voice. 'uplift' =
# OpenAI still does STT, reasoning and every tool call but emits TEXT, and Uplift
# AI speaks it — markedly more natural in Urdu. The assistant can do exactly the
# same things either way; only the mouth changes.
#
# Selection is per CALL, not per deploy. Uplift is used only when it is selected,
# a key is present, the socket comes up in time, AND the caller's language is one
# the voice model speaks. Anything else silently keeps the OpenAI voice, which is
# the known-good path.
VOICE_PROVIDER=openai
# NOTE: the key is UPLIFT_API_KEY, documented once in the TTS block above — the
# same Uplift account already speaks Sindhi and Balochi voice notes. Calls do not
# get a second key.
#
# The voice calls speak with. Leave BLANK to use the product's existing Urdu
# voice (UPLIFT_VOICE_ID_UR above), so a teacher hears one Rumi voice whether she
# reads a voice note or rings up. Set it only to give calls a different voice —
# e.g. v_meklc281, which is the conversational voice the calls prototype used.
# IDs are not published in the docs; read them from the Uplift dashboard.
UPLIFT_VOICE_ID=
UPLIFT_WS_URL=wss://api.upliftai.org/text-to-speech/multi-stream
# Which call languages the external voice may speak, comma separated. Urdu only
# by default, because Uplift models Urdu/Sindhi/Balochi — an English reply through
# an Urdu voice is an Urdu-accented mangling of English. Set ur,en to hear that
# for yourself and judge it. A caller whose language is not listed keeps the
# OpenAI voice; the call is never refused over this.
UPLIFT_LANGUAGES=ur

# --- ambience ---
# A quiet room tone under the call. Set CALLS_AMBIENCE_ENABLED=false for silence.
CALLS_AMBIENCE_ENABLED=true
CALLS_AMBIENCE_OFFICE_VOLUME=
CALLS_AMBIENCE_KEYBOARD_VOLUME=
