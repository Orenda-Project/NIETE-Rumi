# names → labels. Example:
#   REGION_COACH_ROLE_LABEL_MAP={"niete":"Human Coach","tanzania":"Rumi"}
DEFAULT_COACH_ROLE_LABEL=
REGION_COACH_ROLE_LABEL_MAP=

