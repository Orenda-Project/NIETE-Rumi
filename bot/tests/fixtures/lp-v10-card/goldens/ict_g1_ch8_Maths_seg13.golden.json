   "title": "Connect and Create: Measurement Art",
   "goal": "Children <b>compare</b> and order things by length, lined up at one end."
  },
  "bring": "textbook p.218 · leaves, twigs, paper, glue",
  "words": [
   "length",
   "non-standard unit",
   "longer",
   "shorter"
  ],
  "sections": [
   {
    "sec": "open",
    "minutes": 4,
    "moves": [
     {
      "covers": [
       "m1",
       "m2",
       "m3"
      ],
      "do": "Open p.218: car or bicycle, which is LONGER? Dots 4, 7.",
      "how": "Flash: “7 is 4 and ___?” Post: length, unit.",
      "say": "“7 is 4 and … 3!” What at home could you measure with fingers?",
      "sense": true,
      "yesterday": "Yesterday: temperature by ticks. What do we read on a thermometer? (a number)"
     }
    ]
   },
   {
    "sec": "explain",
    "minutes": 7,
    "moves": [
     {
      "covers": [
       "m4",
       "m5"
      ],
      "do": "Draw car, bicycle level at one end; chalk, duster.",
      "how": "Chalk is 3 finger-widths. Why is duster longer?",
      "say": "“Line up at ONE end first.”",
      "think": "I line both at one end. The duster reaches further, so it is longer. I check: same start, then compare."
     }
    ]
   },
   {
    "sec": "we",
    "minutes": 12,
    "moves": [
     {
      "covers": [
       "m6"
      ],
      "chip": "I START, YOU FINISH",
      "do": "Lay finger-widths along a twig; class counts 1 to 5.",
      "how": "Class finishes: “Five finger-widths!” Show three strips.",
      "say": "“One, two, three, four …” → class: “five!”"
     },
     {
      "covers": [
       "m7",
       "m8"
      ],
      "chip": "ONE NEIGHBOUR TURN",
      "do": "One minute: order 3 strips; neighbour counts the longest.",
      "how": "Fatima and Ahmed show it first. Check 5 desks.",
      "say": "“Do you agree? Line them up.”",
      "turn": {
       "first": "Taller child",
       "a": "My shortest is ___, my longest is ___.",
       "b": "Lined up, yes. The longest is ___ finger-widths.",
       "stop": "one clap, eyes on me"
      }
     }
    ]
   },
   {
    "sec": "you",
    "minutes": 13,
    "moves": [
     {
      "covers": [
       "m9"
      ],
      "clock": "⏱ 23′ stop explaining",
      "do": "Alone, p.218: 1. Car vs bicycle 2. Order, glue 3. Count a twig",
      "how": "Done? Longest minus shortest twig: how many more?",
      "say": "“Order first, then measure, then glue.”"
     }
    ],
    "answers": [
     [
      "1.",
      "longer"
     ],
     [
      "2.",
      "Own items, true shortest to longest"
     ],
     [
      "3.",
      "Own honest count, e.g. 6"
     ],
     [
      "Harder",
      "Longest minus shortest"
     ]
    ],
    "mistake": "Not lined up. <b>Ask:</b> “Where do both start?”",
    "stuck": "Two things at a time, lined up."
   },
   {
    "sec": "check",
    "minutes": 4,
    "moves": [
     {
      "covers": [
       "m10"
      ],
      "do": "Bottle or lunch box: which is longer? What is the same?",
      "say": "“Which is longer? Tell me how you compared.”"
     }
    ],
    "correct": "Longer or shorter correct; same = lined up at one end.",
    "success": "I can compare two things and say how I compared them.",
    "ask": "What do you do first when you compare two things?",
    "listen": "Line both at one end; which reaches further."
   },
   {
    "sec": "hw",
    "minutes": 0,
    "moves": [
     {
      "covers": [
       "m11"
      ],
      "do": "Find two things; say which is longer; ask family.",
      "say": "“Line them up first.”"
     }
    ]
   }
  ],
