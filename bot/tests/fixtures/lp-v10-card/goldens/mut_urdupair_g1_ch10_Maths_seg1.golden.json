      "how": "Billboard 4; STOP board 4; clock 0; sign 3.",
      "say": "“Trace, count sides, touch corners, name.”",
      "think": "I trace the billboard: 1, 2, 3, 4 sides, 4 corners. Opposite sides equal, so a rectangle. I check: no curves."
     }
    ]
   },
   {
    "sec": "we",
    "minutes": 12,
    "moves": [
     {
      "covers": [
       "m3"
      ],
      "chip": "I START, YOU FINISH",
      "do": "Trace a p.244 roof; class counts sides and names it.",
      "how": "Then the clock: 0 sides, 0 corners.",
      "say": "“I trace the roof: 1, 2, 3 sides. It is a …” → “triangle!”"
     },
     {
      "covers": [
       "m3",
       "m4"
      ],
      "chip": "ONE NEIGHBOUR TURN",
      "do": "Trace one picture object; your neighbour names its shape.",
      "how": "Frame: “It has ___ sides and ___ corners.” Ayesha and Bilal show it first.",
      "say": "“Count first, then name.”",
      "turn": {
       "first": "Window side",
       "a": "I traced it: 3 sides, 3 corners. What shape?",
       "b": "A triangle, because it has 3 sides and 3 corners.",
       "stop": "one clap, eyes on me"
      }
     },
     {
      "covers": [
       "m3"
      ],
      "do": "Draw a rectangle, square, circle, triangle in your book.",
      "how": "Write sides and corners beside each; check 5 books."
     }
    ]
   },
   {
    "sec": "you",
