  "html": "<!doctype html>\n<html lang=\"en\" dir=\"ltr\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"color-scheme\" content=\"light\">\n<title>G1 Maths Ch.10 Day 1 Card</title>\n<style>\n/* Phone-first teacher card: one column, sized for a 360-390 px screen; prints on one 520 x 2000 page.\n   Single light look on purpose (the v17 section colours Amena approved, 9 Oct). */\n:root{--navy:#26324A;--ink:#1F2430;--mut:#55606F;--line:#DDE1E8;--paper:#FFFFFF;--ground:#EEF0F3;\n--open:#E07B00;--explain:#8A45F0;--we:#3B5BDB;--you:#2B8A3E;--check:#C2255C;--hw:#0B7285;--star:#F2B705;\n--body:system-ui,-apple-system,\"Segoe UI\",Roboto,\"Noto Sans\",sans-serif;color-scheme:light}\n*{box-sizing:border-box}\nhtml,body{margin:0;background:var(--ground);color:var(--ink)}\nbody{font:17px/1.45 var(--body);-webkit-text-size-adjust:100%}\n.page{max-width:480px;margin:0 auto;background:var(--paper);padding:12px 14px 16px;display:flex;flex-direction:column;gap:12px}\na{color:inherit}\n.hd{background:var(--navy);color:#fff;border-radius:14px;padding:12px 14px 14px}\n.hd .k{display:flex;flex-wrap:wrap;justify-content:space-between;gap:2px 10px;font-weight:700;font-size:13.5px;letter-spacing:.03em}\n.hd .k b{color:#FFC34D}\n.hd h1{font-size:22px;line-height:1.25;margin:6px 0 6px;text-wrap:balance}\n.hd .goal{font-size:15.5px;opacity:.95}\n.info{display:grid;grid-template-columns:auto 1fr;gap:4px 12px;font-size:15.5px}\n.info b{color:var(--mut);font-size:12.5px;letter-spacing:.06em;text-transform:uppercase;padding-top:3px}\n.time .pr{display:flex;font:700 12.5px/1 var(--body);color:var(--ink);margin-bottom:4px}\n.time .pr span{min-width:44px;text-align:center;border-bottom:2.5px solid var(--ink);padding-bottom:3px}\n.bar{display:flex;height:30px;border-radius:8px;overflow:hidden;font:800 14px/1 var(--body);color:#fff}\n.bar span{display:flex;align-items:center;justify-content:center;border-right:2px solid #fff;min-width:44px}\n.bar span:last-child{border:0}\n.lab{display:flex;font-size:12px;color:var(--mut);margin-top:3px}.lab span{text-align:center;min-width:44px;white-space:nowrap}\n.star{border:2.5px solid var(--star);background:#FFF6D6;border-radius:12px;padding:10px 12px;font-size:16px}\n.star .l{font-weight:800;color:#7A4F00}\n.sec{border:1px solid color-mix(in srgb,var(--c) 28%,#fff);border-inline-start:7px solid var(--c);border-radius:12px;\n background:color-mix(in srgb,var(--c) 6%,#fff);padding:10px 12px 12px}\n.sec.mark{box-shadow:0 0 0 3px var(--star)}\n/* one row: a long title wraps inside itself, so Full details never drops under the heading (judge 10F) */\n.sh{display:flex;gap:2px 8px}\n.sh h2{margin:0;font-size:19px;color:var(--c);flex:0 1 auto;min-width:0}\n.sh .t{flex:none;white-space:nowrap}.sh .fd{flex:none;margin-left:auto}\n/* phone: the time drops under the title so the title keeps one line beside Full details (judge pilot4 10D) */\n@media screen and (max-width:420px){.sh{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center}.sh h2{white-space:nowrap;font-size:17.5px}.sh .t{grid-row:2;grid-column:1}.sh .fd{grid-row:1/span 2;grid-column:2}}\n.sh .t{font-weight:700;font-size:14px;color:var(--mut);font-variant-numeric:tabular-nums}\n.mv{display:grid;grid-template-columns:30px 1fr;gap:10px;margin-top:10px}\n.mv p{margin:0;min-width:0}.mv .do{font-weight:700}\n.n{width:28px;height:28px;border-radius:999px;background:var(--c);color:#fff;font:800 15px/28px var(--body);text-align:center}\n.say{display:block;margin-top:3px;font-style:italic}\n.ex{display:block;margin-top:3px}\n.say::before{content:\"Say: \";font-style:normal;font-weight:800;color:var(--c)}\n.chip{display:inline-block;font:800 12px/1 var(--body);letter-spacing:.03em;color:#fff;background:var(--c);border-radius:6px;padding:5px 7px;margin:0 0 4px}\n.clock{display:inline-block;font-weight:800;color:#fff;background:var(--ink);border-radius:6px;padding:3px 8px;font-size:14.5px;margin-bottom:4px}\n.box{margin-top:10px;border-radius:10px;background:#fff;border:1px solid var(--line);padding:8px 10px;font-size:15.5px}\n.box h3{margin:0 0 4px;font-size:12.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--c)}\n.ans{display:grid;gap:5px}.ans div{display:flex;flex-wrap:wrap;gap:0 8px}.ans .e{font-weight:700}\n.mis{border-color:#F1B0B0;background:#FFF1F1}.mis h3{color:#B02525}\n.fd{display:inline-flex;align-items:center;min-height:40px;padding:0 12px;font:700 14.5px/1 var(--body);color:var(--c);\n border:1.5px solid var(--c);border-radius:999px;text-decoration:none;background:#fff;white-space:nowrap}\n.sh{align-items:center}\n.fd:focus-visible{outline:3px solid var(--navy);outline-offset:2px}\n.board{border:2px solid var(--navy);border-radius:12px;padding:8px 10px 10px}\n.board h3{margin:0 0 6px;font-size:12.5px;letter-spacing:.06em;color:var(--navy)}\n.faces{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;text-align:center;font-size:13.5px}\n.faces div{border:1.5px solid var(--line);border-radius:9px;padding:4px 2px}.faces .e{display:block;font-size:26px}\n.foot{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:6px;border-top:1px solid var(--line);padding-top:10px;font-size:14px;color:var(--mut)}\n.foot a{font-weight:800;color:var(--navy);min-height:44px;display:inline-flex;align-items:center}\n@page{size:520px 2000px;margin:0}\n@media print{html,body{background:#fff}body{font-size:14.5px;line-height:1.35}.page{max-width:none;width:520px;gap:7px;padding:10px 14px}.fd{min-height:28px;font-size:12.5px}.mv{margin-top:5px}.sec{padding:7px 11px 9px}.box{margin-top:6px;padding:5px 9px;font-size:14px}.hd h1{font-size:20px}}\n.steps{margin:0;padding-inline-start:22px;font-weight:700;display:grid;gap:4px}\n.svg svg{display:block;max-width:100%;height:auto;margin:0 auto}\n.pl{font-size:15px;margin-top:6px;text-align:center}\n\n</style></head>\n<body><div class=\"page\">\n\n<div class=\"hd\">\n <div class=\"k\"><span><b>GRADE 1 · MATHS</b> · Ch.10 Shape Safari</span><span>Day 1 · 40 min</span></div>\n <h1>2D Shapes: rectangle, square, circle, triangle (sides &amp; corners)</h1>\n <div class=\"goal\">Children <b>name</b> a shape by counting its sides and corners.</div>\n</div>\n\n<div class=\"info\">\n <b>Bring</b><span>textbook pp.243-245 · chalk · books, pencils</span>\n <b>Words</b><span>rectangle · square · circle · triangle · side · vertices</span>\n <b>Video</b><span>📺 <a href=\"https://pub-0edccec5d5bd419782ba389c59faecac.r2.dev/videos/Grade01MathsCircleCircleUnicef.mp4\">Circle Unicef</a></span>\n</div>\n\n<div class=\"time\" aria-label=\"Time: 5 open, 8 explain, 12 we do, 12 you do, 3 check\">\n <div class=\"pr\"><span style=\"flex:13\"></span><span style=\"flex:24\">PRACTICE · 24 of 40 min</span><span style=\"flex:3\"></span></div>\n <div class=\"bar\">\n  <span data-sec=\"open\" style=\"flex:5;background:var(--open)\">5′</span>\n  <span data-sec=\"explain\" style=\"flex:8;background:var(--explain)\">8′</span>\n  <span data-sec=\"we\" style=\"flex:12;background:var(--we)\">12′</span>\n  <span data-sec=\"you\" style=\"flex:12;background:var(--you)\">12′</span>\n  <span data-sec=\"check\" style=\"flex:3;background:var(--check)\">3′</span>\n </div>\n <div class=\"lab\"><span style=\"flex:5\">Open</span><span style=\"flex:8\">Explain</span><span style=\"flex:12\">We Do</span><span style=\"flex:12\">You Do</span><span style=\"flex:3\">✓</span></div>\n</div>\n\n<!-- Coaching slot: filled per teacher from their last report once recordings start. Hidden in the base corpus. -->\n<div class=\"star\" hidden data-slot=\"star\"><span class=\"l\">★ Your one thing today</span> · in move <b data-slot=\"star-move\"></b><br><span data-slot=\"star-text\"></span></div>\n\n<section class=\"sec\" style=\"--c:var(--open)\" data-sec=\"open\">\n <div class=\"sh\"><h2>Opening</h2><span class=\"t\">0–5′</span><a class=\"fd\" href=\"g1_ch10_Maths_seg1.v9.html#v9-open\">Full details ›</a></div>\n <div class=\"mv\" data-covers=\"m1\"><span class=\"n\">1</span><p><span class=\"chip\">NUMBER SENSE</span><br><span class=\"ex\"><b>Yesterday:</b> Last chapter we put days in order. Which day comes after Monday? (Tuesday)</span><span class=\"do\">Show fingers: 3 is 2 and ___; 4 is 2 and ___; class answers.</span> بچے جوڑیاں بنائیں۔ حروف جوڑیں۔\n  <span class=\"say\">“Three is two and … one! Four is two and … two!”</span></p></div>\n</section>\n\n<section class=\"sec\" style=\"--c:var(--explain)\" data-sec=\"explain\">\n <div class=\"sh\"><h2>Explanation · I Do</h2><span class=\"t\">5–13′</span><a class=\"fd\" href=\"g1_ch10_Maths_seg1.v9.html#v9-explain\">Full details ›</a></div>\n <div class=\"mv\" data-covers=\"m2\"><span class=\"n\">2</span><p><span class=\"do\">Trace each p.245 shape; count sides, touch corners.</span> Billboard 4; STOP board 4; clock 0; sign 3.\n  <span class=\"say\">“Trace, count sides, touch corners, name.”</span><span class=\"ex\"><b>Think aloud:</b> “I trace the billboard: 1, 2, 3, 4 sides, 4 corners. Opposite sides equal, so a rectangle. I check: no curves.”</span></p></div>\n</section>\n\n<section class=\"sec\" style=\"--c:var(--we)\" data-sec=\"we\">\n <div class=\"sh\"><h2>We Do</h2><span class=\"t\">13–25′</span><a class=\"fd\" href=\"g1_ch10_Maths_seg1.v9.html#v9-we\">Full details ›</a></div>\n <div class=\"mv\" data-covers=\"m3\"><span class=\"n\">3</span><p><span class=\"chip\">I START, YOU FINISH</span><br><span class=\"do\">Trace a p.244 roof; class counts sides and names it.</span> Then the clock: 0 sides, 0 corners.\n  <span class=\"say\">“I trace the roof: 1, 2, 3 sides. It is a …” → “triangle!”</span></p></div>\n <div class=\"mv\" data-covers=\"m3 m4\"><span class=\"n\">4</span><p><span class=\"chip\">ONE NEIGHBOUR TURN</span><br><span class=\"do\">Trace one picture object; your neighbour names its shape.</span> Frame: “It has ___ sides and ___ corners.” Ayesha and Bilal show it first.\n  <span class=\"say\">“Count first, then name.”</span><span class=\"ex\"><b>Window side first:</b> “I traced it: 3 sides, 3 corners. What shape?” → <b>Reply:</b> “A triangle, because it has 3 sides and 3 corners.” · <b>Stop:</b> one clap, eyes on me</span></p></div>\n <div class=\"mv\" data-covers=\"m3\"><span class=\"n\">5</span><p><span class=\"do\">Draw a rectangle, square, circle, triangle in your book.</span> Write sides and corners beside each; check 5 books.</p></div>\n</section>\n\n<section class=\"sec\" style=\"--c:var(--you)\" data-sec=\"you\">\n <div class=\"sh\"><h2>You Do · in the book</h2><span class=\"t\">25–37′</span><a class=\"fd\" href=\"g1_ch10_Maths_seg1.v9.html#v9-you\">Full details ›</a></div>\n <div class=\"mv\" data-covers=\"m4\"><span class=\"n\">6</span><p><span class=\"clock\">⏱ 25′ stop explaining</span><br><span class=\"do\">Alone: 1. How many shapes on p.243? 2. Name them. 3. Sides?</span> Done? 4. Ask: “Where at home is a rectangle?”\n  <span class=\"say\">“It is a ___ because it has ___ sides.”</span><span class=\"ex\"><b>If stuck:</b> Trace–Touch–Tell: trace one edge, touch each corner, say the frame.</span></p></div>\n <div class=\"box\"><h3>Check 5 books · answers</h3>\n  <div class=\"ans\">\n   <div><span>1.</span><span class=\"e\">4 kinds of shape</span></div>\n   <div><span>2.</span><span class=\"e\">rectangle, square, circle, triangle</span></div>\n   <div><span>3.</span><span class=\"e\">4, 4 equal, 0, 3</span></div>\n   <div><span>4.</span><span class=\"e\">window, clock, roof</span></div>\n  </div></div>\n <div class=\"box mis\"><h3>Likely mistake</h3>Counts a circle's curve as a side, or calls every 4-sided shape a square. <b>Ask:</b> “Is the edge straight? All sides equal?”</div>\n</section>\n\n<div class=\"board\" data-pic=\"dg1\"><h3>THE BOARD BY THE END · 4 shapes, sides, corners</h3><div class=\"svg\"><svg viewBox=\"0 0 320 100\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"sans-serif\" text-anchor=\"middle\"><rect x=\"12\" y=\"8\" width=\"56\" height=\"30\" fill=\"#fff7e0\" stroke=\"#0B2545\" stroke-width=\"2\"/><circle cx=\"12\" cy=\"8\" r=\"3.5\" fill=\"#c0392b\"/><circle cx=\"68\" cy=\"8\" r=\"3.5\" fill=\"#c0392b\"/><circle cx=\"12\" cy=\"38\" r=\"3.5\" fill=\"#c0392b\"/><circle cx=\"68\" cy=\"38\" r=\"3.5\" fill=\"#c0392b\"/><rect x=\"94\" y=\"6\" width=\"36\" height=\"36\" fill=\"#fff7e0\" stroke=\"#0B2545\" stroke-width=\"2\"/><circle cx=\"94\" cy=\"6\" r=\"3.5\" fill=\"#c0392b\"/><circle cx=\"130\" cy=\"6\" r=\"3.5\" fill=\"#c0392b\"/><circle cx=\"94\" cy=\"42\" r=\"3.5\" fill=\"#c0392b\"/><circle cx=\"130\" cy=\"42\" r=\"3.5\" fill=\"#c0392b\"/><circle cx=\"200\" cy=\"24\" r=\"19\" fill=\"#fff7e0\" stroke=\"#0B2545\" stroke-width=\"2\"/><polygon points=\"280,5 304,43 256,43\" fill=\"#fff7e0\" stroke=\"#0B2545\" stroke-width=\"2\"/><circle cx=\"280\" cy=\"5\" r=\"3.5\" fill=\"#c0392b\"/><circle cx=\"304\" cy=\"43\" r=\"3.5\" fill=\"#c0392b\"/><circle cx=\"256\" cy=\"43\" r=\"3.5\" fill=\"#c0392b\"/><text x=\"40\" y=\"60\" font-size=\"14\">rectangle</text><text x=\"120\" y=\"60\" font-size=\"14\">square</text><text x=\"200\" y=\"60\" font-size=\"14\">circle</text><text x=\"280\" y=\"60\" font-size=\"14\">triangle</text><text x=\"40\" y=\"77\" font-size=\"14\">4 sides</text><text x=\"120\" y=\"77\" font-size=\"14\">4 equal</text><text x=\"200\" y=\"77\" font-size=\"14\">0 sides</text><text x=\"280\" y=\"77\" font-size=\"14\">3 sides</text><text x=\"40\" y=\"94\" font-size=\"14\">4 corners</text><text x=\"120\" y=\"94\" font-size=\"14\">4 corners</text><text x=\"200\" y=\"94\" font-size=\"14\">0 corners</text><text x=\"280\" y=\"94\" font-size=\"14\">3 corners</text></svg></div></div>\n\n<section class=\"sec\" style=\"--c:var(--check)\" data-sec=\"check\">\n <div class=\"sh\"><h2>Check · exit ticket</h2><span class=\"t\">37–40′</span><a class=\"fd\" href=\"g1_ch10_Maths_seg1.v9.html#v9-check\">Full details ›</a></div>\n <div class=\"mv\" data-covers=\"m5\"><span class=\"n\">7</span><p><span class=\"do\">Roti and samosa: five children say shape, sides, corners.</span> Think alone; five answer aloud.<span class=\"ex\"><b>Ask:</b> “How did you know the samosa is a triangle?” → <b>Listen for:</b> It has 3 straight sides and 3 corners. Any words that say this.</span><span class=\"ex\"><b>Success:</b> “I can name a shape by its sides and corners.” 👍 or ✊ first</span><span class=\"ex\"><b>Correct:</b> Says roti: circle, 0, 0; samosa: triangle, 3, 3.</span></p></div>\n</section>\n\n<section class=\"sec\" style=\"--c:var(--hw)\" data-sec=\"hw\">\n <div class=\"sh\"><h2>Homework</h2><span class=\"t\">at home</span><a class=\"fd\" href=\"g1_ch10_Maths_seg1.v9.html#v9-hw\">Full details ›</a></div>\n <div class=\"mv\" data-covers=\"m6\"><span class=\"n\">8</span><p><span class=\"do\">Find one of each shape on p.243 or p.244 with an adult.</span> Say each one's sides and corners.</p></div>\n</section>\n\n<div class=\"foot\"><a href=\"g1_ch10_Maths_seg1.v9.html\">Full lesson plan ›</a></div>\n</div></body></html>\n",
