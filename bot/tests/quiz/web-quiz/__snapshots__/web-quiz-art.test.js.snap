"<!DOCTYPE html><html lang="en" dir="ltr"><head><meta charset="utf-8"><style>
*{margin:0;padding:0;box-sizing:border-box}
html,body{background:#333748}
body{width:1200px;height:630px;overflow:hidden;font-family:'Lexend','NastaliqUrdu',sans-serif;color:#fff}
.art{position:relative;width:1200px;height:630px;overflow:hidden;display:flex;flex-direction:row;
