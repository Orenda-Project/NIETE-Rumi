.top,.main,.side,.cta{position:relative}
.top{display:flex;align-items:center;gap:14px;flex:0 0 auto;position:absolute;top:44px;inset-inline-start:64px;}
.mark{width:56px;height:56px;border-radius:14px;display:flex;align-items:center;justify-content:center;
  background:#333748;box-shadow:0 0 0 2px rgba(255,255,255,.25);--mk1:#47BA7D;--mk2:#FFFFFF}
.mark svg{width:70%;height:auto}
.brand{font:800 26px/1 'Lexend',sans-serif;letter-spacing:.04em}
.main{flex:1;display:flex;flex-direction:column;justify-content:safe center;gap:14px;min-width:0;min-height:0;padding-top:60px;}
.kick{font-size:26px;line-height:1.25;color:#47BA7D;font-weight:800;letter-spacing:.02em;}
.name{font-size:68px;line-height:1.05;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
.head{font-size:58px;line-height:1.12;font-weight:800}
.big{font-size:104px;line-height:1;font-weight:800}
.sub{font-size:32px;line-height:1.3;opacity:.92;max-width:100%}
.num{font-family:'Lexend',sans-serif;unicode-bidi:isolate;direction:ltr;font-weight:800}
bdi[dir="ltr"]{font-family:'Lexend','NastaliqUrdu',sans-serif}
bdi[dir="rtl"]{font-family:'NastaliqUrdu','Lexend',sans-serif}
.stars{display:flex;gap:8px;flex-wrap:wrap;direction:ltr}
.star{width:44px;height:44px;fill:none;stroke:rgba(255,255,255,.55);stroke-width:1.6;stroke-linejoin:round}
.star.on{fill:#F5B841;stroke:#F5B841}
.side{flex:0 0 330px;display:flex;align-items:center;justify-content:center}
.jug{width:280px;height:280px;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.22) 0%,rgba(255,255,255,0) 68%);object-fit:contain;padding:24px}
.tiles{display:flex;gap:18px;flex-wrap:wrap;}
.tile{background:rgba(255,255,255,.12);border-radius:20px;padding:16px 24px;display:flex;flex-direction:column;gap:4px;font-size:48px;line-height:1.2}
.tile small{font-size:22px;opacity:.85;line-height:1.3}
.cta{flex:0 0 auto;align-self:flex-start;margin-top:8px;display:inline-block;background:#47BA7D;color:#333748;
  font-size:26px;line-height:1.2;font-weight:800;padding:14px 28px;border-radius:999px}
.board{list-style:none;display:flex;flex-direction:column;gap:6px;width:100%;text-align:start}
.row{display:flex;align-items:center;gap:18px;background:rgba(255,255,255,.08);border-radius:16px;padding:4px 18px;font-size:25px;line-height:1.2}
.row.you{background:#47BA7D;color:#333748;box-shadow:0 0 0 3px #fff}
.rk{flex:0 0 56px;font-size:1.15em}
.sn{flex:1;min-width:0;display:flex;flex-direction:column;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sn small,.pt small{font-size:.62em;opacity:.8}
.pt{display:flex;flex-direction:column;align-items:flex-end;text-align:end}
.mv{flex:0 0 18px;width:0;height:0;border-inline:9px solid transparent}
.mv.up{border-bottom:14px solid #7BE0A6}
.mv.down{border-top:14px solid #FF8C7A}
/* A line never gives up its height to the box (a clipped name shrank to nothing). */
.main>*{flex-shrink:0}


.ani{width:1em;height:1em;display:inline-block;vertical-align:-.12em;margin-inline-end:.25em;object-fit:contain}
.pts{display:inline-block;align-self:flex-start;background:rgba(255,255,255,.14);border-radius:999px;padding:8px 22px;font-size:24px;line-height:1.3;font-weight:700}
.crow{list-style:none;display:flex;flex-direction:column;gap:6px;width:100%;text-align:start}
.crow li{display:flex;align-items:center;gap:14px;background:rgba(255,255,255,.08);border-radius:12px;padding:4px 16px;font-size:26px;line-height:1.25}
.crow li.me{background:#47BA7D;color:#333748}
.crow .rk{flex:0 0 40px}.crow .who{flex:1;min-width:0;white-space:nowrap;overflow:hidden}.crow .ani{margin:0}
