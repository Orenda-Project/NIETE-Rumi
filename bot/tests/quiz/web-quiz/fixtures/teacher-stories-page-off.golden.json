%;color:inherit;resize:none}\n.msg:lang(en){font-family:system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;font-size:15px;line-height:1.45}\n:lang(ur) .btn{font-weight:400}\n.btn{display:block;width:100%;min-height:56px;margin:14px 0 0;padding:15px;border:0;border-radius:14px;font:inherit;font-size:18px;font-weight:600;text-align:center;text-decoration:none}\n.go{background:var(--go);color:#fff}.soft{background:#fff;color:var(--ink);border:1.5px solid var(--line)}\n.note{color:var(--soft);font-size:15px;margin:12px 0 0}.hear{display:flex;align-items:center;gap:8px;margin:6px 0 0}.hear audio{flex:1;min-width:0;height:40px}.oops{background:#fff1f0;border-radius:12px;padding:12px}</style>\n</head>\n<body>\n<main data-screen=\"teacher-stories\">\n<a class=\"back\" data-home=\"1\" href=\"/quiz/teacher/eyJrIjoidGgiLCJ1aWQiOiIxMTExMTExMS0xMTExLTQxMTEtODExMS0xMTExMTExMTExMTEiLCJsYW5nIjoiZW4iLCJ2aWEiOiJnbyIsImV4cCI6NDEwMjQ0NDgwMH0.HG_VJfEffzVjUshMgCMv23\">‹ Home</a>\n<h1>Stories for your class</h1>\n<nav class=\"chips\" aria-label=\"grade\"><a class=\"chip\" data-tap=\"grade\" href=\"/quiz/teacher/eyJrIjoidGgiLCJ1aWQiOiIxMTExMTExMS0xMTExLTQxMTEtODExMS0xMTExMTExMTExMTEiLCJsYW5nIjoiZW4iLCJ2aWEiOiJnbyIsImV4cCI6NDEwMjQ0NDgwMH0.HG_VJfEffzVjUshMgCMv23/stories?grade=1&amp;lang=en\">Grade 1</a><a class=\"chip on\" data-tap=\"grade\" href=\"/quiz/teacher/eyJrIjoidGgiLCJ1aWQiOiIxMTExMTExMS0xMTExLTQxMTEtODExMS0xMTExMTExMTExMTEiLCJsYW5nIjoiZW4iLCJ2aWEiOiJnbyIsImV4cCI6NDEwMjQ0NDgwMH0.HG_VJfEffzVjUshMgCMv23/stories?grade=2&amp;lang=en\" aria-current=\"true\">Grade 2</a><a class=\"chip\" data-tap=\"grade\" href=\"/quiz/teacher/eyJrIjoidGgiLCJ1aWQiOiIxMTExMTExMS0xMTExLTQxMTEtODExMS0xMTExMTExMTExMTEiLCJsYW5nIjoiZW4iLCJ2aWEiOiJnbyIsImV4cCI6NDEwMjQ0NDgwMH0.HG_VJfEffzVjUshMgCMv23/stories?grade=3&amp;lang=en\">Grade 3</a><a class=\"chip\" data-tap=\"grade\" href=\"/quiz/teacher/eyJrIjoidGgiLCJ1aWQiOiIxMTExMTExMS0xMTExLTQxMTEtODExMS0xMTExMTExMTExMTEiLCJsYW5nIjoiZW4iLCJ2aWEiOiJnbyIsImV4cCI6NDEwMjQ0NDgwMH0.HG_VJfEffzVjUshMgCMv23/stories?grade=4&amp;lang=en\">Grade 4</a><a class=\"chip\" data-tap=\"grade\" href=\"/quiz/teacher/eyJrIjoidGgiLCJ1aWQiOiIxMTExMTExMS0xMTExLTQxMTEtODExMS0xMTExMTExMTExMTEiLCJsYW5nIjoiZW4iLCJ2aWEiOiJnbyIsImV4cCI6NDEwMjQ0NDgwMH0.HG_VJfEffzVjUshMgCMv23/stories?grade=5&amp;lang=en\">Grade 5</a></nav>\n<nav class=\"chips\" aria-label=\"language\"><a class=\"chip\" data-tap=\"lang\" lang=\"ur\" dir=\"rtl\" href=\"/quiz/teacher/eyJrIjoidGgiLCJ1aWQiOiIxMTExMTExMS0xMTExLTQxMTEtODExMS0xMTExMTExMTExMTEiLCJsYW5nIjoiZW4iLCJ2aWEiOiJnbyIsImV4cCI6NDEwMjQ0NDgwMH0.HG_VJfEffzVjUshMgCMv23/stories?grade=2&amp;lang=ur\">اردو</a><a class=\"chip on\" data-tap=\"lang\" lang=\"en\" dir=\"ltr\" href=\"/quiz/teacher/eyJrIjoidGgiLCJ1aWQiOiIxMTExMTExMS0xMTExLTQxMTEtODExMS0xMTExMTExMTExMTEiLCJsYW5nIjoiZW4iLCJ2aWEiOiJnbyIsImV4cCI6NDEwMjQ0NDgwMH0.HG_VJfEffzVjUshMgCMv23/stories?grade=2&amp;lang=en\" aria-current=\"true\">English</a></nav>\n<div class=\"grid\"><div class=\"tile\" lang=\"en\" dir=\"ltr\"><img class=\"cover\" src=\"/s/bbbbbbb2-bbbb-4bbb-8bbb-bbbbbbbbbbbb/cover-00000002.webp\" alt=\"\" width=\"160\" height=\"240\" loading=\"eager\"><span class=\"t\">Book 2 Testwala</span><span class=\"m\" lang=\"en\" dir=\"ltr\"><b class=\"pick\">Picked for you</b> about 3 min</span></div><div class=\"tile\" lang=\"en\" dir=\"ltr\"><img class=\"cover\" src=\"/s/bbbbbbb3-bbbb-4bbb-8bbb-bbbbbbbbbbbb/cover-00000003.webp\" alt=\"\" width=\"160\" height=\"240\" loading=\"eager\"><span class=\"t\">Book 3 Testwala</span><span class=\"m\" lang=\"en\" dir=\"ltr\">about 3 min</span></div><div class=\"tile\" lang=\"en\" dir=\"ltr\"><img class=\"cover\" src=\"/s/bbbbbbb1-bbbb-4bbb-8bbb-bbbbbbbbbbbb/cover-00000001.webp\" alt=\"\" width=\"160\" height=\"240\" loading=\"eager\"><span class=\"t\">Book 1 Testwala</span><span class=\"m\" lang=\"en\" dir=\"ltr\">about 3 min</span></div></div>\n<p class=\"note\" data-note=\"send-closed\">Sending stories to your class is not open for your school yet.</p>\n</main>\n<script>(function(){var m=location.hash.match(/^#book\\/([0-9a-f-]{36})$/i);if(m&&!/[?&]book=/.test(location.search)){location.replace(location.pathname+(location.search?location.search+'&':'?')+'book='+m[1]);return;}\nvar b=document.getElementById('copy'),t=document.getElementById('msg'),f=document.querySelector('form[action=\"/api/teacher/story/send\"]');if(!b||!t||!f||typeof fetch!=='function')return;b.hidden=false;\nfunction ok(){b.textContent=b.getAttribute('data-done');}function no(){b.textContent=b.getAttribute('data-long');}\nfunction cp(v){if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(v).then(ok,fb);}else fb();\nfunction fb(){try{t.removeAttribute('readonly');t.select();var r=document.execCommand('copy');t.setAttribute('readonly','');r?ok():no();}catch(e){no();}}}\nb.addEventListener('click',function(){if(b.disabled)return;b.disabled=true;var e=f.elements;\nfetch('/api/teacher/story/share',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({th:e.th.value,story_id:e.story_id.value})})\n.then(function(r){if(!r.ok)throw r;return r.json();}).then(function(o){b.disabled=false;cp(o&&typeof o.class_message==='string'&&o.class_message?o.class_message:t.value);},function(){b.disabled=false;b.textContent=b.getAttribute('data-fail');});});})();</script>\n</body>\n</html>"
 }
