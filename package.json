{
  "name": "rumi-platform",
  "version": "1.1.0",
  "description": "Rumi - AI Teaching Assistant for WhatsApp. Open-source platform for deploying AI-powered educational chatbots.",
  "private": true,
  "scripts": {
    "build:portal": "npm ci --prefix portal && npm run build --prefix portal && rm -rf dashboard/portal-frontend/dist && cp -r portal/dist dashboard/portal-frontend/dist && npm install --prefix dashboard",
    "prepare": "bash scripts/qa/install-hooks.sh --quiet || true",
    "qa:hooks": "bash scripts/qa/install-hooks.sh",
    "qa:impact": "python3 scripts/qa/impact.py --repo . --format text --base origin/develop --head HEAD",
    "qa:test": "python3 .claude/qa/shared/test_select_e2e.py && python3 .claude/qa/shared/test_spec_sync.py && python3 .claude/qa/shared/test_validate_specs.py && python3 .claude/qa/shared/test_yaml_lite.py && python3 scripts/qa/test_impact.py && bash .claude/hooks/lib/git-push-match.test.sh && bash .githooks/githooks.test.sh && bash .claude/hooks/e2e-autorun-gitmarker.test.sh && bash .claude/hooks/e2e-autorun.test.sh && bash .claude/hooks/spec-sync-pipeline.test.sh",
    "test": "node tests/baseline-gate.js",
    "test:raw": "node tests/run.js",
    "test:baseline": "node tests/baseline-gate.js",
    "test:baseline:update": "node tests/baseline-gate.js --update",
    "test:baseline:growth": "node tests/baseline-growth-check.js",
    "test:security": "node tests/run.js --testPathPattern=sprint-0",
    "test:sprint1": "node tests/run.js --testPathPattern=sprint-1",
    "test:schema": "node tests/run.js --testPathPattern=sprint-2",
    "test:setup": "node tests/run.js --testPathPattern=sprint-3",
    "test:docs": "node tests/run.js --testPathPattern=sprint-4",
    "test:e2e": "node tests/run.js --testPathPattern=integration",
    "validate:env": "node bot/scripts/validate-env.js",
    "validate:connections": "node infrastructure/scripts/test-connections.js",
    "bootstrap:db": "node infrastructure/scripts/bootstrap-db.js",
    "doctor": "node bot/scripts/setup/doctor.js",
    "setup:flows": "node bot/scripts/setup/run-full-setup.js",
    "simulate": "node bot/scripts/simulate.js",
    "setup": "node bot/scripts/setup/doctor.js"
  },
  "keywords": [
    "whatsapp",
    "chatbot",
    "education",
    "ai",
    "teaching-assistant",
    "edtech",
    "openrouter"
  ],
  "author": "Orenda Project",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Orenda-Project/rumi-platform.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jsonrepair": "^3.13.1",
    "jszip": "^3.10.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "express": "^5.2.1",
    "ioredis": "^5.9.2",
    "openai": "^6.16.0"
  }
}
